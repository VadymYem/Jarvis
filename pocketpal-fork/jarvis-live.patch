diff --git a/src/voice/LiveVoicePanel.tsx b/src/voice/LiveVoicePanel.tsx
new file mode 100644
index 0000000..b884bc1
--- /dev/null
+++ b/src/voice/LiveVoicePanel.tsx
@@ -0,0 +1,204 @@
+import React from 'react';
+import {
+  Alert,
+  PermissionsAndroid,
+  Platform,
+  StyleSheet,
+  View,
+} from 'react-native';
+import {observer} from 'mobx-react';
+import {Button, Text} from 'react-native-paper';
+import {chatSessionStore, modelStore, palStore} from '../store';
+import {MessageType} from '../utils/types';
+import {liveVoice} from './liveVoice';
+
+type Phase = 'idle' | 'listening' | 'thinking' | 'speaking';
+
+const styles = StyleSheet.create({
+  panel: {paddingHorizontal: 16, paddingVertical: 6},
+  actions: {flexDirection: 'row', alignItems: 'center', gap: 8},
+});
+
+/** Explicit foreground voice session, with a separate stop/interrupt action. */
+export const LiveVoicePanel = observer(
+  ({send}: {send: (message: MessageType.PartialText) => void}) => {
+    const [phase, setPhase] = React.useState<Phase>('idle');
+    const [heard, setHeard] = React.useState('');
+    const [localOnly, setLocalOnly] = React.useState(true);
+    const session = React.useRef(0);
+    const baseline = React.useRef<string | undefined>(undefined);
+    const timeout = React.useRef<ReturnType<typeof setTimeout> | undefined>(
+      undefined,
+    );
+    const messages = chatSessionStore.currentSessionMessages;
+    const isInferencing = modelStore.inferencing;
+    const lastAnswer = [...messages]
+      .reverse()
+      .find(m => m.type === 'assistant_turn') as
+      | MessageType.AssistantTurn
+      | undefined;
+
+    const stop = React.useCallback(() => {
+      session.current += 1;
+      if (timeout.current) clearTimeout(timeout.current);
+      setPhase('idle');
+      liveVoice?.stopListening().catch(() => {});
+      liveVoice?.stopSpeaking().catch(() => {});
+    }, []);
+
+    React.useEffect(
+      () => () => {
+        session.current += 1;
+        if (timeout.current) clearTimeout(timeout.current);
+        liveVoice?.stopListening().catch(() => {});
+        liveVoice?.stopSpeaking().catch(() => {});
+      },
+      [],
+    );
+
+    const listen = React.useCallback(
+      async (id: number, offline: boolean) => {
+        if (!liveVoice || session.current !== id) return;
+        setPhase('listening');
+        try {
+          const utterance = await liveVoice.listen('uk-UA', offline);
+          if (session.current !== id) return;
+          if (!utterance?.trim()) {
+            setPhase('idle');
+            return;
+          }
+          setHeard(utterance.trim());
+          baseline.current = [...chatSessionStore.currentSessionMessages]
+            .reverse()
+            .find(m => m.type === 'assistant_turn')?.id;
+          setPhase('thinking');
+          send({type: 'text', text: utterance.trim()});
+          timeout.current = setTimeout(() => {
+            if (session.current === id) {
+              setPhase('idle');
+              Alert.alert(
+                'Jarvis Live',
+                'Відповідь не надійшла. Спробуйте ще раз.',
+              );
+            }
+          }, 120000);
+        } catch (error) {
+          if (session.current !== id) return;
+          setPhase('idle');
+          Alert.alert(
+            'Jarvis Live',
+            error instanceof Error ? error.message : String(error),
+          );
+        }
+      },
+      [send],
+    );
+
+    React.useEffect(() => {
+      if (
+        phase !== 'thinking' ||
+        isInferencing ||
+        !lastAnswer ||
+        lastAnswer.id === baseline.current
+      )
+        return;
+      const text = [...lastAnswer.steps]
+        .reverse()
+        .find(s => s.content?.trim())
+        ?.content?.trim();
+      if (!text || !liveVoice) return;
+      if (timeout.current) clearTimeout(timeout.current);
+      const id = session.current;
+      setPhase('speaking');
+      liveVoice
+        .speak(text, 'uk-UA')
+        .then(() => {
+          if (session.current === id) listen(id, localOnly);
+        })
+        .catch(error => {
+          if (session.current === id) {
+            setPhase('idle');
+            Alert.alert(
+              'Jarvis Live',
+              error instanceof Error ? error.message : String(error),
+            );
+          }
+        });
+    }, [phase, isInferencing, lastAnswer, listen, localOnly]);
+
+    const activateJarvis = async () => {
+      const jarvis = palStore.pals.find(
+        p => p.name === 'Jarvis' && p.source === 'local',
+      );
+      if (jarvis) await chatSessionStore.setActivePal(jarvis.id);
+      else Alert.alert('Jarvis', 'Агент ще ініціалізується. Спробуйте знову.');
+    };
+
+    const start = async () => {
+      if (!liveVoice || !modelStore.activeModelId) {
+        Alert.alert(
+          'Jarvis Live',
+          'Спочатку завантажте або підключіть модель.',
+        );
+        return;
+      }
+      const granted =
+        Platform.OS === 'android' &&
+        (await PermissionsAndroid.request(
+          PermissionsAndroid.PERMISSIONS.RECORD_AUDIO,
+        ));
+      if (granted !== PermissionsAndroid.RESULTS.GRANTED) return;
+      await activateJarvis();
+      const id = ++session.current;
+      const offline = await liveVoice.isOnDeviceAvailable();
+      if (session.current !== id) return;
+      setLocalOnly(offline);
+      listen(id, offline);
+    };
+
+    if (Platform.OS !== 'android') return null;
+    return (
+      <View style={styles.panel}>
+        <View style={styles.actions}>
+          <Button
+            mode="text"
+            testID="jarvis-agent-button"
+            onPress={activateJarvis}>
+            Агент Jarvis · 7 інструментів
+          </Button>
+          <Button
+            mode={phase === 'idle' ? 'contained' : 'outlined'}
+            testID="jarvis-live-button"
+            onPress={phase === 'idle' ? start : stop}>
+            {phase === 'idle' ? '🎙 Jarvis Live' : 'Зупинити Live'}
+          </Button>
+          {phase === 'speaking' && (
+            <Button
+              onPress={() => {
+                liveVoice?.stopSpeaking().catch(() => {});
+              }}>
+              Перервати
+            </Button>
+          )}
+        </View>
+        {phase !== 'idle' && (
+          <Text variant="bodySmall">
+            {phase === 'listening'
+              ? 'Слухаю…'
+              : phase === 'thinking'
+                ? `Обробляю: ${heard}`
+                : 'Відповідаю голосом…'}
+            {' · '}
+            {localOnly ? 'локальне розпізнавання' : 'системний голосовий рушій'}
+          </Text>
+        )}
+        {phase === 'idle' && (
+          <Text variant="bodySmall">
+            Агент: пошук, читання сторінок, стан телефону, застосунки, ліхтарик,
+            гучність, будильник і таймер.
+          </Text>
+        )}
+      </View>
+    );
+  },
+);
diff --git a/src/voice/liveVoice.ts b/src/voice/liveVoice.ts
new file mode 100644
index 0000000..af8f3b6
--- /dev/null
+++ b/src/voice/liveVoice.ts
@@ -0,0 +1,14 @@
+import {NativeModules, Platform} from 'react-native';
+
+interface LiveVoiceNative {
+  isOnDeviceAvailable(): Promise<boolean>;
+  listen(languageTag: string, onDeviceOnly: boolean): Promise<string | null>;
+  stopListening(): Promise<void>;
+  speak(text: string, languageTag: string): Promise<void>;
+  stopSpeaking(): Promise<void>;
+}
+
+const module = NativeModules.LiveVoiceModule as LiveVoiceNative | undefined;
+
+export const liveVoice: LiveVoiceNative | undefined =
+  Platform.OS === 'android' ? module : undefined;
