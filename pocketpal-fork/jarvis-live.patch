diff --git a/android/app/src/main/java/top/authorche/agent/LiveVoiceModule.kt b/android/app/src/main/java/top/authorche/agent/LiveVoiceModule.kt
new file mode 100644
index 0000000..c6d7e81
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/LiveVoiceModule.kt
@@ -0,0 +1,179 @@
+package top.authorche.agent
+
+import android.Manifest
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Bundle
+import android.speech.RecognitionListener
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import android.speech.tts.TextToSpeech
+import android.speech.tts.UtteranceProgressListener
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import java.util.Locale
+
+/** Foreground, turn-based voice conversation. No background microphone service. */
+class LiveVoiceModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private var recognizer: SpeechRecognizer? = null
+  private var recognitionPromise: Promise? = null
+  private var tts: TextToSpeech? = null
+  private var speechPromise: Promise? = null
+  private var speechReady = false
+  private var speechSequence = 0
+
+  override fun getName() = "LiveVoiceModule"
+
+  @ReactMethod fun isOnDeviceAvailable(promise: Promise) {
+    promise.resolve(Build.VERSION.SDK_INT >= 31 && SpeechRecognizer.isOnDeviceRecognitionAvailable(context))
+  }
+
+  @ReactMethod fun listen(languageTag: String, onDeviceOnly: Boolean, promise: Promise) {
+    context.runOnUiQueueThread {
+      if (recognitionPromise != null) {
+        promise.reject("VOICE_BUSY", "Already listening")
+        return@runOnUiQueueThread
+      }
+      if (context.checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+        promise.reject("MIC_PERMISSION", "Microphone permission required")
+        return@runOnUiQueueThread
+      }
+      if (onDeviceOnly && (Build.VERSION.SDK_INT < 31 || !SpeechRecognizer.isOnDeviceRecognitionAvailable(context))) {
+        promise.reject("NO_LOCAL_RECOGNIZER", "No on-device recognition service is installed")
+        return@runOnUiQueueThread
+      }
+      if (!onDeviceOnly && !SpeechRecognizer.isRecognitionAvailable(context)) {
+        promise.reject("NO_RECOGNIZER", "No speech recognition service is installed")
+        return@runOnUiQueueThread
+      }
+      try {
+        recognizer = if (onDeviceOnly) SpeechRecognizer.createOnDeviceSpeechRecognizer(context)
+                     else SpeechRecognizer.createSpeechRecognizer(context)
+        recognitionPromise = promise
+        recognizer?.setRecognitionListener(object : RecognitionListener {
+          override fun onReadyForSpeech(params: Bundle?) = Unit
+          override fun onBeginningOfSpeech() = Unit
+          override fun onRmsChanged(rmsdB: Float) = Unit
+          override fun onBufferReceived(buffer: ByteArray?) = Unit
+          override fun onEndOfSpeech() = Unit
+          override fun onPartialResults(partialResults: Bundle?) = Unit
+          override fun onEvent(eventType: Int, params: Bundle?) = Unit
+          override fun onError(error: Int) {
+            val pending = recognitionPromise
+            recognitionPromise = null
+            recognizer?.destroy()
+            recognizer = null
+            if (error == SpeechRecognizer.ERROR_NO_MATCH || error == SpeechRecognizer.ERROR_SPEECH_TIMEOUT) pending?.resolve(null)
+            else pending?.reject("RECOGNITION_$error", "Speech recognition error $error")
+          }
+          override fun onResults(results: Bundle?) {
+            val pending = recognitionPromise
+            recognitionPromise = null
+            recognizer?.destroy()
+            recognizer = null
+            pending?.resolve(results?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)?.firstOrNull())
+          }
+        })
+        recognizer?.startListening(Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
+          putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
+          putExtra(RecognizerIntent.EXTRA_LANGUAGE, languageTag)
+          putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, onDeviceOnly)
+        })
+      } catch (error: Exception) {
+        recognitionPromise = null
+        recognizer?.destroy()
+        recognizer = null
+        promise.reject("VOICE_START", error.message, error)
+      }
+    }
+  }
+
+  @ReactMethod fun stopListening(promise: Promise) {
+    context.runOnUiQueueThread {
+      recognitionPromise?.resolve(null)
+      recognitionPromise = null
+      recognizer?.cancel()
+      recognizer?.destroy()
+      recognizer = null
+      promise.resolve(null)
+    }
+  }
+
+  @ReactMethod fun speak(text: String, languageTag: String, promise: Promise) {
+    context.runOnUiQueueThread {
+      speechSequence += 1
+      speechPromise?.resolve(null)
+      speechPromise = promise
+      tts?.stop()
+      if (tts == null) {
+        tts = TextToSpeech(context) { status ->
+          context.runOnUiQueueThread {
+            speechReady = status == TextToSpeech.SUCCESS
+            if (speechReady && speechPromise != null) startSpeech(text, languageTag)
+            else {
+              speechPromise?.reject("TTS_UNAVAILABLE", "Text to speech engine unavailable")
+              speechPromise = null
+            }
+          }
+        }
+      } else startSpeech(text, languageTag)
+    }
+  }
+
+  private fun startSpeech(text: String, languageTag: String) {
+    if (!speechReady || speechPromise == null) return
+    val engine = tts ?: return
+    val sequence = speechSequence
+    val utteranceId = "jarvis-live-${speechSequence}"
+    if (engine.setLanguage(Locale.forLanguageTag(languageTag)) < 0) {
+      speechPromise?.reject("TTS_LANGUAGE", "No voice installed for $languageTag")
+      speechPromise = null
+      return
+    }
+    engine.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
+      override fun onStart(utteranceId: String?) = Unit
+      override fun onDone(completedId: String?) {
+        if (completedId == utteranceId) context.runOnUiQueueThread {
+          if (sequence != speechSequence) return@runOnUiQueueThread
+          speechPromise?.resolve(null)
+          speechPromise = null
+        }
+      }
+      @Deprecated("Deprecated in Android")
+      override fun onError(completedId: String?) {
+        if (completedId == utteranceId) context.runOnUiQueueThread {
+          if (sequence != speechSequence) return@runOnUiQueueThread
+          speechPromise?.reject("TTS_ERROR", "Speech playback failed")
+          speechPromise = null
+        }
+      }
+    })
+    if (engine.speak(text.take(3000), TextToSpeech.QUEUE_FLUSH, null, utteranceId) == TextToSpeech.ERROR) {
+      speechPromise?.reject("TTS_START", "Speech playback could not start")
+      speechPromise = null
+    }
+  }
+
+  @ReactMethod fun stopSpeaking(promise: Promise) {
+    speechSequence += 1
+    tts?.stop()
+    speechPromise?.resolve(null)
+    speechPromise = null
+    promise.resolve(null)
+  }
+
+  override fun invalidate() {
+    recognizer?.cancel()
+    recognizer?.destroy()
+    recognitionPromise?.resolve(null)
+    tts?.stop()
+    tts?.shutdown()
+    speechPromise?.resolve(null)
+    recognitionPromise = null
+    speechPromise = null
+    super.invalidate()
+  }
+}
