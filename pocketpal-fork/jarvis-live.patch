diff --git a/src/services/search/providers/__tests__/keyless.test.ts b/src/services/search/providers/__tests__/keyless.test.ts
new file mode 100644
index 0000000..87741e4
--- /dev/null
+++ b/src/services/search/providers/__tests__/keyless.test.ts
@@ -0,0 +1,58 @@
+import {WikipediaProvider} from '../wikipedia';
+import {SearxngProvider} from '../searxng';
+
+const json = (body: unknown) => ({
+  ok: true,
+  status: 200,
+  headers: {get: () => null},
+  text: async () => JSON.stringify(body),
+});
+
+describe('keyless search adapters', () => {
+  it('queries Wikipedia without credentials and normalizes links', async () => {
+    global.fetch = jest.fn().mockResolvedValue(
+      json({
+        query: {
+          search: [{title: 'Місяць', snippet: '<span>Супутник</span>'}],
+        },
+      }),
+    );
+    const hits = await new WikipediaProvider().search('місяць', {
+      maxResults: 3,
+    });
+    expect(hits[0]).toEqual({
+      title: 'Місяць',
+      url: 'https://uk.wikipedia.org/wiki/%D0%9C%D1%96%D1%81%D1%8F%D1%86%D1%8C',
+      snippet: 'Супутник',
+    });
+    expect((global.fetch as jest.Mock).mock.calls[0][0]).toContain(
+      'srsearch=%D0%BC',
+    );
+  });
+
+  it('requires HTTPS and a JSON-capable SearXNG instance', async () => {
+    global.fetch = jest.fn().mockResolvedValue(
+      json({
+        results: [
+          {title: 'Answer', url: 'https://example.org', content: 'Summary'},
+        ],
+      }),
+    );
+    await expect(
+      new SearxngProvider(() => 'http://example.org').search('q', {
+        maxResults: 3,
+      }),
+    ).rejects.toThrow(/HTTPS/);
+    const hits = await new SearxngProvider(
+      () => 'https://search.example.org/',
+    ).search('hello', {maxResults: 2});
+    expect(hits[0]).toEqual({
+      title: 'Answer',
+      url: 'https://example.org',
+      snippet: 'Summary',
+    });
+    expect((global.fetch as jest.Mock).mock.calls[0][0]).toBe(
+      'https://search.example.org/search?q=hello&format=json',
+    );
+  });
+});
diff --git a/src/services/search/providers/searxng.ts b/src/services/search/providers/searxng.ts
new file mode 100644
index 0000000..ec31025
--- /dev/null
+++ b/src/services/search/providers/searxng.ts
@@ -0,0 +1,46 @@
+import type {SearchProvider, SearchHit, SearchOptions} from '../types';
+import {fetchJson, requireKey} from './http';
+
+type SearxResponse = {
+  results?: {title?: string; url?: string; content?: string}[];
+};
+
+/** The configured value is an HTTPS instance URL, not an API key. */
+export class SearxngProvider implements SearchProvider {
+  readonly id = 'searxng';
+
+  constructor(private readonly getInstanceUrl: () => string) {}
+
+  async search(query: string, opts: SearchOptions): Promise<SearchHit[]> {
+    const raw = requireKey(this.getInstanceUrl(), 'SearXNG instance URL');
+    const url = new URL(raw);
+    if (
+      url.protocol !== 'https:' ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    ) {
+      throw new Error(
+        'Enter an HTTPS SearXNG base URL without credentials or query parameters.',
+      );
+    }
+    const endpoint = `${url.origin}${url.pathname.replace(/\/$/, '')}/search?q=${encodeURIComponent(query)}&format=json`;
+    const response = await fetchJson<SearxResponse>(endpoint, {method: 'GET'});
+    if (!Array.isArray(response.results)) {
+      throw new Error(
+        'This SearXNG instance does not expose JSON search. Enable JSON format or choose another instance.',
+      );
+    }
+    return response.results
+      .slice(0, Math.min(8, Math.max(1, opts.maxResults)))
+      .filter(
+        item => typeof item.url === 'string' && /^https?:\/\//.test(item.url),
+      )
+      .map(item => ({
+        title: item.title || item.url!,
+        url: item.url!,
+        snippet: item.content || '',
+      }));
+  }
+}
