+import type {SearchProvider, SearchHit, SearchOptions} from '../types';
+import {fetchJson} from './http';
+
+type WikiResponse = {
+  query?: {search?: {title: string; snippet: string}[]};
+};
+
+const stripMarkup = (html: string): string =>
+  html
+    .replace(/<[^>]*>/g, '')
+    .replace(/&quot;/g, '"')
+    .replace(/&amp;/g, '&');
+
+/** Keyless public encyclopedia search. It is not a general web index. */
+export class WikipediaProvider implements SearchProvider {
+  readonly id = 'wikipedia';
+
+  async search(query: string, opts: SearchOptions): Promise<SearchHit[]> {
+    const language = /[А-Яа-яІіЇїЄєҐґ]/.test(query) ? 'uk' : 'en';
+    const params = `action=query&list=search&format=json&utf8=1&srlimit=${Math.min(8, Math.max(1, opts.maxResults))}&srsearch=${encodeURIComponent(query)}`;
+    const response = await fetchJson<WikiResponse>(
+      `https://${language}.wikipedia.org/w/api.php?${params}`,
+      {method: 'GET'},
+    );
+    return (response.query?.search ?? []).map(item => ({
+      title: item.title,
+      url: `https://${language}.wikipedia.org/wiki/${encodeURIComponent(item.title.replace(/ /g, '_'))}`,
+      snippet: stripMarkup(item.snippet),
+    }));
+  }
+}
