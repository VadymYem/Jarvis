@@ -0,0 +1,147 @@
+import type {
+  TalentEngine,
+  TalentResult,
+  ToolDefinition,
+} from '../../services/talents/types';
+import {agentDevice, type AgentDeviceApi} from '../native/AgentDevice';
+
+type DeviceAction =
+  | 'open_app'
+  | 'open_settings'
+  | 'flashlight'
+  | 'media_volume'
+  | 'create_alarm'
+  | 'start_timer'
+  | 'find_phone';
+
+const asNumber = (value: unknown, name: string): number => {
+  if (typeof value !== 'number' || !Number.isFinite(value)) {
+    throw new Error(`${name} must be a finite number.`);
+  }
+  return value;
+};
+
+const asString = (value: unknown, name: string): string => {
+  if (typeof value !== 'string' || !value.trim()) {
+    throw new Error(`${name} must be a non-empty string.`);
+  }
+  return value.trim();
+};
+
+export class DeviceActionEngine implements TalentEngine {
+  readonly name = 'device_action';
+
+  constructor(private readonly device: AgentDeviceApi = agentDevice) {}
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    try {
+      const action = asString(args.action, 'action') as DeviceAction;
+      let summary: string;
+      switch (action) {
+        case 'open_app':
+          summary = await this.device.openApp(asString(args.target, 'target'));
+          break;
+        case 'open_settings':
+          summary = await this.device.openSystemSettings(
+            asString(args.section, 'section'),
+          );
+          break;
+        case 'flashlight':
+          if (typeof args.enabled !== 'boolean') {
+            throw new Error('enabled must be a boolean.');
+          }
+          summary = await this.device.setFlashlight(args.enabled);
+          break;
+        case 'media_volume':
+          summary = await this.device.setMediaVolume(
+            asNumber(args.percent, 'percent'),
+          );
+          break;
+        case 'create_alarm':
+          summary = await this.device.createAlarm(
+            asNumber(args.hour, 'hour'),
+            asNumber(args.minute, 'minute'),
+            typeof args.label === 'string' ? args.label : undefined,
+          );
+          break;
+        case 'start_timer':
+          summary = await this.device.startTimer(
+            asNumber(args.seconds, 'seconds'),
+            typeof args.label === 'string' ? args.label : undefined,
+          );
+          break;
+        case 'find_phone':
+          summary = await this.device.playFindPhoneSound();
+          break;
+        default:
+          throw new Error(`Unsupported device action '${action}'.`);
+      }
+      return {type: 'text', summary};
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return {
+        type: 'error',
+        summary: `device_action failed: ${message}`,
+        errorMessage: message,
+      };
+    }
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: this.name,
+        description:
+          'Perform a supported Android action. Alarm, timer, and settings actions open Android system UI for the user. Success means the native action or system flow was actually started.',
+        parameters: {
+          type: 'object',
+          additionalProperties: false,
+          required: ['action'],
+          properties: {
+            action: {
+              type: 'string',
+              enum: [
+                'open_app',
+                'open_settings',
+                'flashlight',
+                'media_volume',
+                'create_alarm',
+                'start_timer',
+                'find_phone',
+              ],
+            },
+            target: {
+              type: 'string',
+              description:
+                'App package id or exact launcher label for open_app.',
+            },
+            section: {
+              type: 'string',
+              enum: [
+                'wifi',
+                'bluetooth',
+                'accessibility',
+                'notification_listener',
+                'battery',
+                'location',
+                'dnd',
+                'app_details',
+              ],
+            },
+            enabled: {type: 'boolean'},
+            percent: {type: 'number', minimum: 0, maximum: 100},
+            hour: {type: 'integer', minimum: 0, maximum: 23},
+            minute: {type: 'integer', minimum: 0, maximum: 59},
+            seconds: {type: 'integer', minimum: 1, maximum: 86400},
+            label: {type: 'string'},
+          },
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string {
+    return 'Use device_action only for its documented actions. Report permission errors and system confirmation screens honestly; never imply an action completed when the tool only opened Android UI.';
+  }
+}
