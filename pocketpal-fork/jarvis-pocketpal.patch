+  ToolDefinition,
+} from '../../services/talents/types';
+import {agentDevice, type AgentDeviceApi} from '../native/AgentDevice';
+
+export class DeviceStatusEngine implements TalentEngine {
+  readonly name = 'device_status';
+
+  constructor(private readonly device: AgentDeviceApi = agentDevice) {}
+
+  async execute(): Promise<TalentResult> {
+    try {
+      const state = await this.device.getDeviceState();
+      return {type: 'text', summary: JSON.stringify(state)};
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return {
+        type: 'error',
+        summary: `device_status failed: ${message}`,
+        errorMessage: message,
+      };
+    }
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: this.name,
+        description:
+          'Read current Android device, battery, power-save, memory, and storage status.',
+        parameters: {
+          type: 'object',
+          properties: {},
+          additionalProperties: false,
+        },
+      },
+    };
+  }
+
+  systemPromptFragment(): string {
+    return 'Use device_status for current phone state; never guess battery, memory, or storage values.';
+  }
+}
