+import {NativeModules, Platform} from 'react-native';
+
+export interface DeviceState {
+  manufacturer: string;
+  model: string;
+  androidVersion: string;
+  apiLevel: number;
+  batteryPercent: number;
+  charging: boolean;
+  powerSaveMode: boolean;
+  availableMemoryBytes: number;
+  totalMemoryBytes: number;
+  availableStorageBytes: number;
+  totalStorageBytes: number;
+}
+
+export interface AgentDeviceApi {
+  getDeviceState(): Promise<DeviceState>;
+  openApp(target: string): Promise<string>;
+  openSystemSettings(section: string): Promise<string>;
+  setFlashlight(enabled: boolean): Promise<string>;
+  setMediaVolume(percent: number): Promise<string>;
+  createAlarm(hour: number, minute: number, label?: string): Promise<string>;
+  startTimer(seconds: number, label?: string): Promise<string>;
+  playFindPhoneSound(): Promise<string>;
+}
+
+function unavailable(): never {
+  throw new Error('Android device actions are unavailable on this platform.');
+}
+
+const nativeModule = NativeModules.AgentDeviceModule as
+  | AgentDeviceApi
+  | undefined;
+
+export const agentDevice: AgentDeviceApi = {
+  getDeviceState: () =>
+    Platform.OS === 'android' && nativeModule
+      ? nativeModule.getDeviceState()
+      : unavailable(),
+  openApp: target =>
+    Platform.OS === 'android' && nativeModule
+      ? nativeModule.openApp(target)
+      : unavailable(),
+  openSystemSettings: section =>
+    Platform.OS === 'android' && nativeModule
+      ? nativeModule.openSystemSettings(section)
+      : unavailable(),
+  setFlashlight: enabled =>
+    Platform.OS === 'android' && nativeModule
+      ? nativeModule.setFlashlight(enabled)
+      : unavailable(),
+  setMediaVolume: percent =>
+    Platform.OS === 'android' && nativeModule
+      ? nativeModule.setMediaVolume(percent)
+      : unavailable(),
+  createAlarm: (hour, minute, label) =>
+    Platform.OS === 'android' && nativeModule
+      ? nativeModule.createAlarm(hour, minute, label)
+      : unavailable(),
+  startTimer: (seconds, label) =>
+    Platform.OS === 'android' && nativeModule
+      ? nativeModule.startTimer(seconds, label)
+      : unavailable(),
+  playFindPhoneSound: () =>
+    Platform.OS === 'android' && nativeModule
+      ? nativeModule.playFindPhoneSound()
+      : unavailable(),
+};
