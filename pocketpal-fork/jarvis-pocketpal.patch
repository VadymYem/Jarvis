diff --git a/android/app/src/main/java/top/authorche/agent/AgentDeviceModule.kt b/android/app/src/main/java/top/authorche/agent/AgentDeviceModule.kt
new file mode 100644
index 0000000..bde957e
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/AgentDeviceModule.kt
@@ -0,0 +1,268 @@
+package top.authorche.agent
+
+import android.Manifest
+import android.app.ActivityManager
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraManager
+import android.media.AudioManager
+import android.media.MediaPlayer
+import android.net.Uri
+import android.os.BatteryManager
+import android.os.Build
+import android.os.Environment
+import android.os.PowerManager
+import android.os.StatFs
+import android.provider.AlarmClock
+import android.provider.MediaStore
+import android.provider.Settings
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import java.util.Locale
+
+class AgentDeviceModule(private val context: ReactApplicationContext) :
+  ReactContextBaseJavaModule(context) {
+
+  private var findPhonePlayer: MediaPlayer? = null
+
+  override fun getName(): String = NAME
+
+  @ReactMethod
+  fun getDeviceState(promise: Promise) {
+    try {
+      val battery = context.getSystemService(Context.BATTERY_SERVICE) as BatteryManager
+      val power = context.getSystemService(Context.POWER_SERVICE) as PowerManager
+      val activity = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+      val memory = ActivityManager.MemoryInfo().also(activity::getMemoryInfo)
+      val storage = StatFs(Environment.getDataDirectory().absolutePath)
+
+      val result = Arguments.createMap().apply {
+        putString("manufacturer", Build.MANUFACTURER)
+        putString("model", Build.MODEL)
+        putString("androidVersion", Build.VERSION.RELEASE)
+        putInt("apiLevel", Build.VERSION.SDK_INT)
+        putInt(
+          "batteryPercent",
+          battery.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)
+        )
+        putBoolean(
+          "charging",
+          battery.isCharging
+        )
+        putBoolean("powerSaveMode", power.isPowerSaveMode)
+        putDouble("availableMemoryBytes", memory.availMem.toDouble())
+        putDouble("totalMemoryBytes", memory.totalMem.toDouble())
+        putDouble("availableStorageBytes", storage.availableBytes.toDouble())
+        putDouble("totalStorageBytes", storage.totalBytes.toDouble())
+      }
+      promise.resolve(result)
+    } catch (error: Exception) {
+      promise.reject("DEVICE_STATE_FAILED", error.message, error)
+    }
+  }
+
+  @ReactMethod
+  fun openApp(target: String, promise: Promise) {
+    try {
+      val pm = context.packageManager
+      val packageLaunch = pm.getLaunchIntentForPackage(target)
+      val launchIntent = packageLaunch ?: findLauncherByLabel(pm, target)
+      if (launchIntent == null) {
+        promise.reject("APP_NOT_FOUND", "No launchable app matches '$target'.")
+        return
+      }
+      launchIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+      context.startActivity(launchIntent)
+      promise.resolve("Opened ${launchIntent.`package` ?: target}.")
+    } catch (error: Exception) {
+      promise.reject("OPEN_APP_FAILED", error.message, error)
+    }
+  }
+
+  private fun findLauncherByLabel(pm: PackageManager, target: String): Intent? {
+    val query = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
+    val match = pm.queryIntentActivities(query, 0).firstOrNull { info ->
+      info.loadLabel(pm).toString().lowercase(Locale.ROOT) == target.lowercase(Locale.ROOT)
+    } ?: return null
+    return pm.getLaunchIntentForPackage(match.activityInfo.packageName)
+  }
+
+  @ReactMethod
+  fun openSystemSettings(section: String, promise: Promise) {
+    try {
+      val action = when (section.lowercase(Locale.ROOT)) {
+        "wifi" -> Settings.ACTION_WIFI_SETTINGS
+        "bluetooth" -> Settings.ACTION_BLUETOOTH_SETTINGS
+        "accessibility" -> Settings.ACTION_ACCESSIBILITY_SETTINGS
+        "notification_listener" -> Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS
+        "battery" -> Settings.ACTION_BATTERY_SAVER_SETTINGS
+        "location" -> Settings.ACTION_LOCATION_SOURCE_SETTINGS
+        "dnd" -> Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS
+        "app_details" -> Settings.ACTION_APPLICATION_DETAILS_SETTINGS
+        else -> {
+          promise.reject("UNKNOWN_SETTINGS_SECTION", "Unsupported settings section '$section'.")
+          return
+        }
+      }
+      val intent = Intent(action).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+      if (section.lowercase(Locale.ROOT) == "app_details") {
+        intent.data = Uri.parse("package:${context.packageName}")
+      }
+      context.startActivity(intent)
+      promise.resolve("Opened Android settings: $section.")
+    } catch (error: Exception) {
+      promise.reject("OPEN_SETTINGS_FAILED", error.message, error)
+    }
+  }
+
+  @ReactMethod
+  fun setFlashlight(enabled: Boolean, promise: Promise) {
+    if (context.checkSelfPermission(Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+      promise.reject("CAMERA_PERMISSION_REQUIRED", "Camera permission is required to control the flashlight.")
+      return
+    }
+    try {
+      val manager = context.getSystemService(Context.CAMERA_SERVICE) as CameraManager
+      val cameraId = manager.cameraIdList.firstOrNull { id ->
+        val characteristics = manager.getCameraCharacteristics(id)
+        characteristics.get(CameraCharacteristics.FLASH_INFO_AVAILABLE) == true &&
+          characteristics.get(CameraCharacteristics.LENS_FACING) == CameraCharacteristics.LENS_FACING_BACK
+      }
+      if (cameraId == null) {
+        promise.reject("FLASHLIGHT_UNAVAILABLE", "No controllable rear flashlight was found.")
+        return
+      }
+      manager.setTorchMode(cameraId, enabled)
+      promise.resolve("Flashlight ${if (enabled) "enabled" else "disabled"}.")
+    } catch (error: Exception) {
+      promise.reject("FLASHLIGHT_FAILED", error.message, error)
+    }
+  }
+
+  @ReactMethod
+  fun setMediaVolume(percent: Double, promise: Promise) {
+    try {
+      val audio = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+      val safePercent = percent.coerceIn(0.0, 100.0)
+      val max = audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
+      val target = (max * safePercent / 100.0).toInt()
+      audio.setStreamVolume(AudioManager.STREAM_MUSIC, target, 0)
+      promise.resolve("Media volume set to ${safePercent.toInt()}%.")
+    } catch (error: Exception) {
+      promise.reject("VOLUME_FAILED", error.message, error)
+    }
+  }
+
+  @ReactMethod
+  fun createAlarm(hour: Double, minute: Double, label: String?, promise: Promise) {
+    val h = hour.toInt()
+    val m = minute.toInt()
+    if (h !in 0..23 || m !in 0..59) {
+      promise.reject("INVALID_ALARM_TIME", "Hour must be 0-23 and minute 0-59.")
+      return
+    }
+    startResolvableActivity(
+      Intent(AlarmClock.ACTION_SET_ALARM)
+        .putExtra(AlarmClock.EXTRA_HOUR, h)
+        .putExtra(AlarmClock.EXTRA_MINUTES, m)
+        .putExtra(AlarmClock.EXTRA_MESSAGE, label ?: "Jarvis")
+        .putExtra(AlarmClock.EXTRA_SKIP_UI, false),
+      "alarm",
+      promise
+    )
+  }
+
+  @ReactMethod
+  fun startTimer(seconds: Double, label: String?, promise: Promise) {
+    val safeSeconds = seconds.toInt()
+    if (safeSeconds <= 0) {
+      promise.reject("INVALID_TIMER_DURATION", "Timer duration must be greater than zero.")
+      return
+    }
+    startResolvableActivity(
+      Intent(AlarmClock.ACTION_SET_TIMER)
+        .putExtra(AlarmClock.EXTRA_LENGTH, safeSeconds)
+        .putExtra(AlarmClock.EXTRA_MESSAGE, label ?: "Jarvis")
+        .putExtra(AlarmClock.EXTRA_SKIP_UI, false),
+      "timer",
+      promise
+    )
+  }
+
+  private fun startResolvableActivity(intent: Intent, label: String, promise: Promise) {
+    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+    if (intent.resolveActivity(context.packageManager) == null) {
+      promise.reject("INTENT_UNAVAILABLE", "No Android app can handle the $label request.")
+      return
+    }
+    context.startActivity(intent)
+    promise.resolve("Opened the system $label flow for confirmation.")
+  }
+
+  @ReactMethod
+  fun playFindPhoneSound(promise: Promise) {
+    if (
+      Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
+      context.checkSelfPermission(Manifest.permission.READ_MEDIA_AUDIO) != PackageManager.PERMISSION_GRANTED
+    ) {
+      promise.reject(
+        "AUDIO_PERMISSION_REQUIRED",
+        "Audio permission is required to find was-wollen-wir-trinken.mp3."
+      )
+      return
+    }
+    try {
+      val collection = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI
+      val projection = arrayOf(MediaStore.Audio.Media._ID, MediaStore.Audio.Media.DISPLAY_NAME)
+      val cursor = context.contentResolver.query(collection, projection, null, null, null)
+      var found: Uri? = null
+      cursor?.use {
+        val idIndex = it.getColumnIndexOrThrow(MediaStore.Audio.Media._ID)
+        val nameIndex = it.getColumnIndexOrThrow(MediaStore.Audio.Media.DISPLAY_NAME)
+        while (it.moveToNext()) {
+          if (it.getString(nameIndex).equals(FIND_PHONE_FILENAME, ignoreCase = true)) {
+            found = Uri.withAppendedPath(collection, it.getLong(idIndex).toString())
+            break
+          }
+        }
+      }
+      if (found == null) {
+        promise.reject("FIND_PHONE_AUDIO_MISSING", "$FIND_PHONE_FILENAME was not found in device audio.")
+        return
+      }
+      val audio = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+      audio.setStreamVolume(
+        AudioManager.STREAM_MUSIC,
+        audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC),
+        0
+      )
+      findPhonePlayer?.release()
+      findPhonePlayer = MediaPlayer.create(context, found).apply {
+        setOnCompletionListener {
+          it.release()
+          if (findPhonePlayer === it) findPhonePlayer = null
+        }
+        start()
+      }
+      promise.resolve("Playing $FIND_PHONE_FILENAME at maximum media volume.")
+    } catch (error: Exception) {
+      promise.reject("FIND_PHONE_FAILED", error.message, error)
+    }
+  }
+
+  override fun invalidate() {
+    findPhonePlayer?.release()
+    findPhonePlayer = null
+    super.invalidate()
+  }
+
+  companion object {
+    const val NAME = "AgentDeviceModule"
+    private const val FIND_PHONE_FILENAME = "was-wollen-wir-trinken.mp3"
+  }
+}
