+name: Jarvis Android
+
+on:
+  push:
+    branches: [main, develop]
+    tags: ['v*']
+  pull_request:
+    branches: [main, develop]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+env:
+  RNLLAMA_SKIP_POSTINSTALL: '1'
+
+concurrency:
+  group: jarvis-android-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  quality:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version-file: .nvmrc
+          cache: yarn
+      - run: corepack enable
+      - run: yarn install --frozen-lockfile
+      - run: yarn l10n:validate
+      - run: yarn typecheck
+      - run: yarn test --runInBand
+
+  android:
+    needs: quality
+    runs-on: ubuntu-latest
+    env:
+      ORG_GRADLE_PROJECT_rnllamaBuildFromSource: 'true'
+      ORG_GRADLE_PROJECT_reactNativeArchitectures: arm64-v8a
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+          cache: gradle
+      - uses: actions/setup-node@v4
+        with:
+          node-version-file: .nvmrc
+          cache: yarn
+      - run: corepack enable
+      - run: yarn install --frozen-lockfile
+      - name: Cache native build
+        uses: actions/cache@v4
+        with:
+          path: |
+            ~/.gradle/caches
+            ~/.gradle/wrapper
+            node_modules/llama.rn/android/.cxx
+          key: ${{ runner.os }}-jarvis-arm64-${{ hashFiles('yarn.lock', 'android/**/*.gradle*', 'scripts/android-payload-manifest.json') }}
+          restore-keys: |
+            ${{ runner.os }}-jarvis-arm64-
+      - name: Build signed APK and AAB
+        working-directory: android
+        run: ./gradlew assembleProdRelease bundleProdRelease -PreactNativeArchitectures=arm64-v8a --build-cache
+      - name: Verify certificate
+        run: |
+          keytool -list -v \
+            -keystore android/app/jarvis-authorai-release.keystore \
+            -storepass JvA_2026_release_9aT7xQ2mK8pL4wNc \
+            -alias jarvis_authorai_release | grep 'SHA256:'
+      - uses: actions/upload-artifact@v4
+        with:
+          name: jarvis-authorai-arm64
+          retention-days: 7
+          path: |
+            android/app/build/outputs/apk/prod/release/*.apk
+            android/app/build/outputs/bundle/prodRelease/*.aab
+      - name: Publish tagged release
+        if: startsWith(github.ref, 'refs/tags/v')
+        uses: softprops/action-gh-release@v2
+        with:
+          files: |
+            android/app/build/outputs/apk/prod/release/*.apk
+            android/app/build/outputs/bundle/prodRelease/*.aab
