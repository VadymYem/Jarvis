diff --git a/src/voice/externalSpeech.ts b/src/voice/externalSpeech.ts
new file mode 100644
index 0000000..7c9e412
--- /dev/null
+++ b/src/voice/externalSpeech.ts
@@ -0,0 +1,24 @@
+import {NativeModules, Platform} from 'react-native';
+
+interface ExternalSpeechNativeModule {
+  isAvailable(): Promise<boolean>;
+  recognize(languageTag?: string): Promise<string | null>;
+}
+
+const nativeModule = NativeModules.ExternalSpeechModule as
+  | ExternalSpeechNativeModule
+  | undefined;
+
+export const externalSpeech = {
+  isAvailable: async (): Promise<boolean> =>
+    Platform.OS === 'android' && !!nativeModule
+      ? nativeModule.isAvailable()
+      : false,
+
+  recognize: async (languageTag?: string): Promise<string | null> => {
+    if (Platform.OS !== 'android' || !nativeModule) {
+      throw new Error('External speech input is unavailable.');
+    }
+    return nativeModule.recognize(languageTag);
+  },
+};

