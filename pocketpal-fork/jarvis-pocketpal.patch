@@ -0,0 +1,112 @@
+package top.authorche.agent
+
+import android.app.Activity
+import android.content.Intent
+import android.speech.RecognizerIntent
+import com.facebook.react.bridge.ActivityEventListener
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import java.util.Locale
+
+class ExternalSpeechModule(private val context: ReactApplicationContext) :
+  ReactContextBaseJavaModule(context), ActivityEventListener {
+
+  private var pendingPromise: Promise? = null
+
+  init {
+    context.addActivityEventListener(this)
+  }
+
+  override fun getName(): String = NAME
+
+  @ReactMethod
+  fun isAvailable(promise: Promise) {
+    val intent = recognitionIntent(null)
+    val available = context.packageManager.queryIntentActivities(intent, 0).isNotEmpty()
+    promise.resolve(available)
+  }
+
+  @ReactMethod
+  fun recognize(languageTag: String?, promise: Promise) {
+    if (pendingPromise != null) {
+      promise.reject("DICTATION_BUSY", "A dictation request is already active.")
+      return
+    }
+    val activity = context.currentActivity
+    if (activity == null) {
+      promise.reject("NO_ACTIVITY", "Jarvis must be visible to start dictation.")
+      return
+    }
+    val intent = recognitionIntent(languageTag)
+    if (context.packageManager.queryIntentActivities(intent, 0).isEmpty()) {
+      promise.reject(
+        "NO_SPEECH_PROVIDER",
+        "No installed app exposes Android speech-recognition activity."
+      )
+      return
+    }
+    pendingPromise = promise
+    try {
+      activity.startActivityForResult(
+        Intent.createChooser(intent, "Choose speech input"),
+        REQUEST_CODE
+      )
+    } catch (error: Exception) {
+      pendingPromise = null
+      promise.reject("DICTATION_START_FAILED", error.message, error)
+    }
+  }
+
+  private fun recognitionIntent(languageTag: String?): Intent =
+    Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
+      putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
+      putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false)
+      putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, true)
+      putExtra(RecognizerIntent.EXTRA_PROMPT, "Speak to Jarvis")
+      val language = languageTag?.takeIf { it.isNotBlank() }
+        ?: Locale.getDefault().toLanguageTag()
+      putExtra(RecognizerIntent.EXTRA_LANGUAGE, language)
+    }
+
+  override fun onActivityResult(
+    activity: Activity,
+    requestCode: Int,
+    resultCode: Int,
+    data: Intent?
+  ) {
+    if (requestCode != REQUEST_CODE) return
+    val promise = pendingPromise ?: return
+    pendingPromise = null
+    if (resultCode == Activity.RESULT_CANCELED) {
+      promise.resolve(null)
+      return
+    }
+    if (resultCode != Activity.RESULT_OK) {
+      promise.reject("DICTATION_FAILED", "Speech input returned result code $resultCode.")
+      return
+    }
+    val results = data?.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS)
+    val text = results?.firstOrNull()?.trim()
+    if (text.isNullOrEmpty()) {
+      promise.reject("DICTATION_EMPTY", "Speech input returned no text.")
+    } else {
+      promise.resolve(text)
+    }
+  }
+
+  override fun onNewIntent(intent: Intent) = Unit
+
+  override fun invalidate() {
+    pendingPromise?.reject("DICTATION_CANCELLED", "Jarvis closed before dictation completed.")
+    pendingPromise = null
+    context.removeActivityEventListener(this)
+    super.invalidate()
+  }
+
+  companion object {
+    const val NAME = "ExternalSpeechModule"
+    private const val REQUEST_CODE = 47291
+  }
+}
