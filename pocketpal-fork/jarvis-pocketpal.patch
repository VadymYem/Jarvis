+import {DeviceActionEngine} from '../DeviceActionEngine';
+import type {AgentDeviceApi} from '../../native/AgentDevice';
+
+const makeDevice = (): jest.Mocked<AgentDeviceApi> => ({
+  getDeviceState: jest.fn(),
+  openApp: jest.fn().mockResolvedValue('Opened app.'),
+  openSystemSettings: jest.fn().mockResolvedValue('Opened settings.'),
+  setFlashlight: jest.fn().mockResolvedValue('Flashlight enabled.'),
+  setMediaVolume: jest.fn().mockResolvedValue('Media volume set.'),
+  createAlarm: jest.fn().mockResolvedValue('Opened alarm flow.'),
+  startTimer: jest.fn().mockResolvedValue('Opened timer flow.'),
+  playFindPhoneSound: jest.fn().mockResolvedValue('Playing audio.'),
+});
+
+describe('DeviceActionEngine', () => {
+  it('dispatches supported actions to the native bridge', async () => {
+    const device = makeDevice();
+    const result = await new DeviceActionEngine(device).execute({
+      action: 'start_timer',
+      seconds: 300,
+      label: 'Tea',
+    });
+    expect(device.startTimer).toHaveBeenCalledWith(300, 'Tea');
+    expect(result).toEqual({type: 'text', summary: 'Opened timer flow.'});
+  });
+
+  it('returns a tool error instead of claiming success for invalid arguments', async () => {
+    const device = makeDevice();
+    const result = await new DeviceActionEngine(device).execute({
+      action: 'flashlight',
+      enabled: 'yes',
+    });
+    expect(result.type).toBe('error');
+    expect(device.setFlashlight).not.toHaveBeenCalled();
+  });
+
+  it('describes the supported Android action allowlist', () => {
+    const device = makeDevice();
+    const schema = new DeviceActionEngine(device).toToolDefinition();
+    expect(schema.function.name).toBe('device_action');
+    expect(schema.function.parameters.properties.action.enum).toContain(
+      'find_phone',
+    );
+  });
+});
