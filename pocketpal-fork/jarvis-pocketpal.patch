+/**
+ * Jarvis Android is intentionally Firebase-free.
+ *
+ * Upstream uses Firebase App Check only for optional benchmark/feedback
+ * submission. Importing RNFirebase through the shared utils barrel made those
+ * native modules part of the Android startup graph even though Jarvis removes
+ * google-services/Firebase Gradle configuration. Keep the API surface so
+ * upstream callers still type-check, but fail only when an optional remote
+ * submission is explicitly requested instead of during application startup.
+ */
+const disabledError = () =>
+  new Error(
+    'Firebase App Check is disabled in Jarvis | AuthorAi. Local benchmarks and the core agent remain available.',
+  );
+
+export const initializeAppCheck = async (): Promise<void> => {
+  throw disabledError();
+};
+
+export const getAppCheckToken = async (): Promise<string> => {
+  throw disabledError();
+};
