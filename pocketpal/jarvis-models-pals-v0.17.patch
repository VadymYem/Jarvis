+import {selectTurnTalents} from '../turnRouting';
+
+const defaults = {
+  available: [
+    'workspace',
+    'python_exec',
+    'android_document',
+    'knowledge_search',
+    'web_search',
+    'read_url',
+  ],
+  configured: [] as string[],
+  work: false,
+  artifact: false,
+  mentions: [] as Parameters<typeof selectTurnTalents>[0]['mentions'],
+  searchingWeb: false,
+  archiveIds: null,
+};
+
+describe('chat tool routing', () => {
+  it('leaves ordinary conversation out of the JSON action protocol', () => {
+    expect(selectTurnTalents(defaults)).toEqual([]);
+  });
+  it('keeps artifact execution available without Work or a PAL', () => {
+    expect(selectTurnTalents({...defaults, artifact: true})).toEqual([
+      'workspace',
+      'python_exec',
+      'android_document',
+    ]);
+  });
+  it('does not expose unselected articles in Work', () => {
+    expect(selectTurnTalents({...defaults, work: true})).not.toContain(
+      'knowledge_search',
+    );
+    expect(
+      selectTurnTalents({...defaults, work: true, archiveIds: []}),
+    ).not.toContain('knowledge_search');
+    expect(
+      selectTurnTalents({...defaults, work: true, archiveIds: ['chosen']}),
+    ).toContain('knowledge_search');
