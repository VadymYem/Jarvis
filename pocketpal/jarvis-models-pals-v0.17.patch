@@ -0,0 +1,57 @@
+import type {JarvisToolMention} from './toolMentions';
+
+/** Ordinary conversation does not pay the cost of an agent action protocol. */
+export function selectTurnTalents({
+  available,
+  configured,
+  work,
+  artifact,
+  mentions,
+  searchingWeb,
+  archiveIds,
+}: {
+  available: string[];
+  configured: string[];
+  work: boolean;
+  artifact: boolean;
+  mentions: JarvisToolMention[];
+  searchingWeb: boolean;
+  archiveIds: string[] | null;
+}): string[] {
+  const execution = new Set<string>();
+  if (mentions.includes('image') || mentions.includes('python')) {
+    execution.add('python_exec');
+    execution.add('workspace');
+  }
+  if (mentions.includes('files')) {
+    execution.add('android_document');
+    execution.add('workspace');
+  }
+  let selected = work
+    ? available
+    : execution.size
+      ? available.filter(name => execution.has(name))
+      : artifact
+        ? available.filter(name =>
+            ['workspace', 'python_exec', 'android_document'].includes(name),
+          )
+        : mentions.includes('wiki') || mentions.includes('web')
+          ? []
+          : configured;
+  selected = selected.filter(name => {
+    if (
+      name === 'knowledge_search' &&
+      !mentions.includes('wiki') &&
+      !archiveIds?.length
+    )
+      return false;
+    if (
+      mentions.includes('wiki') &&
+      !mentions.includes('web') &&
+      ['web_search', 'read_url'].includes(name)
+    )
+      return false;
+    return !(searchingWeb && name === 'web_search');
+  });
+  return Array.from(new Set(selected));
+}
