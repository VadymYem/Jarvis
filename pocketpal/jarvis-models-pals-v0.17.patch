+  let raw = text.trim();
+  for (let i = 0; i < 4; i += 1) {
+    const next = raw
+      .replace(/^<(think|analysis)>[\s\S]*?<\/\1>\s*/i, '')
+      .replace(/^<\|im_start\|>assistant\s*/i, '')
+      .replace(/^<start_of_turn>model\s*/i, '');
+    if (next === raw) break;
+    raw = next;
+  }
+  raw = raw
+    .replace(/(?:<\|(?:im_end|eot_id|endoftext)\|>|<end_of_turn>)\s*$/i, '')
+    .trim();
+  const fenced = /^```(?:json)?\s*([\s\S]*?)\s*```$/i.exec(raw);
+  if (fenced) raw = fenced[1].trim();
+  if (!raw.startsWith('{'))
+    throw new Error(
+      'Очікується JSON-об’єкт дії; модель повернула текст або службові теги',
+    );
+  let value: unknown;
+  try {
+    value = JSON.parse(raw);
+  } catch {
+    throw new Error('JSON-дія неповна або містить зайвий текст');
+  }
+  if (!value || typeof value !== 'object' || Array.isArray(value))
+    throw new Error('Очікується один JSON-об’єкт дії');
+  return value as {tool?: string; arguments?: unknown; answer?: string};
