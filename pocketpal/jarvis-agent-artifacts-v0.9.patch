+import React from 'react';
+import {Image, View} from 'react-native';
+import Share from 'react-native-share';
+import {Button, Card, Text} from 'react-native-paper';
+
+import type {TalentUI} from '../../services/talents/TalentUIRegistry';
+import type {TalentResult} from '../../services/talents/types';
+
+type Artifact = {
+  name: string;
+  path: string;
+  uri: string;
+  mime: string;
+  size: number;
+  image?: boolean;
+};
+
+const MARKER = 'JARVIS_ARTIFACTS_JSON:';
+
+const artifactsFrom = (result: TalentResult): Artifact[] => {
+  if (result.type !== 'text') return [];
+  const index = result.summary.lastIndexOf(MARKER);
+  if (index < 0) return [];
+  try {
+    const parsed = JSON.parse(result.summary.slice(index + MARKER.length).trim());
+    return Array.isArray(parsed) ? parsed.filter(item => item && typeof item.uri === 'string') : [];
+  } catch {
+    return [];
+  }
+};
+
+const readableSize = (bytes: number): string => {
+  if (!Number.isFinite(bytes) || bytes < 0) return '';
+  if (bytes < 1024) return Math.round(bytes) + ' B';
+  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
+  return (bytes / 1024 / 1024).toFixed(1) + ' MB';
+};
+
+export class ArtifactTalentUI implements TalentUI {
+  constructor(readonly name: string) {}
+
+  renderResult(result: TalentResult): React.ReactNode {
+    const artifacts = artifactsFrom(result);
+    if (!artifacts.length) return null;
+    return (
+      <View style={{gap: 8, marginVertical: 6}}>
+        {artifacts.map((artifact, index) => (
+          <Card key={artifact.uri + String(index)} mode="outlined">
+            {artifact.image && (
+              <Image
+                source={{uri: artifact.uri}}
+                style={{width: '100%', height: 240}}
+                resizeMode="contain"
+              />
+            )}
+            <Card.Content style={{gap: 4, paddingTop: 10}}>
+              <Text variant="titleSmall" selectable>{artifact.name}</Text>
+              <Text variant="bodySmall">
+                {artifact.mime + (artifact.size ? ' · ' + readableSize(artifact.size) : '')}
+              </Text>
+              <Button
+                mode="contained-tonal"
+                compact
+                onPress={() => Share.open({
+                  url: artifact.uri,
+                  type: artifact.mime || undefined,
+                  failOnCancel: false,
+                }).catch(() => undefined)}>
+                Поділитися / зберегти
+              </Button>
+            </Card.Content>
+          </Card>
+        ))}
+      </View>
+    );
+  }
+}
