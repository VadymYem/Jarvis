+import {Alert, NativeModules, Platform} from 'react-native';
+import type {
+  TalentEngine,
+  TalentResult,
+  ToolDefinition,
+  SystemPromptContext,
+} from '../../services/talents/types';
+
+type Artifact = {
+  name: string;
+  path: string;
+  uri: string;
+  mime: string;
+  size: number;
+  image: boolean;
+};
+type PythonResult = {
+  stdout: string;
+  stderr: string;
+  error: string | null;
+  created: string[];
+  artifacts?: Artifact[];
+};
+interface LocalPythonNative {
+  runPython(code: string): Promise<{result: string; workspace: string}>;
+}
+
+const native = NativeModules.LocalPythonModule as LocalPythonNative | undefined;
+const ARTIFACT_MARKER = 'JARVIS_ARTIFACTS_JSON:';
+
+const confirmRisky = (code: string): Promise<boolean> => {
+  const risky =
+    /\b(?:subprocess|socket|requests|urllib|http\.client|shutil|os\.|Runtime|system\s*\()/.test(code) ||
+    /open\s*\(\s*['"]\//.test(code);
+  if (!risky) return Promise.resolve(true);
+  return new Promise(resolve => {
+    Alert.alert(
+      'Запустити розширений Python?',
+      'Скрипт використовує системні або мережеві API поза звичайною генерацією файлів.',
+      [
+        {text: 'Скасувати', style: 'cancel', onPress: () => resolve(false)},
+        {text: 'Запустити', onPress: () => resolve(true)},
+      ],
+      {cancelable: false},
+    );
+  });
+};
+
+export class PythonExecEngine implements TalentEngine {
+  readonly name = 'python_exec';
+  readonly recommendedContextTokens = 2200;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    if (Platform.OS !== 'android' || !native) {
+      return {
+        type: 'error',
+        summary: 'python_exec: embedded Python is unavailable.',
+        errorMessage: 'Python execution is available only on Android.',
+      };
+    }
+    const code = typeof args.code === 'string' ? args.code : '';
+    if (!code.trim() || code.length > 30000) {
+      return {
+        type: 'error',
+        summary: 'python_exec: missing or oversized code.',
+        errorMessage: 'The code argument must contain 1–30,000 characters.',
+      };
+    }
+    try {
+      if (!(await confirmRisky(code))) {
+        return {type: 'text', summary: 'User declined extended Python execution.'};
+      }
+      const run = await native.runPython(code);
+      const result = JSON.parse(run.result) as PythonResult;
+      const artifacts = Array.isArray(result.artifacts) ? result.artifacts : [];
+      const human = [
+        result.stdout?.trim() ? 'stdout:\n' + result.stdout.trim() : '',
+        result.stderr?.trim() ? 'stderr:\n' + result.stderr.trim() : '',
+        result.error?.trim() ? 'error:\n' + result.error.trim() : '',
+        artifacts.length
+          ? 'Created artifacts:\n' +
+            artifacts.map(item => item.name + ' · ' + item.mime + ' · ' + item.size + ' B').join('\n')
+          : '',
+      ]
+        .filter(Boolean)
+        .join('\n\n')
+        .slice(0, 56000);
+      const marker = artifacts.length
+        ? '\n' + ARTIFACT_MARKER + JSON.stringify(artifacts)
+        : '';
+      const output = (human || 'Python completed without output.') + marker;
+      if (result.error) {
+        return {type: 'error', summary: output, errorMessage: human || result.error};
+      }
+      return {type: 'text', summary: output};
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return {type: 'error', summary: 'python_exec: ' + message, errorMessage: message};
+    }
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string {
+    return [
+      'ARTIFACT EXECUTION CONTRACT:',
+      'When the user asks to create an image, PDF, DOCX, HTML, source file, report, chart, card or other downloadable artifact, do not merely print Python or describe how to make it. Call python_exec and actually write the requested file into the current Jarvis workspace.',
+      'For PDF, legacy DOC and DOCX, prefer: from jarvis_artifacts import create_pdf, create_doc, create_docx. For simple visual cards use create_card; for charts and custom raster graphics use Pillow directly. Use UTF-8 and Ukrainian-capable Noto/Roboto system fonts.',
+      'After the tool returns Created artifacts, answer briefly and refer to the real artifact shown in chat. Do not paste the implementation code unless the user explicitly asks for code.',
+      'Python/Pillow can create designed graphics, charts, diagrams and composited images; it is not a diffusion model. Never claim a photorealistic AI image was synthesized unless a real image-generation model/tool actually produced it.',
+      'Keep generated paths relative, descriptive and with the correct extension. Reuse or update files when the user requests revisions.',
+    ].join(' ');
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: this.name,
+        description:
+          'Execute bounded Python 3.12 locally to analyze data or create real workspace artifacts. Pillow, pypdf and jarvis_artifacts helpers are available. Safe artifact scripts run without an extra dialog; system/network-oriented scripts require confirmation.',
+        parameters: {
+          type: 'object',
+          properties: {
+            code: {
+              type: 'string',
+              description:
+                'Python 3 source. For files, write into the current workspace and use jarvis_artifacts helpers where appropriate.',
+            },
+          },
+          required: ['code'],
+          additionalProperties: false,
+        },
+      },
+    };
+  }
+}
