diff --git a/android/app/src/main/java/top/authorche/agent/ManagedDocumentsModule.kt b/android/app/src/main/java/top/authorche/agent/ManagedDocumentsModule.kt
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/ManagedDocumentsModule.kt
@@ -0,0 +1,227 @@
+package top.authorche.agent
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import android.provider.OpenableColumns
+import com.chaquo.python.Python
+import com.chaquo.python.android.AndroidPlatform
+import com.facebook.react.bridge.ActivityEventListener
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.BaseActivityEventListener
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import java.io.File
+import java.util.concurrent.Executors
+
+/**
+ * General Android document bridge.
+ *
+ * SAF content URIs are copied to the private Jarvis workspace before parsing.
+ * This gives Python and native parsers a real seekable path and avoids /dev/fd
+ * compatibility failures. Text, code, HTML, PDF, DOC/DOCX, RTF, ODT, PPTX and
+ * XLSX are parsed locally; unknown text-like formats fall back to decoding.
+ */
+class ManagedDocumentsModule(private val context: ReactApplicationContext) :
+  ReactContextBaseJavaModule(context) {
+
+  private val worker = Executors.newSingleThreadExecutor()
+  private var pending: Promise? = null
+
+  private val listener: ActivityEventListener = object : BaseActivityEventListener() {
+    override fun onActivityResult(activity: Activity, requestCode: Int, resultCode: Int, data: Intent?) {
+      if (requestCode != PICK) return
+      val promise = pending ?: return
+      pending = null
+      if (resultCode != Activity.RESULT_OK || data?.data == null) {
+        promise.resolve(null)
+        return
+      }
+      val uri = data.data!!
+      val granted = data.flags and
+        (Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION)
+      if (granted != 0) {
+        try { context.contentResolver.takePersistableUriPermission(uri, granted) }
+        catch (_: SecurityException) { /* Some providers grant only for this process. */ }
+      }
+      worker.execute {
+        try { promise.resolve(readDocument(uri)) }
+        catch (error: Exception) { promise.reject("DOCUMENT_READ_FAILED", error.message, error) }
+      }
+    }
+  }
+
+  init { context.addActivityEventListener(listener) }
+
+  override fun getName() = "AndroidDocumentsModule"
+
+  @ReactMethod fun openText(promise: Promise) {
+    if (pending != null) {
+      promise.reject("PICKER_BUSY", "File picker already open")
+      return
+    }
+    val activity = context.currentActivity ?: run {
+      promise.reject("NO_ACTIVITY", "Android activity unavailable")
+      return
+    }
+    pending = promise
+    try {
+      activity.startActivityForResult(Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+        addCategory(Intent.CATEGORY_OPENABLE)
+        type = "*/*"
+        addFlags(
+          Intent.FLAG_GRANT_READ_URI_PERMISSION or
+            Intent.FLAG_GRANT_WRITE_URI_PERMISSION or
+            Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION
+        )
+      }, PICK)
+    } catch (error: Exception) {
+      pending = null
+      promise.reject("PICKER_FAILED", error.message, error)
+    }
+  }
+
+  @ReactMethod fun readText(uriText: String, promise: Promise) {
+    worker.execute {
+      try { promise.resolve(readDocument(authorizedUri(uriText))) }
+      catch (error: Exception) { promise.reject("DOCUMENT_READ_FAILED", error.message, error) }
+    }
+  }
+
+  @ReactMethod fun writeText(uriText: String, content: String, promise: Promise) {
+    worker.execute {
+      try {
+        require(content.length <= 2_000_000) { "Text exceeds 2 MB" }
+        val uri = authorizedUri(uriText, write = true)
+        val name = displayName(uri)
+        require(isTextWritable(name, context.contentResolver.getType(uri))) {
+          "Binary documents are not overwritten as plain text. Create a new PDF/DOCX with python_exec instead."
+        }
+        context.contentResolver.openOutputStream(uri, "wt")?.use {
+          it.write(content.toByteArray(Charsets.UTF_8))
+        } ?: error("Cannot open document for writing")
+        promise.resolve("Saved selected Android document: $name")
+      } catch (error: Exception) {
+        promise.reject("DOCUMENT_WRITE_FAILED", error.message, error)
+      }
+    }
+  }
+
+  @ReactMethod fun listGrants(promise: Promise) {
+    val grants = Arguments.createArray()
+    context.contentResolver.persistedUriPermissions.forEach { grants.pushString(it.uri.toString()) }
+    promise.resolve(grants)
+  }
+
+  @ReactMethod fun revokeGrants(promise: Promise) {
+    try {
+      context.contentResolver.persistedUriPermissions.forEach { permission ->
+        val flags =
+          (if (permission.isReadPermission) Intent.FLAG_GRANT_READ_URI_PERMISSION else 0) or
+            (if (permission.isWritePermission) Intent.FLAG_GRANT_WRITE_URI_PERMISSION else 0)
+        if (flags != 0) {
+          try { context.contentResolver.releasePersistableUriPermission(permission.uri, flags) }
+          catch (_: SecurityException) {}
+        }
+      }
+      promise.resolve("Доступ до вибраних файлів відкликано")
+    } catch (error: Exception) {
+      promise.reject("DOCUMENT_REVOKE_FAILED", error.message, error)
+    }
+  }
+
+  private fun readDocument(uri: Uri): com.facebook.react.bridge.WritableMap {
+    val name = displayName(uri)
+    val mime = context.contentResolver.getType(uri) ?: "application/octet-stream"
+    val local = materialize(uri, name)
+    val text = try {
+      ensurePython()
+      Python.getInstance().getModule("jarvis_documents")
+        .callAttr("extract", local.canonicalPath, name, mime)
+        .toString()
+    } finally {
+      if (local.parentFile?.name == "imports") local.delete()
+    }
+    return Arguments.createMap().apply {
+      putString("uri", uri.toString())
+      putString("name", name)
+      putString("mime", mime)
+      putDouble("size", querySize(uri).coerceAtLeast(0L).toDouble())
+      putString("text", text)
+    }
+  }
+
+  private fun materialize(uri: Uri, originalName: String): File {
+    val root = File(context.filesDir, "jarvis-workspace/imports")
+    check(root.isDirectory || root.mkdirs()) { "Cannot create import workspace" }
+    val safe = originalName.map { ch ->
+      if (ch.isLetterOrDigit() || ch in "._- ()[]") ch else '_'
+    }.joinToString("").take(120).ifBlank { "document.bin" }
+    val target = File(root, System.currentTimeMillis().toString() + "-" + safe)
+    var total = 0L
+    context.contentResolver.openInputStream(uri)?.use { input ->
+      target.outputStream().buffered(1024 * 1024).use { output ->
+        val buffer = ByteArray(1024 * 1024)
+        while (true) {
+          val read = input.read(buffer)
+          if (read < 0) break
+          total += read
+          require(total <= MAX_INPUT_BYTES) { "Document exceeds 128 MB parser limit" }
+          output.write(buffer, 0, read)
+        }
+      }
+    } ?: error("Cannot open selected document")
+    return target
+  }
+
+  private fun authorizedUri(uriText: String, write: Boolean = false): Uri {
+    val uri = Uri.parse(uriText)
+    if (uri.scheme != "content") error("Select this document in Android's file picker first")
+    val persisted = context.contentResolver.persistedUriPermissions.any {
+      it.uri == uri && if (write) it.isWritePermission else it.isReadPermission
+    }
+    if (!persisted && write) error("The selected provider did not grant persistent write access")
+    return uri
+  }
+
+  private fun displayName(uri: Uri): String =
+    context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
+      if (it.moveToFirst()) it.getString(0) else null
+    } ?: (uri.lastPathSegment ?: "document")
+
+  private fun querySize(uri: Uri): Long =
+    context.contentResolver.query(uri, arrayOf(OpenableColumns.SIZE), null, null, null)?.use {
+      if (it.moveToFirst() && !it.isNull(0)) it.getLong(0) else -1L
+    } ?: -1L
+
+  private fun isTextWritable(name: String, mime: String?): Boolean {
+    if (mime?.startsWith("text/") == true) return true
+    val ext = name.substringAfterLast('.', "").lowercase()
+    return ext in setOf(
+      "txt", "md", "py", "html", "htm", "css", "js", "jsx", "ts", "tsx",
+      "json", "xml", "csv", "yaml", "yml", "toml", "ini", "log", "kt", "java",
+      "c", "cc", "cpp", "h", "hpp", "sh", "sql", "svg"
+    )
+  }
+
+  private fun ensurePython() {
+    if (!Python.isStarted()) synchronized(Python::class.java) {
+      if (!Python.isStarted()) Python.start(AndroidPlatform(context))
+    }
+  }
+
+  override fun invalidate() {
+    context.removeActivityEventListener(listener)
+    pending?.reject("DOCUMENT_CLOSED", "Document picker closed")
+    pending = null
+    worker.shutdown()
+    super.invalidate()
+  }
+
+  companion object {
+    private const val PICK = 9123
+    private const val MAX_INPUT_BYTES = 128L * 1024L * 1024L
+  }
+}
diff --git a/android/app/src/main/java/top/authorche/agent/ManagedOfflineZimModule.kt b/android/app/src/main/java/top/authorche/agent/ManagedOfflineZimModule.kt
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/ManagedOfflineZimModule.kt
@@ -0,0 +1,328 @@
+package top.authorche.agent
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import android.os.StatFs
+import android.provider.OpenableColumns
+import android.text.Html
+import com.facebook.react.bridge.ActivityEventListener
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.BaseActivityEventListener
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import org.json.JSONArray
+import org.json.JSONObject
+import org.kiwix.libkiwix.JNIKiwix
+import org.kiwix.libzim.Archive
+import org.kiwix.libzim.Query
+import org.kiwix.libzim.Searcher
+import java.io.File
+import java.util.concurrent.Executors
+
+/**
+ * Multi-archive ZIM library.
+ *
+ * Android SAF descriptors are deliberately not passed to libzim. Selected
+ * archives are copied once into app-owned storage and libzim opens the real
+ * filesystem path, matching java-libkiwix's supported Archive(path) contract.
+ */
+class ManagedOfflineZimModule(private val context: ReactApplicationContext) :
+  ReactContextBaseJavaModule(context) {
+
+  data class Entry(
+    val name: String,
+    val path: String,
+    val sourceUri: String,
+    val articles: Int,
+    val bytes: Long
+  )
+
+  private val preferences = context.getSharedPreferences("jarvis_offline_zim_v2", 0)
+  private val executor = Executors.newSingleThreadExecutor()
+  private var pending: Promise? = null
+  @Volatile private var libraryReady = false
+
+  private val listener: ActivityEventListener = object : BaseActivityEventListener() {
+    override fun onActivityResult(activity: Activity, requestCode: Int, resultCode: Int, data: Intent?) {
+      if (requestCode != PICK_ZIM) return
+      val promise = pending ?: return
+      pending = null
+      if (resultCode != Activity.RESULT_OK || data?.data == null) {
+        promise.resolve(null)
+        return
+      }
+      val uri = data.data!!
+      executor.execute {
+        try {
+          val name = displayName(uri)
+          require(name.endsWith(".zim", ignoreCase = true)) { "Виберіть файл .zim." }
+          val granted = data.flags and Intent.FLAG_GRANT_READ_URI_PERMISSION
+          if (granted != 0) {
+            try { context.contentResolver.takePersistableUriPermission(uri, granted) }
+            catch (_: SecurityException) {}
+          }
+          val existing = loadEntries().firstOrNull { it.sourceUri == uri.toString() && File(it.path).isFile }
+          if (existing != null) {
+            promise.resolve(info(existing))
+            return@execute
+          }
+          val imported = importArchive(uri, name)
+          val all = loadEntries().filter { File(it.path).isFile }.toMutableList()
+          all.add(imported)
+          saveEntries(all)
+          promise.resolve(info(imported))
+        } catch (error: Exception) {
+          promise.reject("ZIM_IMPORT", error.message, error)
+        }
+      }
+    }
+  }
+
+  init { context.addActivityEventListener(listener) }
+
+  override fun getName() = "OfflineZimModule"
+
+  @ReactMethod fun chooseArchive(promise: Promise) {
+    if (pending != null) {
+      promise.reject("ZIM_PICKER_BUSY", "Вибір архіву вже відкрито")
+      return
+    }
+    val activity = context.currentActivity ?: run {
+      promise.reject("ZIM_NO_ACTIVITY", "Відкрийте Jarvis перед вибором архіву")
+      return
+    }
+    pending = promise
+    try {
+      activity.startActivityForResult(Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+        addCategory(Intent.CATEGORY_OPENABLE)
+        type = "*/*"
+        addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION)
+      }, PICK_ZIM)
+    } catch (error: Exception) {
+      pending = null
+      promise.reject("ZIM_PICKER", error.message, error)
+    }
+  }
+
+  @ReactMethod fun status(promise: Promise) {
+    executor.execute {
+      try {
+        val entries = loadEntries().filter { File(it.path).isFile }
+        if (entries.size != loadEntries().size) saveEntries(entries)
+        val archives = Arguments.createArray()
+        entries.forEach { e ->
+          archives.pushMap(Arguments.createMap().apply {
+            putString("name", e.name)
+            putDouble("bytes", e.bytes.toDouble())
+            putInt("articles", e.articles)
+          })
+        }
+        promise.resolve(Arguments.createMap().apply {
+          putBoolean("ready", entries.isNotEmpty())
+          putString("name", when (entries.size) {
+            0 -> null
+            1 -> entries.first().name
+            else -> entries.size.toString() + " ZIM архівів"
+          })
+          putInt("articles", entries.sumOf { it.articles })
+          putArray("archives", archives)
+        })
+      } catch (error: Exception) {
+        promise.reject("ZIM_STATUS", error.message, error)
+      }
+    }
+  }
+
+  @ReactMethod fun forgetArchive(promise: Promise) {
+    executor.execute {
+      val entries = loadEntries()
+      entries.forEach { entry ->
+        try { File(entry.path).delete() } catch (_: Exception) {}
+        try {
+          context.contentResolver.releasePersistableUriPermission(
+            Uri.parse(entry.sourceUri), Intent.FLAG_GRANT_READ_URI_PERMISSION
+          )
+        } catch (_: Exception) {}
+      }
+      preferences.edit().clear().apply()
+      promise.resolve(null)
+    }
+  }
+
+  @ReactMethod fun search(query: String, limit: Double, promise: Promise) {
+    val term = query.trim().take(180)
+    if (term.length < 2) {
+      promise.resolve(Arguments.createArray())
+      return
+    }
+    executor.execute {
+      try {
+        ensureLibrary()
+        val wanted = limit.toInt().coerceIn(1, 8)
+        val rows = Arguments.createArray()
+        var count = 0
+        for (entry in loadEntries().filter { File(it.path).isFile }) {
+          if (count >= wanted) break
+          val archive = Archive(entry.path)
+          try {
+            val searcher = Searcher(archive)
+            try {
+              val request = Query(term)
+              try {
+                val search = searcher.search(request)
+                try {
+                  val iterator = search.getResults(0, wanted - count)
+                  try {
+                    while (iterator.hasNext() && count < wanted) {
+                      val title = iterator.title ?: break
+                      val path = iterator.path ?: ""
+                      val snippet = Html.fromHtml(
+                        iterator.snippet ?: "", Html.FROM_HTML_MODE_COMPACT
+                      ).toString().replace(Regex("\\s+"), " ").trim().take(500)
+                      val excerpt = try {
+                        val item = archive.getEntryByPath(path).getItem(true)
+                        if (item.size in 1L..400_000L && item.mimetype.startsWith("text/html")) {
+                          val blob = item.data
+                          try {
+                            Html.fromHtml(
+                              blob.data.toString(Charsets.UTF_8), Html.FROM_HTML_MODE_COMPACT
+                            ).toString().replace(Regex("\\s+"), " ").trim().take(1800)
+                          } finally { blob.dispose() }
+                        } else snippet
+                      } catch (_: Exception) { snippet }
+                      rows.pushMap(Arguments.createMap().apply {
+                        putString("title", title)
+                        putString("path", path)
+                        putString("excerpt", excerpt.ifBlank { snippet })
+                        putString("archive", entry.name)
+                      })
+                      iterator.next()
+                      count++
+                    }
+                  } finally { iterator.dispose() }
+                } finally { search.dispose() }
+              } finally { request.dispose() }
+            } finally { searcher.dispose() }
+          } finally { archive.dispose() }
+        }
+        promise.resolve(rows)
+      } catch (error: Exception) {
+        promise.reject("ZIM_SEARCH", error.message, error)
+      }
+    }
+  }
+
+  private fun importArchive(uri: Uri, name: String): Entry {
+    ensureLibrary()
+    val root = context.getExternalFilesDir("zim") ?: File(context.filesDir, "zim")
+    check(root.isDirectory || root.mkdirs()) { "Неможливо створити каталог ZIM." }
+
+    val expected = querySize(uri)
+    if (expected > 0) {
+      val free = StatFs(root.absolutePath).availableBytes
+      require(expected + RESERVE_BYTES < free) {
+        "Недостатньо місця. Для імпорту потрібно приблизно " +
+          (expected / 1024 / 1024) + " MB плюс резерв."
+      }
+    }
+
+    val safe = name.map { ch ->
+      if (ch.isLetterOrDigit() || ch in "._- ()[]") ch else '_'
+    }.joinToString("").take(140).ifBlank { "archive.zim" }
+    val target = File(root, System.currentTimeMillis().toString() + "-" + safe)
+    var copied = 0L
+    try {
+      context.contentResolver.openInputStream(uri)?.use { input ->
+        target.outputStream().buffered(1024 * 1024).use { output ->
+          val buffer = ByteArray(1024 * 1024)
+          while (true) {
+            val n = input.read(buffer)
+            if (n < 0) break
+            output.write(buffer, 0, n)
+            copied += n
+          }
+        }
+      } ?: error("Неможливо прочитати вибраний ZIM.")
+      require(copied > 0) { "ZIM файл порожній." }
+      val archive = Archive(target.canonicalPath)
+      val articles = try { archive.articleCount } finally { archive.dispose() }
+      return Entry(name, target.canonicalPath, uri.toString(), articles, copied)
+    } catch (error: Exception) {
+      target.delete()
+      throw error
+    }
+  }
+
+  private fun info(entry: Entry) = Arguments.createMap().apply {
+    putBoolean("ready", true)
+    putString("name", entry.name)
+    putInt("articles", entry.articles)
+    putDouble("bytes", entry.bytes.toDouble())
+  }
+
+  private fun ensureLibrary() {
+    if (!libraryReady) synchronized(this) {
+      if (!libraryReady) {
+        JNIKiwix(context)
+        libraryReady = true
+      }
+    }
+  }
+
+  private fun loadEntries(): List<Entry> {
+    val raw = preferences.getString("archives", "[]") ?: "[]"
+    val arr = JSONArray(raw)
+    return (0 until arr.length()).mapNotNull { index ->
+      try {
+        val item = arr.getJSONObject(index)
+        Entry(
+          item.getString("name"),
+          item.getString("path"),
+          item.optString("sourceUri", ""),
+          item.optInt("articles", 0),
+          item.optLong("bytes", 0L)
+        )
+      } catch (_: Exception) { null }
+    }
+  }
+
+  private fun saveEntries(entries: List<Entry>) {
+    val arr = JSONArray()
+    entries.forEach { entry ->
+      arr.put(JSONObject().apply {
+        put("name", entry.name)
+        put("path", entry.path)
+        put("sourceUri", entry.sourceUri)
+        put("articles", entry.articles)
+        put("bytes", entry.bytes)
+      })
+    }
+    preferences.edit().putString("archives", arr.toString()).apply()
+  }
+
+  private fun displayName(uri: Uri): String =
+    context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
+      if (it.moveToFirst()) it.getString(0) else null
+    } ?: (uri.lastPathSegment ?: "archive.zim")
+
+  private fun querySize(uri: Uri): Long =
+    context.contentResolver.query(uri, arrayOf(OpenableColumns.SIZE), null, null, null)?.use {
+      if (it.moveToFirst() && !it.isNull(0)) it.getLong(0) else -1L
+    } ?: -1L
+
+  override fun invalidate() {
+    context.removeActivityEventListener(listener)
+    pending?.reject("ZIM_CLOSED", "Archive picker closed")
+    pending = null
+    executor.shutdown()
+    super.invalidate()
+  }
+
+  companion object {
+    private const val PICK_ZIM = 9254
+    private const val RESERVE_BYTES = 128L * 1024L * 1024L
+  }
+}
diff --git a/android/app/src/main/python/jarvis_documents.py b/android/app/src/main/python/jarvis_documents.py
