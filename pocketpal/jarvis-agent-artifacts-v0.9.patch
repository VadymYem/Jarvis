+"""Run bounded local Python and report changed workspace artifacts."""
+
+import contextlib
+import io
+import json
+import mimetypes
+import os
+import sys
+import time
+import traceback
+from pathlib import Path
+
+
+class _LimitedOutput(io.StringIO):
+    def write(self, value):
+        if self.tell() + len(value) > 16000:
+            raise ValueError("Python output exceeded 16,000 characters")
+        return super().write(value)
+
+
+def _snapshot(root):
+    result = {}
+    for path in root.rglob("*"):
+        if path.is_file():
+            try:
+                stat = path.stat()
+                result[str(path.relative_to(root))] = (stat.st_size, stat.st_mtime_ns)
+            except OSError:
+                pass
+    return result
+
+
+def _mime(path):
+    overrides = {
+        ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+        ".xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+        ".pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
+        ".md": "text/markdown",
+        ".py": "text/x-python",
+    }
+    return overrides.get(path.suffix.lower()) or mimetypes.guess_type(path.name)[0] or "application/octet-stream"
+
+
+def run(code, workspace):
+    root = Path(workspace).resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    before = _snapshot(root)
+    stdout, stderr = _LimitedOutput(), _LimitedOutput()
+    old_cwd, old_argv, old_trace = os.getcwd(), sys.argv, sys.gettrace()
+    deadline = time.monotonic() + 45
+
+    def trace(frame, event, arg):
+        if time.monotonic() > deadline:
+            raise TimeoutError("Python exceeded 45 seconds")
+        return trace
+
+    error = None
+    try:
+        os.chdir(root)
+        sys.argv = ["jarvis_script.py"]
+        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            sys.settrace(trace)
+            try:
+                exec(compile(code, "<jarvis_script>", "exec"), {"__name__": "__main__"})
+            finally:
+                sys.settrace(old_trace)
+    except BaseException as exc:
+        error = "".join(traceback.format_exception_only(type(exc), exc)).strip()[:1200]
+    finally:
+        sys.settrace(old_trace)
+        sys.argv = old_argv
+        os.chdir(old_cwd)
+
+    after = _snapshot(root)
+    changed = [name for name, signature in after.items() if before.get(name) != signature][:40]
+    artifacts = []
+    for name in changed:
+        path = (root / name).resolve()
+        try:
+            size = path.stat().st_size
+            mime = _mime(path)
+            artifacts.append({
+                "name": path.name,
+                "path": name,
+                "uri": path.as_uri(),
+                "mime": mime,
+                "size": size,
+                "image": mime.startswith("image/"),
+            })
+        except OSError:
+            pass
+
+    return json.dumps(
+        {
+            "stdout": stdout.getvalue(),
+            "stderr": stderr.getvalue(),
+            "error": error,
+            "created": changed,
+            "artifacts": artifacts,
+        },
+        ensure_ascii=False,
+    )
