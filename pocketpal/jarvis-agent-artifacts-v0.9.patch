+++ b/android/app/src/main/python/jarvis_documents.py
@@ -0,0 +1,181 @@
+"""Local document text extraction for Jarvis.
+
+No file is uploaded. Parsers are intentionally bounded and return plain text for
+model context, while the original document stays under Android's SAF control.
+"""
+
+from html.parser import HTMLParser
+from pathlib import Path
+import re
+import zipfile
+import xml.etree.ElementTree as ET
+
+MAX_CHARS = 120_000
+
+
+class _HTMLText(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.parts = []
+
+    def handle_data(self, data):
+        value = data.strip()
+        if value:
+            self.parts.append(value)
+
+
+def _clean(text):
+    return re.sub(r"\s+", " ", text or "").strip()[:MAX_CHARS]
+
+
+def _decode(data):
+    for encoding in ("utf-8-sig", "utf-16", "utf-16-le", "cp1251", "latin-1"):
+        try:
+            text = data.decode(encoding)
+            if "\x00" not in text[:2000]:
+                return text
+        except Exception:
+            pass
+    return data.decode("utf-8", errors="replace")
+
+
+def _xml_text(data):
+    root = ET.fromstring(data)
+    return _clean(" ".join(part for part in root.itertext() if part and part.strip()))
+
+
+def _zip_xml(path, members):
+    parts = []
+    with zipfile.ZipFile(path) as archive:
+        names = archive.namelist()
+        selected = []
+        for matcher in members:
+            if matcher.endswith("*"):
+                prefix = matcher[:-1]
+                selected.extend(sorted(name for name in names if name.startswith(prefix) and name.endswith(".xml")))
+            elif matcher in names:
+                selected.append(matcher)
+        for name in selected:
+            try:
+                text = _xml_text(archive.read(name))
+                if text:
+                    parts.append(text)
+            except Exception:
+                continue
+            if sum(map(len, parts)) >= MAX_CHARS:
+                break
+    return _clean("\n\n".join(parts))
+
+
+def _xlsx(path):
+    rows = []
+    with zipfile.ZipFile(path) as archive:
+        names = archive.namelist()
+        shared = []
+        if "xl/sharedStrings.xml" in names:
+            try:
+                root = ET.fromstring(archive.read("xl/sharedStrings.xml"))
+                shared = ["".join(node.itertext()).strip() for node in root]
+            except Exception:
+                shared = []
+        for name in sorted(n for n in names if n.startswith("xl/worksheets/sheet") and n.endswith(".xml")):
+            try:
+                root = ET.fromstring(archive.read(name))
+                values = []
+                for cell in root.iter():
+                    if not cell.tag.endswith("}c"):
+                        continue
+                    cell_type = cell.attrib.get("t")
+                    value = next((child.text for child in cell if child.tag.endswith("}v")), None)
+                    if value is None:
+                        inline = "".join(child_text for child in cell for child_text in child.itertext())
+                        value = inline.strip()
+                    if value and cell_type == "s" and value.isdigit():
+                        idx = int(value)
+                        if 0 <= idx < len(shared):
+                            value = shared[idx]
+                    if value:
+                        values.append(value)
+                if values:
+                    rows.append(" | ".join(values))
+            except Exception:
+                continue
+            if sum(map(len, rows)) >= MAX_CHARS:
+                break
+    return _clean("\n".join(rows))
+
+
+def _legacy_doc(data):
+    # Old binary .doc is not XML. Extract plausible UTF-16LE and 8-bit text
+    # runs without pretending this is a full Word binary parser.
+    candidates = []
+    for match in re.finditer(rb"(?:[\x20-\x7e\x80-\xff]\x00){4,}", data):
+        try:
+            candidates.append(match.group(0).decode("utf-16-le"))
+        except Exception:
+            pass
+    for match in re.finditer(rb"[\x20-\x7e\x80-\xff]{8,}", data):
+        raw = match.group(0)
+        try:
+            candidates.append(raw.decode("cp1251"))
+        except Exception:
+            pass
+    return _clean("\n".join(candidates))
+
+
+def extract(path, name="", mime=""):
+    file = Path(path)
+    if not file.is_file():
+        raise FileNotFoundError(str(file))
+    ext = (Path(name).suffix or file.suffix).lower()
+    mime = (mime or "").lower()
+
+    if ext == ".pdf" or mime == "application/pdf":
+        from pypdf import PdfReader
+        reader = PdfReader(str(file))
+        parts = []
+        for page in reader.pages[:300]:
+            try:
+                parts.append(page.extract_text() or "")
+            except Exception:
+                continue
+            if sum(map(len, parts)) >= MAX_CHARS:
+                break
+        return _clean("\n\n".join(parts))
+
+    if ext == ".docx":
+        return _zip_xml(file, ["word/document.xml", "word/header*", "word/footer*"])
+
+    if ext == ".odt":
+        return _zip_xml(file, ["content.xml"])
+
+    if ext == ".pptx":
+        return _zip_xml(file, ["ppt/slides/slide*"])
+
+    if ext == ".xlsx":
+        return _xlsx(file)
+
+    data = file.read_bytes()
+
+    if ext == ".doc":
+        text = _legacy_doc(data)
+        if text:
+            return text
+
+    if ext in {".html", ".htm"} or "html" in mime:
+        parser = _HTMLText()
+        parser.feed(_decode(data))
+        return _clean("\n".join(parser.parts))
+
+    if ext == ".rtf":
+        text = _decode(data)
+        text = re.sub(r"\\'[0-9a-fA-F]{2}", " ", text)
+        text = re.sub(r"\\[a-zA-Z]+-?\d* ?", " ", text)
+        return _clean(text.replace("{", " ").replace("}", " "))
+
+    text = _decode(data)
+    printable = sum(ch.isprintable() or ch in "\r\n\t" for ch in text[:10000])
+    sample = max(1, min(len(text), 10000))
+    if printable / sample < 0.72:
+        raise ValueError("Unsupported binary format: " + (ext or mime or "unknown"))
+    return _clean(text)
