+import React from 'react';
+import {Alert, Linking, PermissionsAndroid, Platform, View} from 'react-native';
+import {observer} from 'mobx-react';
+import {Button, Card, Text} from 'react-native-paper';
+import {PalSheet} from '../../components/PalsSheets';
+import {palStore} from '../../store';
+import {androidDocuments} from '../../agent/native/AndroidDocuments';
+import {shizuku} from '../../agent/native/Shizuku';
+
+/** Model, prompt and tools use the same persisted Pal editor as Pals. */
+export const AgentSettingsCard = observer(() => {
+  const [visible, setVisible] = React.useState(false);
+  const [microphone, setMicrophone] = React.useState(false);
+  const [camera, setCamera] = React.useState(false);
+  const [fileCount, setFileCount] = React.useState(0);
+  const [shizukuState, setShizukuState] = React.useState('not_running');
+  const [message, setMessage] = React.useState('');
+  const [jarvisId, setJarvisId] = React.useState<string | null>(null);
+  const jarvis = palStore.pals.find(p => p.id === jarvisId);
+
+  const refresh = React.useCallback(async () => {
+    if (Platform.OS !== 'android') return;
+    const [mic, cam, grants, state] = await Promise.all([
+      PermissionsAndroid.check(PermissionsAndroid.PERMISSIONS.RECORD_AUDIO),
+      PermissionsAndroid.check(PermissionsAndroid.PERMISSIONS.CAMERA),
+      androidDocuments.listGrants(),
+      shizuku.getStatus(),
+    ]);
+    setMicrophone(mic);
+    setCamera(cam);
+    setFileCount(grants.length);
+    setShizukuState(state);
+  }, []);
+
+  React.useEffect(() => { refresh().catch(error => setMessage(String(error))); }, [refresh]);
+
+  const openEditor = async () => {
+    try { const profile = await palStore.ensureJarvisPal(); setJarvisId(profile.id); setVisible(true); }
+    catch (error) { Alert.alert('Jarvis', String(error)); }
+  };
+
+  const request = async (permission: string) => {
+    const result = await PermissionsAndroid.request(permission as Parameters<typeof PermissionsAndroid.request>[0]);
+    if (result === PermissionsAndroid.RESULTS.NEVER_ASK_AGAIN) Linking.openSettings();
+    refresh().catch(error => setMessage(String(error)));
+  };
+
+  const revokeFiles = () => Alert.alert('Відкликати доступ до файлів?', 'Jarvis більше не зможе повторно відкривати вибрані документи без системного вибору.', [
+    {text: 'Скасувати', style: 'cancel'},
+    {text: 'Відкликати', onPress: () => androidDocuments.revokeGrants().then(() => refresh()).catch(error => setMessage(String(error)))},
+  ]);
+
+  return <>
+    <Card elevation={0} testID="agent-settings-card">
+      <Card.Title title="Jarvis · агент і дозволи" />
+      <Card.Content style={{gap: 10, paddingBottom: 16}}>
+        <Text variant="bodySmall">Модель, інструкції та набір інструментів агента можна змінити в його профілі.</Text>
+        <Button mode="contained-tonal" onPress={openEditor} testID="agent-profile-settings">Налаштувати агента</Button>
+        {Platform.OS === 'android' && <>
+          <Text variant="titleSmall">Дозволи Android</Text>
+          <View style={{flexDirection: 'row', flexWrap: 'wrap', gap: 8}}>
+            <Button mode="outlined" onPress={() => microphone ? Linking.openSettings() : request(PermissionsAndroid.PERMISSIONS.RECORD_AUDIO)}>
+              Мікрофон: {microphone ? 'надано' : 'надати'}
+            </Button>
+            <Button mode="outlined" onPress={() => camera ? Linking.openSettings() : request(PermissionsAndroid.PERMISSIONS.CAMERA)}>
+              Ліхтарик: {camera ? 'надано' : 'надати'}
+            </Button>
+          </View>
+          <Text variant="bodySmall">Доступ до файлів: {fileCount} вибраних документів. Новий файл обирається в системному вікні Android.</Text>
+          <View style={{flexDirection: 'row', flexWrap: 'wrap', gap: 8}}>
+            <Button mode="outlined" onPress={() => androidDocuments.openText().then(() => refresh()).catch(error => setMessage(String(error)))}>Обрати файл</Button>
+            {fileCount > 0 && <Button mode="text" onPress={revokeFiles}>Відкликати файли</Button>}
+          </View>
+          <Text variant="bodySmall">Shizuku: {shizukuState}. Дозвіл керується також у застосунку Shizuku.</Text>
+          <Button mode="outlined" onPress={() => shizuku.requestAccess().then(result => {setMessage(result); refresh();}).catch(error => setMessage(String(error)))}>Перевірити / надати Shizuku</Button>
+          <Button mode="text" onPress={() => Linking.openSettings()}>Системні дозволи застосунку</Button>
+        </>}
+        <Text variant="bodySmall">Мережевий пошук і відкликання згоди — у розділі «Internet Search» нижче. Запис файлів та зміни системи запитують підтвердження перед виконанням.</Text>
+        {!!message && <Text variant="bodySmall" selectable>{message}</Text>}
+      </Card.Content>
+    </Card>
+    {visible && jarvis && <PalSheet isVisible={visible} onClose={() => setVisible(false)} pal={jarvis} />}
+  </>;
+});
