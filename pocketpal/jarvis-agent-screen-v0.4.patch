+++ b/src/agent/native/Shizuku.ts
@@ -0,0 +1,14 @@
+import {NativeModules, Platform} from 'react-native';
+
+type Operation = 'list_disabled' | 'disable' | 'enable' | 'animation_get' | 'animation_set';
+type Module = {requestAccess(): Promise<string>; getStatus(): Promise<string>; execute(operation: Operation, argument: string): Promise<string>};
+const module = NativeModules.JarvisShizukuModule as Module | undefined;
+const requireModule = (): Module => {
+  if (Platform.OS !== 'android' || !module) throw new Error('Shizuku unavailable on this device');
+  return module;
+};
+export const shizuku: Module = {
+  requestAccess: () => requireModule().requestAccess(),
+  getStatus: () => requireModule().getStatus(),
+  execute: (operation, argument) => requireModule().execute(operation, argument),
+};
