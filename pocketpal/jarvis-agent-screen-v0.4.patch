+import React from 'react';
+import {ActivityIndicator, View} from 'react-native';
+import {Button, Text} from 'react-native-paper';
+import {useFocusEffect} from '@react-navigation/native';
+import {chatSessionStore, palStore} from '../../store';
+import {ChatScreen} from '../ChatScreen';
+
+const TITLE = 'Jarvis · Agent';
+
+/** Own drawer route and conversation; returning to Chat restores its session. */
+export const AgentScreen: React.FC = () => {
+  const [state, setState] = React.useState<'loading' | 'ready' | 'error'>('loading');
+  const [error, setError] = React.useState('');
+  const previous = React.useRef<string | null>(null);
+  const previousPal = React.useRef<string | undefined>(undefined);
+  const generation = React.useRef(0);
+
+  const prepare = React.useCallback(async (token: number) => {
+    setState('loading');
+    try {
+      const jarvis = await palStore.ensureJarvisPal();
+      await chatSessionStore.ensureReady();
+      if (generation.current !== token) return;
+      const existing = chatSessionStore.sessions.find(
+        session => session.title === TITLE && session.activePalId === jarvis.id,
+      );
+      if (existing) {
+        await chatSessionStore.setActiveSession(existing.id);
+      } else {
+        chatSessionStore.resetActiveSession();
+        await chatSessionStore.setActivePal(jarvis.id);
+        await chatSessionStore.createNewSession(TITLE);
+      }
+      if (!chatSessionStore.activeSessionId) throw new Error('Не вдалося створити розмову Jarvis. Перевірте локальну базу.');
+      if (generation.current === token) setState('ready');
+    } catch (cause) {
+      if (generation.current !== token) return;
+      setError(cause instanceof Error ? cause.message : String(cause));
+      setState('error');
+    }
+  }, []);
+
+  useFocusEffect(React.useCallback(() => {
+    previous.current = chatSessionStore.activeSessionId;
+    previousPal.current = chatSessionStore.activePalId;
+    const token = ++generation.current;
+    prepare(token);
+    return () => {
+      ++generation.current;
+      if (previous.current) {
+        chatSessionStore.setActiveSession(previous.current).catch(() => {});
+      } else {
+        chatSessionStore.resetActiveSession();
+        chatSessionStore.setActivePal(previousPal.current).catch(() => {});
+      }
+    };
+  }, [prepare]));
+
+  if (state === 'ready') return <ChatScreen agentMode />;
+  return (
+    <View style={{flex: 1, alignItems: 'center', justifyContent: 'center', padding: 24, gap: 16}}>
+      {state === 'loading' ? <ActivityIndicator /> : <Text>{error}</Text>}
+      {state === 'error' && <Button mode="contained" onPress={() => prepare(++generation.current)}>Спробувати знову</Button>}
+      <Text>Jarvis · Agent</Text>
+    </View>
+  );
+};
