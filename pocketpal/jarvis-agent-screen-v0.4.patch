+++ b/android/app/src/main/java/top/authorche/agent/shizuku/JarvisPrivilegedService.kt
@@ -0,0 +1,45 @@
+package top.authorche.agent.shizuku
+
+import android.content.Context
+import java.util.concurrent.TimeUnit
+
+/** Validate in the privileged process too: no arbitrary shell strings cross this boundary. */
+class JarvisPrivilegedService() : IJarvisService.Stub() {
+  @Suppress("UNUSED_PARAMETER") constructor(context: Context) : this()
+
+  override fun execute(operation: String, argument: String): String {
+    val command = when (operation) {
+      "list_disabled" -> listOf("/system/bin/pm", "list", "packages", "-d")
+      "disable", "enable" -> {
+        require(PACKAGE.matches(argument)) { "Invalid package name" }
+        require(argument !in PROTECTED && !argument.startsWith("com.android.")) { "System package protected" }
+        if (operation == "disable") listOf("/system/bin/pm", "disable-user", "--user", "0", argument)
+        else listOf("/system/bin/pm", "enable", argument)
+      }
+      "animation_get" -> listOf("/system/bin/settings", "get", "global", "window_animation_scale")
+      "animation_set" -> {
+        require(argument in setOf("0", "0.5", "1")) { "Unsupported animation scale" }
+        listOf("/system/bin/settings", "put", "global", "window_animation_scale", argument)
+      }
+      else -> error("Unsupported system operation")
+    }
+    val process = ProcessBuilder(command).redirectErrorStream(true).start()
+    if (!process.waitFor(15, TimeUnit.SECONDS)) {
+      process.destroyForcibly()
+      error("System operation timed out")
+    }
+    val output = process.inputStream.bufferedReader().use { it.readText().take(16000) }
+    check(process.exitValue() == 0) { "Exit ${process.exitValue()}: $output" }
+    return output.ifBlank { "OK" }
+  }
+
+  companion object {
+    private val PACKAGE = Regex("^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)+$")
+    private val PROTECTED = setOf(
+      "android", "com.google.android.gms", "com.google.android.gsf",
+      "com.android.systemui", "com.android.settings", "com.android.permissioncontroller",
+      "com.android.packageinstaller", "com.google.android.packageinstaller",
+      "com.android.vending", "moe.shizuku.privileged.api", "top.authorche.agent"
+    )
+  }
+}
