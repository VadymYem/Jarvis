+++ b/src/agent/talents/ShizukuEngine.ts
@@ -0,0 +1,47 @@
+import {Alert} from 'react-native';
+import type {TalentEngine, TalentResult, ToolDefinition} from '../../services/talents/types';
+import {shizuku} from '../native/Shizuku';
+
+const PACKAGE = /^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)+$/;
+const confirm = (detail: string): Promise<boolean> => new Promise(resolve => {
+  Alert.alert('Системна дія через Shizuku', detail, [
+    {text: 'Скасувати', style: 'cancel', onPress: () => resolve(false)},
+    {text: 'Виконати', onPress: () => resolve(true)},
+  ], {cancelable: false});
+});
+
+export class ShizukuEngine implements TalentEngine {
+  readonly name = 'shizuku_system';
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    try {
+      const operation = String(args.operation ?? '');
+      if (operation === 'status') return {type: 'text', summary: await shizuku.requestAccess()};
+      if (!['list_disabled', 'disable', 'enable', 'animation_get', 'animation_set'].includes(operation)) {
+        throw new Error('Unsupported Shizuku operation');
+      }
+      const argument = String(args.argument ?? '');
+      if (['disable', 'enable'].includes(operation) && !PACKAGE.test(argument)) throw new Error('Invalid app package');
+      if (operation === 'animation_set' && !['0', '0.5', '1'].includes(argument)) throw new Error('Choose 0, 0.5 or 1');
+      if (['disable', 'enable', 'animation_set'].includes(operation)) {
+        const detail = operation === 'disable'
+          ? `Вимкнути ${argument} для користувача 0? Застосунок може припинити працювати. Його можна знову ввімкнути.`
+          : operation === 'enable' ? `Увімкнути ${argument}?` : `Змінити масштаб анімації вікон на ${argument}?`;
+        if (!(await confirm(detail))) return {type: 'text', summary: 'User declined system change.'};
+      }
+      return {type: 'text', summary: await shizuku.execute(operation as 'list_disabled', argument)};
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return {type: 'error', summary: message, errorMessage: message};
+    }
+  }
+  toToolDefinition(): ToolDefinition {
+    return {type: 'function', function: {
+      name: this.name,
+      description: 'Limited Android shell operations through Shizuku. Disable or enable a non-system package for user 0 (reversible debloat), list disabled packages, read or set window animation scale. Every change requires user confirmation. Shizuku must be installed, running and authorized.',
+      parameters: {type: 'object', additionalProperties: false, required: ['operation'], properties: {
+        operation: {type: 'string', enum: ['status', 'list_disabled', 'disable', 'enable', 'animation_get', 'animation_set']},
+        argument: {type: 'string', description: 'Package name or animation value (0, 0.5, 1)'},
+      }},
+    }};
+  }
+}
