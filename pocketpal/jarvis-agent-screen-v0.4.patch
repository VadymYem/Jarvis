@@ -0,0 +1,128 @@
+import React from 'react';
+import {Alert, Linking, StyleSheet, View} from 'react-native';
+import {observer} from 'mobx-react';
+import {Button, Card, Chip, Text, TextInput, useTheme} from 'react-native-paper';
+import {createSearchProvider, type SearchHit} from '../../services/search';
+import {searchProviderStore} from '../../store/SearchProviderStore';
+import {androidDocuments} from '../../agent/native/AndroidDocuments';
+import {shizuku} from '../../agent/native/Shizuku';
+
+const styles = StyleSheet.create({
+  root: {paddingHorizontal: 16, paddingTop: 12, paddingBottom: 6, gap: 10},
+  card: {borderRadius: 20},
+  content: {gap: 10},
+  row: {flexDirection: 'row', flexWrap: 'wrap', gap: 8, alignItems: 'center'},
+  result: {paddingVertical: 8, gap: 3},
+});
+
+/** Visible, testable actions independent of the language model tool loop. */
+export const AgentDashboard = observer(({children}: {children: React.ReactNode}) => {
+  const theme = useTheme();
+  const [expanded, setExpanded] = React.useState(false);
+  const [query, setQuery] = React.useState('');
+  const [hits, setHits] = React.useState<SearchHit[]>([]);
+  const [busy, setBusy] = React.useState(false);
+  const [status, setStatus] = React.useState('');
+  const [shizukuStatus, setShizukuStatus] = React.useState('');
+  const [packageName, setPackageName] = React.useState('');
+  const provider = searchProviderStore.activeProviderId;
+
+  const search = async () => {
+    if (!query.trim() || !searchProviderStore.canSearch) return;
+    setBusy(true);
+    setStatus('');
+    setHits([]);
+    try {
+      const adapter = createSearchProvider(provider, () => searchProviderStore.getKey(provider));
+      const results = await adapter.search(query.trim(), {maxResults: searchProviderStore.resultCount});
+      setHits(results);
+      if (!results.length) setStatus('Результатів не знайдено. Спробуйте інший запит.');
+    } catch (error) {
+      setStatus(error instanceof Error ? error.message : String(error));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const openDocument = async () => {
+    try {
+      const file = await androidDocuments.openText();
+      if (file) setStatus(`Відкрито: ${file.name}\n${file.text.slice(0, 3000)}`);
+    } catch (error) {
+      Alert.alert('Файли Android', String(error));
+    }
+  };
+
+  const connectShizuku = async () => {
+    try {
+      setShizukuStatus(await shizuku.requestAccess());
+    } catch (error) {
+      setShizukuStatus(String(error));
+    }
+  };
+
+  const systemAction = (operation: 'disable' | 'enable' | 'animation_set', argument: string) => {
+    const detail = operation === 'disable'
+      ? `Вимкнути ${argument} для користувача 0? Це може вплинути на роботу системи. Дію можна скасувати кнопкою «Увімкнути».`
+      : operation === 'enable' ? `Увімкнути ${argument}?` : `Встановити масштаб анімації вікон ${argument}?`;
+    Alert.alert('Дія через Shizuku', detail, [
+      {text: 'Скасувати', style: 'cancel'},
+      {text: 'Виконати', onPress: () => shizuku.execute(operation, argument)
+        .then(setShizukuStatus).catch(error => setShizukuStatus(String(error)))},
+    ]);
+  };
+
+  return (
+    <View style={styles.root}>
+      <Card style={styles.card} mode="contained">
+        <Card.Content style={styles.content}>
+          <Text variant="titleMedium" style={{fontWeight: '700'}}>✦  Jarvis · Agent</Text>
+          <Text variant="bodySmall">Модель і інструменти Android в окремій розмові</Text>
+          <View style={styles.row}>
+            <Button mode="contained-tonal" compact onPress={() => setExpanded(!expanded)} testID="agent-tools-toggle">
+              {expanded ? 'Сховати інструменти' : 'Інструменти'}
+            </Button>
+            {children}
+          </View>
+        </Card.Content>
+      </Card>
+      {expanded && <Card style={styles.card} mode="outlined"><Card.Content style={styles.content}>
+        <Text variant="titleSmall">Пошук</Text>
+        <View style={styles.row}>
+          <Chip selected={provider === 'device_web'} onPress={() => searchProviderStore.setActiveProvider('device_web')}>Веб</Chip>
+          <Chip selected={provider === 'wikipedia'} onPress={() => searchProviderStore.setActiveProvider('wikipedia')}>Вікіпедія</Chip>
+        </View>
+        {!searchProviderStore.hasConsentedToSearch && <Button mode="outlined" onPress={() => searchProviderStore.setConsent(true)}>
+          Дозволити надсилати запити до пошукового сервісу
+        </Button>}
+        {searchProviderStore.hasConsentedToSearch && <>
+          <TextInput mode="outlined" dense label="Пошуковий запит" value={query} onChangeText={setQuery} onSubmitEditing={search} testID="agent-search-input" />
+          <Button mode="contained" disabled={!query.trim() || busy} loading={busy} onPress={search} testID="agent-search-button">Шукати</Button>
+        </>}
+        {hits.map(hit => <View key={hit.url} style={styles.result}>
+          <Text variant="titleSmall" onPress={() => Linking.openURL(hit.url)} style={{color: theme.colors.primary}}>{hit.title}</Text>
+          <Text variant="bodySmall">{hit.snippet}</Text>
+        </View>)}
+        <Text variant="titleSmall">Пристрій</Text>
+        <View style={styles.row}>
+          <Button compact mode="outlined" onPress={openDocument}>Відкрити файл</Button>
+          <Button compact mode="outlined" onPress={connectShizuku}>Shizuku</Button>
+        </View>
+        <Text variant="bodySmall">Файл відкривається через системний вибір. Доступ маємо лише до вибраних документів.</Text>
+        <TextInput mode="outlined" dense label="Пакет застосунку (наприклад, com.example.app)" value={packageName} onChangeText={setPackageName} autoCapitalize="none" />
+        <View style={styles.row}>
+          <Button compact mode="outlined" disabled={!/^[a-zA-Z][\w]*(\.[a-zA-Z0-9_]+)+$/.test(packageName)} onPress={() => systemAction('disable', packageName)}>Вимкнути</Button>
+          <Button compact mode="outlined" disabled={!/^[a-zA-Z][\w]*(\.[a-zA-Z0-9_]+)+$/.test(packageName)} onPress={() => systemAction('enable', packageName)}>Увімкнути</Button>
+          <Button compact mode="text" onPress={() => shizuku.execute('list_disabled', '').then(setShizukuStatus).catch(error => setShizukuStatus(String(error)))}>Вимкнені пакети</Button>
+        </View>
+        <View style={styles.row}>
+          <Button compact mode="text" onPress={() => shizuku.execute('animation_get', '').then(setShizukuStatus).catch(error => setShizukuStatus(String(error)))}>Анімація</Button>
+          <Button compact mode="text" onPress={() => systemAction('animation_set', '0.5')}>Анімація 0.5×</Button>
+          <Button compact mode="text" onPress={() => systemAction('animation_set', '1')}>Анімація 1×</Button>
+        </View>
+        {!!shizukuStatus && <Text variant="bodySmall">{shizukuStatus}</Text>}
+        {!!status && <Text variant="bodySmall" selectable>{status}</Text>}
+      </Card.Content></Card>}
+    </View>
+  );
+});
