@@ -0,0 +1,34 @@
+import React from 'react';
+import {Alert, Linking} from 'react-native';
+import {Button, Card, Text} from 'react-native-paper';
+import {offlineZim, type ArchiveStatus} from '../../knowledge/offlineZim';
+
+export const OfflineKnowledgeCard: React.FC = () => {
+  const [archive, setArchive] = React.useState<ArchiveStatus>({ready: false, name: null});
+  const [message, setMessage] = React.useState('');
+  const refresh = React.useCallback(() => offlineZim.status().then(setArchive).catch(error => setMessage(String(error))), []);
+  React.useEffect(() => { refresh(); }, [refresh]);
+
+  const choose = async () => {
+    try {
+      const result = await offlineZim.chooseArchive();
+      if (result) { setArchive(result); setMessage(`Архів підключено: ${result.articles ?? '?'} статей.`); }
+    } catch (error) { setMessage(String(error)); }
+  };
+  const forget = () => Alert.alert('Відключити архів?', 'Файл ZIM залишиться на телефоні.', [
+    {text: 'Скасувати', style: 'cancel'},
+    {text: 'Відключити', onPress: () => offlineZim.forgetArchive().then(refresh).catch(error => setMessage(String(error)))},
+  ]);
+
+  return <Card elevation={0} testID="offline-knowledge-card">
+    <Card.Title title="Офлайн-бібліотека" />
+    <Card.Content style={{gap: 8, paddingBottom: 16}}>
+      <Text variant="bodyMedium">{archive.ready ? `Підключено: ${archive.name}` : 'Підключіть архів Wikipedia у форматі ZIM. Після цього Jarvis шукатиме в ньому автоматично без інтернету.'}</Text>
+      <Text variant="bodySmall">Архів зберігається у вибраному вами місці. Для української мови можна взяти Wikipedia mini (менший файл) або nopic (більше тексту). Розмір залежить від архіву.</Text>
+      <Button mode="contained-tonal" onPress={choose}>Обрати файл ZIM</Button>
+      <Button mode="text" onPress={() => Linking.openURL('https://library.kiwix.org/#lang=uk')}>Відкрити каталог Kiwix</Button>
+      {archive.ready && <Button mode="text" onPress={forget}>Відключити архів</Button>}
+      {!!message && <Text variant="bodySmall" selectable>{message}</Text>}
+    </Card.Content>
+  </Card>;
+};
