index 0000000..91dbc78
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/OfflineZimModule.kt
@@ -0,0 +1,164 @@
+package top.authorche.agent
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import android.provider.OpenableColumns
+import android.text.Html
+import com.facebook.react.bridge.ActivityEventListener
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.BaseActivityEventListener
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import org.kiwix.libkiwix.JNIKiwix
+import org.kiwix.libzim.Archive
+import org.kiwix.libzim.Query
+import org.kiwix.libzim.Searcher
+import java.util.concurrent.Executors
+
+/** Searches an explicitly selected, persisted ZIM archive without uploading it. */
+class OfflineZimModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private val preferences = context.getSharedPreferences("jarvis_offline_zim", 0)
+  private val executor = Executors.newSingleThreadExecutor()
+  private var pending: Promise? = null
+  @Volatile private var libraryReady = false
+
+  private val listener: ActivityEventListener = object : BaseActivityEventListener() {
+    override fun onActivityResult(activity: Activity, requestCode: Int, resultCode: Int, data: Intent?) {
+      if (requestCode != PICK_ZIM) return
+      val promise = pending ?: return
+      pending = null
+      if (resultCode != Activity.RESULT_OK || data?.data == null) { promise.resolve(null); return }
+      val uri = data.data!!
+      executor.execute {
+        try {
+          val name = displayName(uri)
+          require(name.endsWith(".zim", ignoreCase = true)) { "Виберіть файл .zim із бібліотеки Kiwix." }
+          context.contentResolver.takePersistableUriPermission(uri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
+          val info = inspect(uri)
+          val old = preferences.getString("uri", null)
+          preferences.edit().putString("uri", uri.toString()).putString("name", name).apply()
+          if (old != null && old != uri.toString()) release(Uri.parse(old))
+          promise.resolve(info)
+        } catch (error: Exception) { promise.reject("ZIM_IMPORT", error.message, error) }
+      }
+    }
+  }
+
+  init { context.addActivityEventListener(listener) }
+  override fun getName() = "OfflineZimModule"
+
+  @ReactMethod fun chooseArchive(promise: Promise) {
+    if (pending != null) { promise.reject("ZIM_PICKER_BUSY", "Вибір архіву вже відкрито"); return }
+    val activity = context.currentActivity ?: run { promise.reject("ZIM_NO_ACTIVITY", "Відкрийте Jarvis перед вибором архіву"); return }
+    pending = promise
+    try {
+      val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+        addCategory(Intent.CATEGORY_OPENABLE)
+        type = "*/*"
+        addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION)
+      }
+      activity.startActivityForResult(intent, PICK_ZIM)
+    } catch (error: Exception) { pending = null; promise.reject("ZIM_PICKER", error.message, error) }
+  }
+
+  @ReactMethod fun status(promise: Promise) {
+    val uri = preferences.getString("uri", null)
+    promise.resolve(Arguments.createMap().apply {
+      putBoolean("ready", uri != null && context.contentResolver.persistedUriPermissions.any { it.uri.toString() == uri && it.isReadPermission })
+      putString("name", preferences.getString("name", null))
+    })
+  }
+
+  @ReactMethod fun forgetArchive(promise: Promise) {
+    val old = preferences.getString("uri", null)
+    preferences.edit().clear().apply()
+    if (old != null) release(Uri.parse(old))
+    promise.resolve(null)
+  }
+
+  @ReactMethod fun search(query: String, limit: Double, promise: Promise) {
+    val uriText = preferences.getString("uri", null)
+    if (uriText == null) { promise.resolve(Arguments.createArray()); return }
+    executor.execute {
+      try {
+        val uri = Uri.parse(uriText)
+        require(context.contentResolver.persistedUriPermissions.any { it.uri == uri && it.isReadPermission }) { "Доступ до ZIM відкликано. Оберіть файл знову." }
+        val rows = Arguments.createArray()
+        withArchive(uri) { archive ->
+          val searcher = Searcher(archive)
+          val request = Query(query.trim().take(180))
+          val search = searcher.search(request)
+          val iterator = search.getResults(0, limit.toInt().coerceIn(1, 5))
+          try {
+            var count = 0
+            while (iterator.hasNext() && count < limit.toInt().coerceIn(1, 5)) {
+              val title = iterator.title ?: break
+              val path = iterator.path ?: ""
+              val snippet = Html.fromHtml(iterator.snippet ?: "", Html.FROM_HTML_MODE_COMPACT).toString().trim().take(450)
+              val excerpt = try {
+                val item = archive.getEntryByPath(path).getItem(true)
+                if (item.size in 1L..250_000L && item.mimetype.startsWith("text/html")) {
+                  Html.fromHtml(item.data.data.toString(Charsets.UTF_8), Html.FROM_HTML_MODE_COMPACT)
+                    .toString().replace(Regex("\\s+"), " ").trim().take(1500)
+                } else snippet
+              } catch (_: Exception) { snippet }
+              rows.pushMap(Arguments.createMap().apply {
+                putString("title", title)
+                putString("path", path)
+                putString("excerpt", excerpt.ifBlank { snippet })
+                putString("archive", preferences.getString("name", "ZIM"))
+              })
+              iterator.next()
+              count++
+            }
+          } finally {
+            iterator.dispose()
+            search.dispose()
+            request.dispose()
+            searcher.dispose()
+          }
+        }
+        promise.resolve(rows)
+      } catch (error: Exception) { promise.reject("ZIM_SEARCH", error.message, error) }
+    }
+  }
+
+  private fun inspect(uri: Uri): com.facebook.react.bridge.WritableMap = withArchive(uri) { archive ->
+    Arguments.createMap().apply {
+      putBoolean("ready", true)
+      putString("name", displayName(uri))
+      putInt("articles", archive.articleCount)
+    }
+  }
+
+  private fun <T> withArchive(uri: Uri, block: (Archive) -> T): T {
+    if (!libraryReady) synchronized(this) {
+      if (!libraryReady) { JNIKiwix(context); libraryReady = true }
+    }
+    val descriptor = context.contentResolver.openFileDescriptor(uri, "r")
+      ?: error("Неможливо відкрити ZIM. Перемістіть архів у пам’ять телефону.")
+    return descriptor.use {
+      val archive = Archive(it.fileDescriptor)
+      try { block(archive) } finally { archive.dispose() }
+    }
+  }
+
+  private fun displayName(uri: Uri): String = context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
+    if (it.moveToFirst()) it.getString(0) else null
+  } ?: (uri.lastPathSegment ?: "archive.zim")
+
+  private fun release(uri: Uri) {
+    try { context.contentResolver.releasePersistableUriPermission(uri, Intent.FLAG_GRANT_READ_URI_PERMISSION) }
+    catch (_: Exception) { /* The grant may already have been revoked in Android settings. */ }
+  }
+
+  override fun invalidate() {
+    executor.shutdown()
+    super.invalidate()
+  }
+
+  companion object { private const val PICK_ZIM = 9254 }
+}
