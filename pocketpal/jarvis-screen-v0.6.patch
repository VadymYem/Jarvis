--- /dev/null
+++ b/src/agent/native/JarvisScreen.ts
@@ -0,0 +1,25 @@
+import {NativeModules, Platform} from 'react-native';
+
+export interface JarvisScreenApi {
+  isEnabled(): Promise<boolean>;
+  openAccessibilitySettings(): Promise<void>;
+  snapshot(): Promise<string>;
+  capture(): Promise<string>;
+  captureDelayed(delayMs: number): Promise<string>;
+  action(operation: 'click' | 'scroll' | 'back', index: number, expectedLabel: string, expectedPackage: string): Promise<string>;
+}
+
+const native = Platform.OS === 'android'
+  ? NativeModules.JarvisScreenModule as JarvisScreenApi | undefined
+  : undefined;
+
+const unavailable = (): Promise<never> => Promise.reject(new Error('Доступ до екрана доступний лише в Android збірці Jarvis.'));
+
+export const jarvisScreen: JarvisScreenApi = {
+  isEnabled: () => native?.isEnabled() ?? Promise.resolve(false),
+  openAccessibilitySettings: () => native?.openAccessibilitySettings() ?? unavailable(),
+  snapshot: () => native?.snapshot() ?? unavailable(),
+  capture: () => native?.capture() ?? unavailable(),
+  captureDelayed: delayMs => native?.captureDelayed(delayMs) ?? unavailable(),
+  action: (operation, index, label, pkg) => native?.action(operation, index, label, pkg) ?? unavailable(),
+};
diff --git a/src/agent/talents/ScreenEngine.ts b/src/agent/talents/ScreenEngine.ts
