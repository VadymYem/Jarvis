diff --git a/android/app/src/main/java/top/authorche/agent/JarvisScreenModule.kt b/android/app/src/main/java/top/authorche/agent/JarvisScreenModule.kt
new file mode 100644
index 0000000..22473aa
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/JarvisScreenModule.kt
@@ -0,0 +1,62 @@
+package top.authorche.agent
+
+import android.content.Intent
+import android.os.Handler
+import android.os.Looper
+import android.provider.Settings
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+
+class JarvisScreenModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  override fun getName() = "JarvisScreenModule"
+
+  @ReactMethod fun isEnabled(promise: Promise) { promise.resolve(JarvisScreenService.active != null) }
+
+  @ReactMethod fun openAccessibilitySettings(promise: Promise) {
+    try {
+      context.startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+      promise.resolve(null)
+    } catch (error: Exception) { promise.reject("SCREEN_SETTINGS", error.message, error) }
+  }
+
+  @ReactMethod fun snapshot(promise: Promise) {
+    context.runOnUiQueueThread {
+      try { promise.resolve(requireService().describe()) }
+      catch (error: Exception) { promise.reject("SCREEN_SNAPSHOT", error.message, error) }
+    }
+  }
+
+  @ReactMethod fun action(operation: String, index: Double, expectedLabel: String, expectedPackage: String, promise: Promise) {
+    context.runOnUiQueueThread {
+      try {
+        val service = requireService()
+        promise.resolve(when (operation) {
+          "click" -> service.click(index.toInt(), expectedLabel, expectedPackage)
+          "scroll" -> service.scroll()
+          "back" -> service.back()
+          else -> throw IllegalArgumentException("Невідома дія з екраном")
+        })
+      } catch (error: Exception) { promise.reject("SCREEN_ACTION", error.message, error) }
+    }
+  }
+
+  @ReactMethod fun capture(promise: Promise) {
+    context.runOnUiQueueThread {
+      try { requireService().capture({ promise.resolve(it) }, { promise.reject("SCREEN_CAPTURE", it) }) }
+      catch (error: Exception) { promise.reject("SCREEN_CAPTURE", error.message, error) }
+    }
+  }
+
+  @ReactMethod fun captureDelayed(delayMs: Double, promise: Promise) {
+    val delay = delayMs.toLong().coerceIn(1000, 10000)
+    Handler(Looper.getMainLooper()).postDelayed({
+      try { requireService().capture({ promise.resolve(it) }, { promise.reject("SCREEN_CAPTURE", it) }) }
+      catch (error: Exception) { promise.reject("SCREEN_CAPTURE", error.message, error) }
+    }, delay)
+  }
+
+  private fun requireService() = JarvisScreenService.active
+    ?: throw IllegalStateException("Увімкніть службу Jarvis у Спеціальних можливостях Android")
+}
diff --git a/android/app/src/main/java/top/authorche/agent/JarvisScreenService.kt b/android/app/src/main/java/top/authorche/agent/JarvisScreenService.kt
new file mode 100644
index 0000000..b2a0e60
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/JarvisScreenService.kt
@@ -0,0 +1,108 @@
+package top.authorche.agent
+
+import android.accessibilityservice.AccessibilityService
+import android.graphics.Bitmap
+import android.graphics.Rect
+import android.os.Build
+import android.view.Display
+import android.view.accessibility.AccessibilityEvent
+import android.view.accessibility.AccessibilityNodeInfo
+import java.io.File
+import java.io.FileOutputStream
+import java.util.UUID
+
+/** User-enabled, on-demand screen access. No event stream is retained. */
+class JarvisScreenService : AccessibilityService() {
+  companion object {
+    @Volatile var active: JarvisScreenService? = null
+      private set
+  }
+
+  override fun onServiceConnected() { active = this }
+  override fun onAccessibilityEvent(event: AccessibilityEvent?) = Unit
+  override fun onInterrupt() = Unit
+  override fun onDestroy() {
+    if (active === this) active = null
+    super.onDestroy()
+  }
+
+  private fun nodes(): List<AccessibilityNodeInfo> {
+    val root = rootInActiveWindow ?: return emptyList()
+    val result = ArrayList<AccessibilityNodeInfo>()
+    fun visit(node: AccessibilityNodeInfo, depth: Int) {
+      if (result.size >= 120 || depth > 15) return
+      val label = (node.text ?: node.contentDescription)?.toString()?.trim()
+      if (!label.isNullOrEmpty() && node.isVisibleToUser) result.add(node)
+      for (i in 0 until node.childCount) node.getChild(i)?.let { visit(it, depth + 1) }
+    }
+    visit(root, 0)
+    return result
+  }
+
+  fun describe(): String {
+    val root = rootInActiveWindow ?: return "Немає доступного вікна. Розблокуйте екран і повторіть."
+    val rows = nodes().mapIndexed { index, node ->
+      val bounds = Rect().also(node::getBoundsInScreen)
+      val label = (node.text ?: node.contentDescription).toString().replace('\n', ' ').take(100)
+      "[$index] $label | ${node.viewIdResourceName ?: ""} | ${bounds.centerX()},${bounds.centerY()} | ${if (node.isClickable) "click" else "text"}"
+    }
+    return ("Пакет: ${root.packageName ?: "невідомий"}\n" + rows.joinToString("\n")).take(12000)
+  }
+
+  fun click(index: Int, expectedLabel: String, expectedPackage: String): String {
+    val root = rootInActiveWindow ?: throw IllegalStateException("Вікно більше не доступне")
+    if (root.packageName?.toString() != expectedPackage) throw IllegalStateException("Активний застосунок змінився. Оновіть знімок екрана.")
+    val node = nodes().getOrNull(index) ?: throw IllegalArgumentException("Елемент зник. Оновіть стан екрана.")
+    val actual = (node.text ?: node.contentDescription)?.toString()?.trim() ?: ""
+    if (actual != expectedLabel.trim()) throw IllegalStateException("Вміст елемента змінився. Оновіть стан екрана.")
+    var target: AccessibilityNodeInfo? = node
+    while (target != null && !target.isClickable) target = target.parent
+    if (target == null || !target.performAction(AccessibilityNodeInfo.ACTION_CLICK)) {
+      throw IllegalStateException("Android не підтвердив натискання цього елемента")
+    }
+    return "Android прийняв натискання «${actual.take(80)}». Перевірте результат новим screen_snapshot."
+  }
+
+  fun scroll(): String {
+    val root = rootInActiveWindow ?: throw IllegalStateException("Вікно недоступне")
+    fun find(node: AccessibilityNodeInfo): AccessibilityNodeInfo? {
+      if (node.isScrollable && node.isVisibleToUser) return node
+      for (i in 0 until node.childCount) node.getChild(i)?.let { find(it)?.let { found -> return found } }
+      return null
+    }
+    val target = find(root) ?: throw IllegalStateException("Прокручувану область не знайдено")
+    if (!target.performAction(AccessibilityNodeInfo.ACTION_SCROLL_FORWARD)) throw IllegalStateException("Прокручування не виконано")
+    return "Android прийняв прокручування. Оновіть screen_snapshot."
+  }
+
+  fun back(): String {
+    if (!performGlobalAction(GLOBAL_ACTION_BACK)) throw IllegalStateException("Дію Назад не виконано")
+    return "Android прийняв дію Назад. Оновіть screen_snapshot."
+  }
+
+  fun capture(onSuccess: (String) -> Unit, onError: (String) -> Unit) {
+    if (Build.VERSION.SDK_INT < 30) { onError("Знімок екрана потребує Android 11 або новішої версії"); return }
+    takeScreenshot(Display.DEFAULT_DISPLAY, mainExecutor, object : TakeScreenshotCallback {
+      override fun onSuccess(result: ScreenshotResult) {
+        val buffer = result.hardwareBuffer
+        try {
+          val wrapped = Bitmap.wrapHardwareBuffer(buffer, result.colorSpace)
+            ?: throw IllegalStateException("Android не повернув зображення")
+          val software = wrapped.copy(Bitmap.Config.ARGB_8888, false)
+            ?: throw IllegalStateException("Знімок екрана не конвертовано")
+          val scale = minOf(1f, 1280f / maxOf(software.width, software.height))
+          val bitmap = Bitmap.createScaledBitmap(software, (software.width * scale).toInt(), (software.height * scale).toInt(), true)
+          val directory = File(noBackupFilesDir, "jarvis-screen").apply { mkdirs() }
+          val file = File(directory, "screen-${UUID.randomUUID()}.jpg")
+          FileOutputStream(file).use { bitmap.compress(Bitmap.CompressFormat.JPEG, 75, it) }
+          if (bitmap !== software) bitmap.recycle()
+          software.recycle()
+          wrapped.recycle()
+          onSuccess("file://${file.absolutePath}")
+        } catch (error: Exception) { onError(error.message ?: "Знімок екрана не збережено") }
+        finally { buffer.close() }
+      }
+      override fun onFailure(errorCode: Int) { onError("Android відхилив знімок екрана: $errorCode (захищене вікно або немає доступу)") }
+    })
+  }
+}
