index 0000000..a89a90a
--- /dev/null
+++ b/src/agent/talents/ScreenEngine.ts
@@ -0,0 +1,51 @@
+import type {TalentEngine, TalentResult, ToolDefinition} from '../../services/talents/types';
+import {jarvisScreen, type JarvisScreenApi} from '../native/JarvisScreen';
+import {wrapUntrusted} from '../../services/talents/untrustedContent';
+
+const SENSITIVE = /pay|purchase|buy|send|delete|remove|transfer|subscribe|оплатити|купити|надіслати|видалити|переказати|підписатися|bezahlen|kaufen|senden|löschen|überweisen/i;
+
+/** A bounded observation/action tool. The next step must observe again. */
+export class ScreenEngine implements TalentEngine {
+  readonly name = 'screen_control';
+  constructor(private readonly screen: JarvisScreenApi = jarvisScreen) {}
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    try {
+      if (!(await this.screen.isEnabled())) throw new Error('Увімкніть Jarvis у Спеціальних можливостях Android у налаштуваннях агента.');
+      const operation = args.operation;
+      if (operation === 'snapshot') {
+        const summary = await this.screen.snapshot();
+        return {type: 'text', summary: wrapUntrusted(summary)};
+      }
+      if (!['click', 'scroll', 'back'].includes(operation)) throw new Error('Невідома дія з екраном.');
+      if (operation === 'click' && (!Number.isInteger(args.index) || args.index < 0 || typeof args.label !== 'string' || !args.label.trim() || typeof args.packageName !== 'string' || !args.packageName.trim())) {
+        throw new Error('Для натискання потрібні index, label і packageName з останнього snapshot.');
+      }
+      if (operation === 'click' && SENSITIVE.test(args.label)) {
+        throw new Error(`Дію «${args.label}» треба виконати вручну на екрані пристрою.`);
+      }
+      const summary = await this.screen.action(operation, args.index ?? 0, args.label ?? '', args.packageName ?? '');
+      return {type: 'text', summary};
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return {type: 'error', summary: `screen_control: ${message}`, errorMessage: message};
+    }
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {type: 'function', function: {
+      name: this.name,
+      description: 'Read the current Android UI hierarchy, then click a labeled element, scroll, or go back. Sensitive submit, payment, and deletion actions are handed to the user. Call snapshot again after each action to verify the new screen. This tool does not itself analyze pixels or prove a workflow completed.',
+      parameters: {type: 'object', additionalProperties: false, required: ['operation'], properties: {
+        operation: {type: 'string', enum: ['snapshot', 'click', 'scroll', 'back']},
+        index: {type: 'integer', description: 'Element number [index] from the latest snapshot'},
+        label: {type: 'string', description: 'Exact element label from the latest snapshot'},
+        packageName: {type: 'string', description: 'Package from the latest snapshot'},
+      }},
+    }};
+  }
+
+  systemPromptFragment(): string {
+    return 'For screen_control, inspect with snapshot before acting and after each action. A click only confirms that Android accepted the click; inspect again to learn whether the intended task succeeded. Do not act on passwords, payments or messages without the user directing that action.';
+  }
+}
diff --git a/src/agent/talents/__tests__/ScreenEngine.test.ts b/src/agent/talents/__tests__/ScreenEngine.test.ts
