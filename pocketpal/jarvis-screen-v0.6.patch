@@ -0,0 +1,35 @@
+import {ScreenEngine} from '../ScreenEngine';
+import type {JarvisScreenApi} from '../../native/JarvisScreen';
+
+const makeScreen = (): jest.Mocked<JarvisScreenApi> => ({
+  isEnabled: jest.fn().mockResolvedValue(true),
+  openAccessibilitySettings: jest.fn(),
+  snapshot: jest.fn().mockResolvedValue('Пакет: org.example\n[0] Open | | 20,20 | click'),
+  capture: jest.fn(),
+  captureDelayed: jest.fn(),
+  action: jest.fn().mockResolvedValue('Android прийняв натискання. Оновіть screen_snapshot.'),
+});
+
+describe('ScreenEngine', () => {
+  it('reports a disabled service without inspecting another app', async () => {
+    const screen = makeScreen();
+    screen.isEnabled.mockResolvedValue(false);
+    const result = await new ScreenEngine(screen).execute({operation: 'snapshot'});
+    expect(result.type).toBe('error');
+    expect(screen.snapshot).not.toHaveBeenCalled();
+  });
+
+  it('requires the observed package and exact label for a click', async () => {
+    const screen = makeScreen();
+    const result = await new ScreenEngine(screen).execute({operation: 'click', index: 0, label: 'Open', packageName: 'org.example'});
+    expect(screen.action).toHaveBeenCalledWith('click', 0, 'Open', 'org.example');
+    expect(result.summary).toContain('Оновіть screen_snapshot');
+  });
+
+  it('hands sensitive submit actions back to the user', async () => {
+    const screen = makeScreen();
+    const result = await new ScreenEngine(screen).execute({operation: 'click', index: 2, label: 'Надіслати', packageName: 'org.example'});
+    expect(result.type).toBe('error');
+    expect(screen.action).not.toHaveBeenCalled();
+  });
+});
