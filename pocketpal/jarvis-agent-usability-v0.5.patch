new file mode 100644
--- /dev/null
+++ b/src/agent/parseFlashlightCommand.ts
@@ -0,0 +1,9 @@
+/** Only intercept unambiguous direct commands. Other requests go to the model. */
+export const parseFlashlightCommand = (input: string): boolean | null => {
+  const text = input.trim().toLowerCase();
+  if (!/(ліхтар|фонар|flashlight|torch|лямп)/i.test(text)) return null;
+  if (/\b(?:don't|do not|not)\s+(?:turn|switch|disable|enable)\b|(?:не|ня)\s+(?:вимк|увімк|включ|выключ|уключ|адключ)/iu.test(text)) return null;
+  const off = /\b(?:turn\s+off|switch\s+off|disable)\b|(?:вимкн|відключ|выключ|отключ|выруб|выключи|выключыць|выключы|адключ|патуш)/iu.test(text);
+  const on = /\b(?:turn\s+on|switch\s+on|enable)\b|(?:увімкн|включ|уключ|запал)/iu.test(text);
+  return off === on ? null : on;
+};
diff --git a/src/agent/parseOpenAppCommand.ts b/src/agent/parseOpenAppCommand.ts
new file mode 100644
--- /dev/null
+++ b/src/agent/parseOpenAppCommand.ts
@@ -0,0 +1,7 @@
+/** A short direct app launch request; descriptions and ambiguous requests go to Jarvis. */
+export const parseOpenAppCommand = (input: string): string | null => {
+  const match = input.trim().match(/^(?:відкрий|відкрити|запусти|запустити|открой|открыть|запустить|адкрый|запусці|open|launch)\s+(?:(?:застосунок|додаток|програму|приложение|app)\s+)?([\p{L}\p{N}_. -]{2,80})[.!?]?$/iu);
+  if (!match) return null;
+  const target = match[1].trim().replace(/[.!?]+$/, '').trim();
+  return target && !/^(?:це|его|it|щось|something)$/iu.test(target) ? target : null;
+};
diff --git a/src/agent/__tests__/parseDeviceCommands.test.ts b/src/agent/__tests__/parseDeviceCommands.test.ts
new file mode 100644
--- /dev/null
+++ b/src/agent/__tests__/parseDeviceCommands.test.ts
@@ -0,0 +1,19 @@
+import {parseFlashlightCommand} from '../parseFlashlightCommand';
+import {parseOpenAppCommand} from '../parseOpenAppCommand';
+
+describe('direct Android commands', () => {
+  it('routes explicit flashlight changes, including speech-style wording', () => {
+    expect(parseFlashlightCommand('Вимкни ліхтарик')).toBe(false);
+    expect(parseFlashlightCommand('Увімкни ліхтарик')).toBe(true);
+    expect(parseFlashlightCommand('Turn off the flashlight')).toBe(false);
+    expect(parseFlashlightCommand('Не вимикай ліхтарик')).toBeNull();
+    expect(parseFlashlightCommand('Яка погода?')).toBeNull();
+  });
+
+  it('extracts a launch target without guessing for unrelated requests', () => {
+    expect(parseOpenAppCommand('Відкрий Telegram')).toBe('Telegram');
+    expect(parseOpenAppCommand('Запусти додаток com.termux')).toBe('com.termux');
+    expect(parseOpenAppCommand('Open YouTube')).toBe('YouTube');
+    expect(parseOpenAppCommand('Який додаток відкрити?')).toBeNull();
+  });
+});
