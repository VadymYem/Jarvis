+
+const wantsArtifactExecution = (text: string): boolean => {
+  const value = text.toLocaleLowerCase();
+  const action =
+    /(створ|зроб|згенер|намал|побуд|збереж|експорт|покращ|відредаг|перероб|напиш|create|generate|draw|build|save|export|improve|edit|rewrite|erstell|generier|zeichn|speicher|verbesser|bearbeit)/i.test(value);
+  const artifact =
+    /(картин|зображ|фото|файл|документ|pdf|docx?|html|сторінк|сайт|код|скрипт|програм|графік|діаграм|image|picture|file|document|page|website|code|script|program|chart|diagram|bild|datei|dokument|seite|webseite|code)/i.test(value);
+  return action && artifact;
+};
+
+const addJarvisRuntimePrompt = (
+  params: ApiCompletionParams,
+  forceArtifact: boolean,
+): void => {
+  const suffix = forceArtifact
+    ? JARVIS_RUNTIME_PROMPT +
+      ' This request explicitly requires an artifact: call a tool now; do not finish with prose only.'
+    : JARVIS_RUNTIME_PROMPT;
+  const messages = [...(params.messages ?? [])] as ChatMessage[];
+  if (messages[0]?.role === 'system') {
+    messages[0] = {
+      ...messages[0],
+      content: String(messages[0].content ?? '') + '\n\n' + suffix,
+    };
+  } else {
+    messages.unshift({role: 'system', content: suffix});
+  }
+  params.messages = messages as ApiCompletionParams['messages'];
+};
