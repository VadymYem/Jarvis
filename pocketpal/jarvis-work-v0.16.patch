+++ b/src/agent/ToolCompatibilityEngine.ts
@@ -0,0 +1,16 @@
+import type {ApiCompletionParams, CompletionEngine, CompletionResult, CompletionStreamData} from '../utils/completionTypes';
+import {StructuredToolEngine} from './StructuredToolEngine';
+/** Retry rejected tool templates only before any streamed result or side effect. */
+export class ToolCompatibilityEngine implements CompletionEngine {
+  constructor(private base: CompletionEngine) {}
+  stopCompletion(): Promise<void> { return this.base.stopCompletion(); }
+  async completion(params: ApiCompletionParams, callback?: (data: CompletionStreamData) => void): Promise<CompletionResult> {
+    let emitted = false;
+    try { return await this.base.completion(params, data => { emitted = emitted || !!(data.content || data.tool_calls?.length); callback?.(data); }); }
+    catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      if (emitted || !params.tools || !/parser generation|jinja|roles must alternate|tool.?call.{0,40}(?:unsupported|not supported)|(?:unsupported|not supported).{0,40}tools/i.test(message)) throw error;
+      return new StructuredToolEngine(this.base).completion(params, callback);
+    }
+  }
+}
