@@ -0,0 +1,21 @@
+/** Validate tool arguments before crossing an Android or filesystem boundary. */
+export function validateToolArguments(schema: Record<string, any>, value: unknown, path = 'arguments'): string | null {
+  if (schema.enum && !schema.enum.includes(value)) return `${path}: очікується одне з ${schema.enum.join(', ')}`;
+  if (schema.type === 'object') {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) return `${path}: очікується об’єкт JSON`;
+    const object = value as Record<string, unknown>;
+    for (const key of schema.required ?? []) if (!(key in object)) return `${path}.${key}: обов’язковий аргумент`;
+    for (const [key, item] of Object.entries(object)) {
+      const child = schema.properties?.[key];
+      if (!child && schema.additionalProperties === false) return `${path}.${key}: невідомий аргумент`;
+      if (child) { const error = validateToolArguments(child, item, `${path}.${key}`); if (error) return error; }
+    }
+  } else if (schema.type === 'array') {
+    if (!Array.isArray(value)) return `${path}: очікується масив`;
+    if (schema.items) for (const item of value) { const error = validateToolArguments(schema.items, item, path); if (error) return error; }
+  } else if (schema.type && typeof value !== (schema.type === 'integer' ? 'number' : schema.type)) {
+    return `${path}: очікується ${schema.type}`;
+  }
+  if (typeof value === 'number' && (!Number.isFinite(value) || (schema.type === 'integer' && !Number.isInteger(value)))) return `${path}: некоректне число`;
+  return null;
+}
