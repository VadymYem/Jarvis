new file mode 100644
index 0000000..05e1bbc
--- /dev/null
+++ b/src/agent/ContextBudgetEngine.ts
@@ -0,0 +1,52 @@
+import type {ApiCompletionParams, CompletionEngine, CompletionResult, CompletionStreamData} from '../utils/completionTypes';
+import type {ChatMessage} from '../utils/types';
+
+export interface TokenizerContext {
+  getFormattedChat(messages: NonNullable<ApiCompletionParams['messages']>, template?: undefined, params?: any): Promise<{prompt: string; media_paths?: string[]}>;
+  tokenize(text: string, options?: {media_paths?: string[]}): Promise<{tokens: number[]}>;
+  detokenize(tokens: number[]): Promise<string>;
+}
+
+const checked = new WeakSet<object>();
+export async function verifyUkrainianTokenizer(context: TokenizerContext): Promise<void> {
+  if (checked.has(context)) return;
+  const sample = 'Україна — це ї, є, ґ та і. П’ять, з\u0027єднання, Шевченко. 🎵';
+  const tokens = await context.tokenize(sample);
+  const decoded = await context.detokenize(tokens.tokens);
+  if (decoded.normalize('NFC').trimStart() !== sample.normalize('NFC').trimStart()) throw new Error('Токенізатор GGUF не відтворив український текст без втрат');
+  checked.add(context);
+}
+
+/** Counts the formatted prompt with the loaded GGUF tokenizer, including media. */
+export class ContextBudgetEngine implements CompletionEngine {
+  constructor(private base: CompletionEngine, private context: TokenizerContext, private window: number) {}
+  stopCompletion(): Promise<void> { return this.base.stopCompletion(); }
+  async completion(params: ApiCompletionParams, callback?: (data: CompletionStreamData) => void): Promise<CompletionResult> {
+    await verifyUkrainianTokenizer(this.context);
+    const window = Math.max(512, this.window);
+    const reserve = Math.min(Math.max(256, params.n_predict && params.n_predict > 0 ? params.n_predict : 2048), Math.floor(window / 2));
+    const budget = window - reserve - 64;
+    let messages = [...(params.messages ?? [])] as ChatMessage[];
+    const original = messages;
+    let removed = 0;
+    while (true) {
+      const candidate = [...messages];
+      if (removed) {
+        const memory = `Старі кроки збережено в історії чату. Початкове завдання: ${String(original.find(item => item.role === 'user')?.content ?? '').slice(0, 1600)}\nСтислий журнал:\n${original.slice(0, removed + 2).filter(item => item.role === 'tool').map(item => String(item.content ?? '').slice(0, 500)).slice(-4).join('\n')}`;
+        if (candidate[0]?.role === 'system') candidate[0] = {...candidate[0], content: String(candidate[0].content ?? '') + '\n' + memory};
+        else candidate.unshift({role: 'system', content: memory});
+      }
+      const formatted = await this.context.getFormattedChat(candidate as ApiCompletionParams['messages'] & NonNullable<ApiCompletionParams['messages']>, undefined, {jinja: true, ...params, messages: undefined});
+      const count = (await this.context.tokenize(formatted.prompt, {media_paths: formatted.media_paths})).tokens.length;
+      if (count <= budget) return this.base.completion({...params, messages: candidate as ApiCompletionParams['messages'], n_predict: Math.min(params.n_predict && params.n_predict > 0 ? params.n_predict : reserve, window - count - 32)}, callback);
+      const start = messages[0]?.role === 'system' ? 1 : 0;
+      // Drop complete oldest conversation groups, never the current user request
+      // or half a tool round. The complete transcript remains persisted on disk.
+      let next = start + 1;
+      while (next < messages.length && messages[next].role !== 'user') next += 1;
+      if (next >= messages.length) throw new Error('Поточне завдання не поміщається в контекст GGUF. Збільште контекст або оберіть менший фрагмент документа; текст завдання не обрізано.');
+      removed += next - start;
+      messages = [...messages.slice(0, start), ...messages.slice(next)];
+    }
+  }
+}
