+import {StructuredToolEngine, actionSchema, needsStructuredTools} from '../StructuredToolEngine';
+import type {CompletionEngine} from '../../utils/completionTypes';
+import type {ToolDefinition} from '../../services/talents/types';
+const tools: ToolDefinition[] = [{type: 'function', function: {name: 'workspace', description: 'Files', parameters: {type: 'object', required: ['operation'], properties: {operation: {type: 'string', enum: ['list']}}, additionalProperties: false}}}];
+const engine = (...answers: string[]): CompletionEngine => ({completion: jest.fn(async () => ({text: answers.shift() ?? '', content: ''})), stopCompletion: jest.fn(async () => {})});
+describe('Structured local tool compatibility', () => {
+  it('does not mistake a disabled capability object for native tool support', () => {
+    expect(needsStructuredTools({chatTemplates: {jinja: {defaultCaps: {tools: false, toolCalls: false}, toolUse: false, toolUseCaps: {tools: false, toolCalls: false}}}})).toBe(true);
+    expect(needsStructuredTools({chatTemplates: {jinja: {defaultCaps: {tools: true}}}})).toBe(false);
+  });
+  it('dispatches a grammar-constrained action without a native tool parser', async () => {
+    const base = engine('{"tool":"workspace","arguments":{"operation":"list"}}');
+    const result = await new StructuredToolEngine(base).completion({messages: [{role: 'user', content: 'Перевір файли'}], tools, tool_choice: 'required'});
+    expect(result.tool_calls?.[0].function?.name).toBe('workspace');
+    const params = (base.completion as jest.Mock).mock.calls[0][0];
+    expect(params.tools).toBeUndefined();
+    expect(params.response_format.type).toBe('json_schema');
+  });
+  it('repairs invalid arguments and never executes an invented tool', async () => {
+    const base = engine('{"tool":"delete_all","arguments":{}}', '{"tool":"workspace","arguments":{"operation":"list"}}');
+    const result = await new StructuredToolEngine(base).completion({messages: [], tools});
+    expect(base.completion).toHaveBeenCalledTimes(2);
+    expect(result.tool_calls?.[0].function?.name).toBe('workspace');
+  });
+  it('forbids final prose when a real action is required', () => {
+    expect(JSON.stringify(actionSchema(tools, true))).not.toContain('"answer"');
+  });
+  it('preserves Vision input while requesting a tool', async () => {
+    const base = engine('{"tool":"workspace","arguments":{"operation":"list"}}');
+    await new StructuredToolEngine(base).completion({messages: [{role: 'user', content: [{type: 'text', text: 'Опрацюй зображення'}, {type: 'image_url', image_url: {url: 'file:///image.png'}}]}], tools});
+    const messages = (base.completion as jest.Mock).mock.calls[0][0].messages;
+    expect(JSON.stringify(messages)).toContain('file:///image.png');
+  });
+});
