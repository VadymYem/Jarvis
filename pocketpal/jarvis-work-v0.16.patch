+++ b/src/services/search/relevance.ts
@@ -0,0 +1,25 @@
+import type {SearchHit} from './types';
+const STOP = new Set(['про', 'для', 'та', 'або', 'the', 'and', 'for', 'with', 'інформацію', 'інформація', 'знайди', 'пошукай', 'покажи', 'мені', 'ласка', 'будь']);
+const normalize = (value: string): string => value.normalize('NFC').toLocaleLowerCase().replace(/[’ʼ`]/g, "'");
+const stem = (word: string): string => word.length >= 6 ? word.replace(/(?:ами|ями|ого|ому|ові|еві|ою|ею|ів|а|у|и|і|о|е|я|ю)$/u, '') : word;
+export function rankedHits(query: string, hits: SearchHit[], max: number): SearchHit[] {
+  const words = [...new Set((normalize(query).match(/[\p{L}\p{N}_-]{2,}/gu) ?? []).filter(word => !STOP.has(word)).map(stem))];
+  const seen = new Set<string>();
+  return hits.map((hit, index) => {
+    const title = normalize(hit.title);
+    const snippet = normalize(hit.snippet);
+    const url = normalize(hit.url);
+    const score = words.reduce((sum, word) => sum + (title.includes(word) ? 3 : url.includes(word) ? 2 : snippet.includes(word) ? 1 : 0), 0);
+    return {hit, score, index};
+  }).filter(({hit, score}) => {
+    try {
+      const url = new URL(hit.url);
+      if (!/^https?:$/.test(url.protocol) || !hit.title.trim() || (words.length && !score)) return false;
+      url.hash = '';
+      const key = url.toString();
+      if (seen.has(key)) return false;
+      seen.add(key);
+      return true;
+    } catch { return false; }
+  }).sort((a, b) => b.score - a.score || a.index - b.index).slice(0, max).map(({hit}) => hit);
+}
