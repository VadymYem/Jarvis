+++ b/src/work/WorkRuntime.ts
@@ -0,0 +1,17 @@
+import {AppRegistry, DeviceEventEmitter} from 'react-native';
+let active: AbortController | null = null;
+const backgroundWaiters = new Set<() => void>();
+DeviceEventEmitter.addListener('jarvisTaskStop', () => active?.abort());
+// This task holds the RN background lifecycle open; the existing agent run
+// performs the work once. There is no polling or second model instance.
+AppRegistry.registerHeadlessTask('JarvisBackground', () => async () => {
+  if (!active) return;
+  await new Promise<void>(resolve => backgroundWaiters.add(resolve));
+});
+export function setTaskAbort(controller: AbortController | null): void {
+  active = controller;
+  if (!controller) {
+    backgroundWaiters.forEach(resolve => resolve());
+    backgroundWaiters.clear();
+  }
+}
