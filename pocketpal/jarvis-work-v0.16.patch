new file mode 100644
index 0000000..2e9e091
--- /dev/null
+++ b/src/knowledge/KnowledgeEngine.ts
@@ -0,0 +1,31 @@
+import type {TalentEngine, TalentResult, ToolDefinition} from '../services/talents/types';
+import {offlineZim, formatOfflineEvidence} from './offlineZim';
+export class KnowledgeEngine implements TalentEngine {
+  readonly name = 'knowledge_search';
+  constructor(private archiveIds: string[] | null) {}
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    try {
+      if (this.archiveIds?.length === 0) throw new Error('Не вибрано жодного паку статей.');
+      if (args.operation === 'search') {
+        const query = typeof args.query === 'string' ? args.query.trim().slice(0, 180) : '';
+        if (query.length < 2) throw new Error('Потрібний пошуковий запит із двох або більше символів.');
+        const articles = await offlineZim.search(query, 6, this.archiveIds);
+        return {type: 'text', summary: articles.length ? formatOfflineEvidence(articles) + '\n' + JSON.stringify(articles.map(article => ({title: article.title, archive_id: article.archiveId, path: article.path}))) : 'У вибраних паках нічого не знайдено. Зміни пошуковий запит; це не підтверджує відсутність факту.'};
+      }
+      if (args.operation === 'read') {
+        const id = typeof args.archive_id === 'string' ? args.archive_id : '';
+        if (!id || (this.archiveIds && !this.archiveIds.includes(id))) throw new Error('Стаття має належати вибраному паку.');
+        const article = await offlineZim.readArticle(id, String(args.path ?? ''), String(args.title ?? ''));
+        const offset = Math.max(0, Math.floor(Number(args.offset) || 0));
+        return {type: 'text', summary: `${article.title} · ${article.archive}\n[offset ${offset}/${article.text.length}]\n${article.text.slice(offset, offset + 8000)}\n${article.truncated ? 'Нативний читач скоротив надто довгу статтю.' : ''}`};
+      }
+      throw new Error('Невідома операція knowledge_search');
+    } catch (value) { const error = String(value); return {type: 'error', summary: error, errorMessage: error}; }
