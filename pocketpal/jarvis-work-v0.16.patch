@@ -0,0 +1,128 @@
+"""Deterministic Work checks; each reported pass identifies an actual check."""
+import ast
+import json
+import unittest
+import io
+import zipfile
+import sys
+import importlib
+import importlib.util
+from html.parser import HTMLParser
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+
+class _HTMLCheck(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.tags = set()
+        self.references = []
+
+    def handle_starttag(self, tag, attrs):
+        self.tags.add(tag)
+        for key, value in attrs:
+            if key in ('src', 'href') and value:
+                self.references.append(value)
+
+
+def verify(paths, test_files=None):
+    root = Path.cwd().resolve()
+    checks, errors, unsupported = [], [], []
+    if not paths:
+        errors.append('Проєкт ще не створив жодного файла.')
+    for name in dict.fromkeys(paths):
+        path = (root / name).resolve()
+        if not path.is_relative_to(root):
+            errors.append(f'{name}: шлях поза робочим каталогом')
+            continue
+        try:
+            if not path.is_file() or path.stat().st_size == 0:
+                raise ValueError('файл відсутній або порожній')
+            suffix = path.suffix.lower()
+            check = 'існування, непорожній файл'
+            if suffix == '.py':
+                ast.parse(path.read_text(encoding='utf-8'), filename=name)
+                check += ', синтаксис Python'
+            elif suffix == '.json':
+                json.loads(path.read_text(encoding='utf-8'))
+                check += ', структура JSON'
+            elif suffix in ('.xml', '.svg'):
+                ET.parse(path)
+                check += ', структура XML'
+            elif suffix in ('.png', '.jpg', '.jpeg', '.webp'):
+                from PIL import Image
+                with Image.open(path) as image:
+                    image.verify()
+                check += ', декодування зображення'
+                unsupported.append(f'{name}: візуальна оцінка композиції не виконувалась автоматично')
+            elif suffix == '.pdf':
+                from pypdf import PdfReader
+                reader = PdfReader(str(path))
+                if not reader.pages:
+                    raise ValueError('PDF без сторінок')
+                check += f', читання PDF ({len(reader.pages)} сторінок)'
+                unsupported.append(f'{name}: візуальний рендер сторінок не перевірено')
+            elif suffix in ('.docx', '.xlsx', '.pptx', '.zip', '.odt'):
+                with zipfile.ZipFile(path) as archive:
+                    invalid = archive.testzip()
+                    if invalid:
+                        raise ValueError(f'пошкоджений запис {invalid}')
+                    if suffix == '.docx':
+                        ET.fromstring(archive.read('word/document.xml'))
+                check += ', цілісність архіву документа'
+            elif suffix in ('.html', '.htm'):
+                parser = _HTMLCheck()
+                parser.feed(path.read_text(encoding='utf-8'))
+                if not {'html', 'head', 'body'}.issubset(parser.tags):
+                    raise ValueError('потрібний завершений HTML із html/head/body')
+                for ref in parser.references:
+                    if ref.startswith(('#', '/', 'data:', 'mailto:', 'tel:')) or '://' in ref:
+                        continue
+                    target = (path.parent / ref.split('?')[0].split('#')[0]).resolve()
+                    if not target.is_relative_to(root) or not target.exists():
+                        raise ValueError(f'відсутній локальний ресурс: {ref}')
+                check += ', структура HTML і локальні ресурси'
+                unsupported.append(f'{name}: браузерний runtime і візуальний рендер не перевірено')
+            elif suffix in ('.js', '.ts', '.tsx', '.jsx', '.css'):
+                path.read_text(encoding='utf-8')
+                unsupported.append(f'{name}: відповідний компілятор/runtime не вбудований; функціональність не підтверджено')
+            else:
+                if suffix in ('.txt', '.md', '.csv'):
+                    path.read_text(encoding='utf-8')
+                unsupported.append(f'{name}: виконано лише базову перевірку файла')
+            checks.append({'path': name, 'check': check})
+        except Exception as exc:
+            errors.append(f'{name}: {type(exc).__name__}: {exc}')
+    # Repaired sources must never reuse a same-second stale bytecode cache.
+    for cached in root.rglob("__pycache__/*.pyc"):
+        cached.unlink(missing_ok=True)
+    importlib.invalidate_caches()
+    for module_name, module in list(sys.modules.items()):
+        filename = getattr(module, '__file__', None)
+        if filename and module_name != __name__:
+            try:
+                if Path(filename).resolve().is_relative_to(root):
+                    del sys.modules[module_name]
+            except (OSError, ValueError):
+                pass
+    if str(root) not in sys.path:
+        sys.path.insert(0, str(root))
+    for name in dict.fromkeys(test_files or []):
+        path = (root / name).resolve()
+        try:
+            if not path.is_relative_to(root) or not path.is_file() or path.suffix != '.py':
+                raise ValueError('очікується наявний Python test-файл у проєкті')
+            spec = importlib.util.spec_from_file_location('jarvis_project_test', path)
+            module = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(module)
+            suite = unittest.defaultTestLoader.loadTestsFromModule(module)
+            if suite.countTestCases() == 0:
+                raise ValueError('не знайдено жодного тесту unittest')
+            result = unittest.TextTestRunner(stream=io.StringIO(), verbosity=1).run(suite)
+            checks.append({'path': name, 'check': f'unittest: {result.testsRun} тестів'})
+            if not result.wasSuccessful():
+                errors.extend(f'{name}: {detail}' for _, detail in result.errors + result.failures)
+        except Exception as exc:
+            errors.append(f'{name}: {type(exc).__name__}: {exc}')
+    return {'passed': bool(checks) and not errors, 'checks': checks, 'errors': errors,
+            'unsupported': list(dict.fromkeys(unsupported)), 'fully_tested': bool(checks) and not errors and not unsupported}
