@@ -0,0 +1,78 @@
+import type {ApiCompletionParams, CompletionEngine, CompletionResult, CompletionStreamData} from '../utils/completionTypes';
+import type {ChatMessage} from '../utils/types';
+import type {ToolDefinition} from '../services/talents/types';
+import {localChatMessages} from '../utils/localChatMessages';
+import {validateToolArguments} from './toolValidation';
+
+export function needsStructuredTools(model: {chatTemplates?: any; metadata?: Record<string, unknown>} | undefined): boolean {
+  const templates = model?.chatTemplates?.jinja;
+  return !(templates?.defaultCaps?.tools || templates?.defaultCaps?.toolCalls || templates?.toolUse || templates?.toolUseCaps?.tools || templates?.toolUseCaps?.toolCalls);
+}
+
+export function actionSchema(tools: ToolDefinition[], required: boolean): Record<string, unknown> {
+  const alternatives: Record<string, unknown>[] = tools.map(tool => ({
+    type: 'object', additionalProperties: false, required: ['tool', 'arguments'],
+    properties: {tool: {type: 'string', enum: [tool.function.name]}, arguments: tool.function.parameters},
+  }));
+  if (!required) alternatives.push({type: 'object', additionalProperties: false, required: ['answer'], properties: {answer: {type: 'string'}}});
+  return {oneOf: alternatives};
+}
+
+/** A normal chat template plus JSON grammar; no native tool parser is needed. */
+export class StructuredToolEngine implements CompletionEngine {
+  constructor(private base: CompletionEngine) {}
+  stopCompletion(): Promise<void> { return this.base.stopCompletion(); }
+
+  async completion(params: ApiCompletionParams, callback?: (data: CompletionStreamData) => void): Promise<CompletionResult> {
+    const tools = (params.tools ?? []) as ToolDefinition[];
+    if (!tools.length) return this.base.completion({...params, tools: undefined, tool_choice: undefined}, callback);
+    const required = params.tool_choice === 'required';
+    const names = tools.map(tool => tool.function.name);
+    let messages = localChatMessages((params.messages ?? []) as ChatMessage[]);
+    const protocol = [
+      'HOST ACTION PROTOCOL. Return exactly one JSON object. To execute a tool: {"tool":"tool_name","arguments":{...}}. One action per turn. The host executes it and supplies the result in the next turn.',
+      required ? 'You must execute a tool now. An answer object is forbidden this turn.' : 'When the task is complete, return {"answer":"Відповідь українською"}.',
+      'Do not put tool JSON inside the answer. Available tools and exact argument schemas:',
+      JSON.stringify(tools.map(tool => tool.function)),
+      'Use only enabled names and their exact argument schemas.',
+    ].join('\n');
+    messages = [...messages, {role: 'user', content: protocol}];
+    messages = localChatMessages(messages);
+    let lastError = '';
+    for (let attempt = 0; attempt < 2; attempt += 1) {
+      const request: ApiCompletionParams = {
+        ...params, messages: messages as ApiCompletionParams['messages'], tools: undefined,
+        tool_choice: undefined, parallel_tool_calls: false,
+        response_format: {type: 'json_schema', json_schema: {name: 'jarvis_action', strict: true, schema: actionSchema(tools, required)}} as ApiCompletionParams['response_format'],
+      };
+      let result: CompletionResult;
+      try { result = await this.base.completion(request); }
+      catch (error) {
+        if (!/json.?schema|response.?format|grammar.{0,40}(?:unsupported|invalid|not supported)/i.test(String(error))) throw error;
+        // Some cloud servers do not implement grammar. Parsing and schema
+        // validation below still enforce the host-side action contract.
+        result = await this.base.completion({...request, response_format: undefined});
+      }
+      try {
+        const raw = (result.content || result.text || '').trim().replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/, '');
+        const action = JSON.parse(raw) as {tool?: string; arguments?: unknown; answer?: string};
+        if (typeof action.answer === 'string' && !required && !action.tool) {
+          const answer = {...result, text: action.answer, content: action.answer, tool_calls: undefined};
+          callback?.({content: action.answer});
+          return answer;
+        }
+        const tool = tools.find(item => item.function.name === action.tool);
+        if (!tool || !names.includes(action.tool ?? '')) throw new Error('Невідомий або вимкнений інструмент');
+        const invalid = validateToolArguments(tool.function.parameters, action.arguments);
+        if (invalid) throw new Error(invalid);
+        const call = {id: `json_${Date.now()}_${attempt}`, type: 'function' as const, function: {name: tool.function.name, arguments: JSON.stringify(action.arguments)}};
+        callback?.({tool_calls: [call]});
+        return {...result, text: '', content: '', tool_calls: [call]};
+      } catch (error) {
+        lastError = error instanceof Error ? error.message : String(error);
+        messages = localChatMessages([...messages, {role: 'assistant', content: (result.content || result.text || '').slice(0, 4000)}, {role: 'user', content: `Некоректна дія: ${lastError}. Виправ формат і поверни один об’єкт JSON за схемою.`}]);
+      }
+    }
+    throw new Error(`Модель не сформувала коректну дію після повторної спроби: ${lastError}`);
+  }
+}
