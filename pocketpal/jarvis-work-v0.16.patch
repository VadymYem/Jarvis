--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/JarvisHttpModule.kt
@@ -0,0 +1,69 @@
+package top.authorche.agent
+
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import com.facebook.react.bridge.ReadableMap
+import okhttp3.Call
+import okhttp3.MediaType.Companion.toMediaTypeOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import java.io.ByteArrayOutputStream
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/** Stream-cap pages before sending them across the JS bridge. */
+class JarvisHttpModule(context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private val client = OkHttpClient()
+  private val worker = Executors.newFixedThreadPool(2)
+  private val calls = ConcurrentHashMap<String, Call>()
+  override fun getName() = "JarvisHttpModule"
+  @ReactMethod fun request(url: String, method: String, headers: ReadableMap, body: String, timeout: Double, id: String, promise: Promise) {
+    try {
+      require(url.startsWith("https://") || url.startsWith("http://")) { "HTTP(S) URL required" }
+      require(method in setOf("GET", "POST", "HEAD")) { "Unsupported HTTP method" }
+      val builder = Request.Builder().url(url)
+      val keys = headers.keySetIterator()
+      while (keys.hasNextKey()) { val key = keys.nextKey(); headers.getString(key)?.let { builder.header(key, it) } }
+      val requestBody = if (method == "POST") body.toRequestBody((if (headers.hasKey("content-type")) headers.getString("content-type") ?: "application/json" else "application/json").toMediaTypeOrNull()) else null
+      val call = client.newBuilder().callTimeout(timeout.toLong().coerceIn(1000, 30000), TimeUnit.MILLISECONDS).build().newCall(builder.method(method, requestBody).build())
+      calls[id] = call
+      worker.execute {
+        try {
+          call.execute().use { response ->
+            val declared = response.body?.contentLength() ?: 0
+            require(declared <= MAX_BYTES) { "response too large" }
+            val output = ByteArrayOutputStream()
+            response.body?.byteStream()?.use { input ->
+              val buffer = ByteArray(8192)
+              while (true) {
+                val count = input.read(buffer)
+                if (count < 0) break
+                require(output.size() + count <= MAX_BYTES) { "response too large" }
+                output.write(buffer, 0, count)
+              }
+            }
+            promise.resolve(Arguments.createMap().apply {
+              putInt("status", response.code)
+              putString("body", output.toString("UTF-8"))
+            })
+          }
+        } catch (error: Exception) { promise.reject("HTTP_REQUEST", error.message, error) }
+        finally { calls.remove(id) }
+      }
+    } catch (error: Exception) { calls.remove(id); promise.reject("HTTP_INPUT", error.message, error) }
+  }
+  @ReactMethod fun cancel(id: String) { calls.remove(id)?.cancel() }
+  override fun invalidate() {
+    calls.values.forEach { it.cancel() }
+    calls.clear()
+    worker.shutdownNow()
+    client.connectionPool.evictAll()
+    super.invalidate()
+  }
+  companion object { const val MAX_BYTES = 2 * 1024 * 1024 }
+}
