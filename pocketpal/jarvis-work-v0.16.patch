@@ -0,0 +1,101 @@
+package top.authorche.agent
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.os.Handler
+import android.os.Looper
+import android.view.View
+import android.webkit.ConsoleMessage
+import android.webkit.WebChromeClient
+import android.webkit.WebResourceError
+import android.webkit.WebResourceRequest
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import org.json.JSONObject
+import org.json.JSONTokener
+import java.io.File
+
+/** Off-screen mobile WebView check and real raster preview for local Vision. */
+class WorkPreviewModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private val main = Handler(Looper.getMainLooper())
+  private var active: WebView? = null
+  private var pending: Promise? = null
+  private val errors = mutableListOf<String>()
+  private var finishing = false
+  override fun getName() = "WorkPreviewModule"
+  @ReactMethod fun preview(path: String, promise: Promise) {
+    main.post {
+      try {
+        check(active == null) { "Попередній перегляд ще виконується" }
+        val root = File(context.filesDir, "jarvis-workspace").canonicalFile
+        val source = File(root, path).canonicalFile
+        require(source.path.startsWith(root.path + File.separator) && source.isFile && source.extension.lowercase() in setOf("html", "htm")) { "Потрібний HTML-файл проєкту" }
+        val view = WebView(context)
+        active = view
+        pending = promise
+        errors.clear()
+        finishing = false
+        view.settings.javaScriptEnabled = true
+        view.settings.allowFileAccess = true
+        view.settings.allowContentAccess = false
+        view.settings.domStorageEnabled = false
+        val density = context.resources.displayMetrics.density
+        val width = (384 * density).toInt().coerceIn(384, 1200)
+        val height = (720 * density).toInt().coerceIn(720, 2160)
+        view.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY), View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY))
+        view.layout(0, 0, width, height)
+        view.webChromeClient = object : WebChromeClient() {
+          override fun onConsoleMessage(message: ConsoleMessage): Boolean {
+            if (message.messageLevel() == ConsoleMessage.MessageLevel.ERROR && errors.size < 20) errors.add(message.message().take(500))
+            return true
+          }
+        }
+        view.webViewClient = object : WebViewClient() {
+          override fun onReceivedError(webView: WebView, request: WebResourceRequest, error: WebResourceError) {
+            if (webView === active && errors.size < 20) errors.add(error.description.toString().take(300))
+          }
+          override fun onPageFinished(webView: WebView, url: String) {
+            if (webView !== active || finishing) return
+            finishing = true
+            main.postDelayed({ if (webView === active) capture(webView, root, source, width, height) }, 1200)
+          }
+        }
+        main.postDelayed({
+          if (active === view) { pending?.reject("PREVIEW_TIMEOUT", "HTML preview timed out"); close() }
+        }, 12000)
+        view.loadUrl("file://" + source.absolutePath)
+      } catch (error: Exception) { promise.reject("PREVIEW_INPUT", error.message, error); if (pending === promise) close() }
+    }
+  }
+  private fun capture(view: WebView, root: File, source: File, width: Int, height: Int) {
+    view.evaluateJavascript("""JSON.stringify({title:document.title,text:(document.body?.innerText||'').slice(0,1500),width:innerWidth,overflow:Math.max(0,(document.documentElement?.scrollWidth||0)-innerWidth),headings:document.querySelectorAll('h1,h2,h3').length})""") { raw ->
+      if (view !== active) return@evaluateJavascript
+      try {
+        val report = JSONObject(JSONTokener(raw).nextValue().toString())
+        if (report.optInt("overflow") > 4 && errors.size < 20) errors.add("Горизонтальне переповнення: ${report.optInt("overflow")} CSS px")
+        val folder = File(root, ".work-previews").apply { mkdirs() }
+        val image = File(folder, source.nameWithoutExtension + ".png")
+        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        try {
+          view.draw(Canvas(bitmap))
+          image.outputStream().use { bitmap.compress(Bitmap.CompressFormat.PNG, 100, it) }
+        } finally { bitmap.recycle() }
+        pending?.resolve(Arguments.createMap().apply {
+          putString("report", report.toString())
+          putArray("errors", Arguments.createArray().apply { errors.forEach { pushString(it) } })
+          putString("path", image.relativeTo(root).invariantSeparatorsPath)
+          putString("uri", "file://" + image.absolutePath)
+          putDouble("size", image.length().toDouble())
+        })
+      } catch (error: Exception) { pending?.reject("PREVIEW_CAPTURE", error.message, error) }
+      finally { close() }
+    }
+  }
+  private fun close() { active?.stopLoading(); active?.destroy(); active = null; pending = null; errors.clear(); finishing = false }
+  override fun invalidate() { main.post { pending?.reject("PREVIEW_CLOSED", "Preview closed"); close() }; super.invalidate() }
+}
