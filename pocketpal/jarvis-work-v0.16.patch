+import React from 'react';
+import {ScrollView, View} from 'react-native';
+import {Button, Checkbox, Menu, Switch, Text} from 'react-native-paper';
+import {observer} from 'mobx-react';
+import {workStore} from './WorkStore';
+import {chatSessionStore, modelStore} from '../store';
+import {offlineZim, type ArchiveInfo} from '../knowledge/offlineZim';
+
+export const WorkControls = observer(({resume}: {resume: () => void}) => {
+  const [open, setOpen] = React.useState(false);
+  const [archives, setArchives] = React.useState<ArchiveInfo[]>([]);
+  const [error, setError] = React.useState('');
+  React.useEffect(() => { workStore.hydrate().catch(value => setError(String(value))); }, []);
+  const sessionId = chatSessionStore.activeSessionId;
+  const preferences = workStore.getPreferences(sessionId);
+  const busy = modelStore.inferencing || chatSessionStore.isGenerating;
+  const choose = async (id: string | null) => {
+    const current = preferences.archiveIds ?? archives.map(item => item.id);
+    await workStore.setPreferences(sessionId, {archiveIds: id === null ? null : current.includes(id) ? current.filter(item => item !== id) : [...current, id]});
+  };
+  const showArchives = async () => {
+    try { setArchives((await offlineZim.status()).archives ?? []); setOpen(true); }
+    catch (value) { setError(String(value)); }
+  };
+  const task = workStore.task?.sessionId === sessionId ? workStore.task : null;
+  return (
+    <View style={{paddingHorizontal: 12, paddingVertical: 4}}>
+      <View style={{flexDirection: 'row', alignItems: 'center', flexWrap: 'wrap', gap: 8}}>
+        <Text variant="labelLarge">Work</Text>
+        <Switch testID="work-toggle" value={preferences.enabled} disabled={busy || !workStore.ready} onValueChange={enabled => { workStore.setPreferences(sessionId, {enabled}).catch(value => setError(String(value))); }} />
+        <Menu visible={open} onDismiss={() => setOpen(false)} anchor={<Button compact disabled={busy} onPress={showArchives}>Статті: {preferences.archiveIds === null ? 'усі паки' : preferences.archiveIds.length}</Button>}>
+          <Menu.Item title="Усі паки" onPress={() => { choose(null).catch(value => setError(String(value))); }} />
+          <ScrollView style={{maxHeight: 300}}>
+          {archives.map(archive => <Checkbox.Item key={archive.id} label={`${archive.name} · ${archive.articles}`} status={preferences.archiveIds === null || preferences.archiveIds.includes(archive.id) ? 'checked' : 'unchecked'} onPress={() => { choose(archive.id).catch(value => setError(String(value))); }} />)}
+          </ScrollView>
+          {!archives.length && <Menu.Item title="Додайте ZIM у «Завантаження статей»" />}
+        </Menu>
+        {task?.status === 'interrupted' && <Button disabled={busy} onPress={resume}>Продовжити Work</Button>}
+      </View>
+      {preferences.enabled && <Text variant="bodySmall">План → створення → перевірка → виправлення. Можна вимкнути екран.</Text>}
+      {task && <Text variant="bodySmall">{task.phase}</Text>}
+      {!!error && <Text variant="bodySmall">{error}</Text>}
+    </View>
+  );
+});
diff --git a/src/work/WorkRuntime.ts b/src/work/WorkRuntime.ts
