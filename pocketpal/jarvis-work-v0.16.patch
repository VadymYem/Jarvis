+import {runAgent} from '../AgentRunner';
+import type {CompletionEngine, CompletionResult} from '../../../utils/completionTypes';
+import type {AgentEvent} from '../AgentRunner.types';
+import type {TalentResult, TalentEngine} from '../../talents/types';
+const call = (name: string, args: unknown): CompletionResult => ({text: '', content: '', tool_calls: [{id: 'a', type: 'function', function: {name, arguments: JSON.stringify(args)}}]});
+function scripted(results: CompletionResult[]): CompletionEngine { return {completion: jest.fn(async () => results.shift() ?? {text: 'Готово', content: 'Готово'}), stopCompletion: jest.fn(async () => {})}; }
+function handlers(fail = false): Record<string, TalentEngine> {
+  return {
+    workspace: {name: 'workspace', execute: jest.fn(async (): Promise<TalentResult> => ({type: 'text', summary: 'JARVIS_ARTIFACTS_JSON:[{"path":"app.py"}]'})), toToolDefinition: () => ({type: 'function', function: {name: 'workspace', description: 'Files', parameters: {}}})},
+    work_verify: {name: 'work_verify', execute: jest.fn(async (): Promise<TalentResult> => fail ? {type: 'error', summary: 'Синтаксична помилка', errorMessage: 'SyntaxError'} : {type: 'text', summary: 'JARVIS_WORK_VERIFICATION_JSON:{"passed":true}'}), toToolDefinition: () => ({type: 'function', function: {name: 'work_verify', description: 'Checks', parameters: {}}})},
+  };
+}
+const collect = async (options: Parameters<typeof runAgent>[0]) => { const events: AgentEvent[] = []; for await (const event of runAgent(options)) events.push(event); return events; };
+describe('Work completion contract', () => {
+  it('automatically checks real files before accepting final model prose', async () => {
+    const tools = handlers();
+    const events = await collect({engine: scripted([call('workspace', {operation: 'write_text', path: 'app.py', content: 'print(1)'})]), initialParams: {messages: [], tool_choice: 'required'}, allowedTalentNames: Object.keys(tools), talentLookup: name => tools[name], triggerMarkers: [], messageId: 'm', workMode: true, requiredArtifact: true});
+    expect(tools.work_verify.execute).toHaveBeenCalledTimes(1);
+    expect(events[events.length - 1]?.type).toBe('run_finished');
+  });
+  it('does not claim completion after failed validation', async () => {
+    const tools = handlers(true);
+    const events = await collect({engine: scripted([call('workspace', {operation: 'write_text', path: 'app.py'})]), initialParams: {messages: []}, allowedTalentNames: Object.keys(tools), talentLookup: name => tools[name], triggerMarkers: [], messageId: 'm', workMode: true, maxTurns: 4});
+    expect(events[events.length - 1]?.type).toBe('run_failed');
+    expect(events.some(event => event.type === 'run_finished')).toBe(false);
+  });
+  it('invalidates a successful check after another file write', async () => {
+    const tools = handlers();
+    await collect({engine: scripted([call('workspace', {operation: 'write_text', path: 'app.py'}), call('work_verify', {}), call('workspace', {operation: 'write_text', path: 'app.py', content: 'new'})]), initialParams: {messages: []}, allowedTalentNames: Object.keys(tools), talentLookup: name => tools[name], triggerMarkers: [], messageId: 'm', workMode: true});
+    expect(tools.work_verify.execute).toHaveBeenCalledTimes(2);
+  });
+  it('persists a pending action before executing it and the result after', async () => {
+    const tools = handlers();
+    const checkpoint = jest.fn(async () => {});
+    await collect({engine: scripted([call('workspace', {operation: 'write_text', path: 'app.py'})]), initialParams: {messages: []}, allowedTalentNames: Object.keys(tools), talentLookup: name => tools[name], triggerMarkers: [], messageId: 'm', workMode: true, onCheckpoint: checkpoint});
+    expect(checkpoint.mock.calls.some(([state]: any[]) => state.pendingTool === 'workspace')).toBe(true);
+    expect(checkpoint.mock.calls.some(([state]: any[]) => state.artifacts.includes('app.py'))).toBe(true);
+  });
+});
