new file mode 100644
index 0000000..5b0834f
--- /dev/null
+++ b/src/work/WorkStore.ts
@@ -0,0 +1,86 @@
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import {makeAutoObservable, runInAction} from 'mobx';
+import * as RNFS from '@dr.pogodin/react-native-fs';
+import type {ApiCompletionParams} from '../utils/completionTypes';
+
+export type WorkCheckpoint = {
+  messages: ApiCompletionParams['messages'];
+  turn: number;
+  artifacts: string[];
+  verified: boolean;
+  pendingTool?: string;
+};
+export type WorkTask = {
+  id: string; sessionId: string; goal: string; modelId: string;
+  status: 'running' | 'interrupted' | 'done'; phase: string; updatedAt: number;
+  checkpoint?: WorkCheckpoint;
+};
+type Preferences = {enabled: boolean; archiveIds: string[] | null};
+const DEFAULT: Preferences = {enabled: false, archiveIds: null};
+const PREF_KEY = 'jarvis.work.preferences.v1';
+const TASK_KEY = 'jarvis.work.task.v1';
+const ROOT = RNFS.DocumentDirectoryPath + '/jarvis-work-state';
+
+class WorkStore {
+  preferences: Record<string, Preferences> = {};
+  task: WorkTask | null = null;
+  ready = false;
+  private saving: Promise<void> = Promise.resolve();
+  private loading: Promise<void> | null = null;
+  constructor() { makeAutoObservable(this, {hydrate: false}, {autoBind: true}); }
+  getPreferences(sessionId: string | null | undefined): Preferences { return this.preferences[sessionId ?? 'new'] ?? DEFAULT; }
+  async hydrate(): Promise<void> {
+    if (this.ready) return;
+    if (!this.loading) this.loading = (async () => {
+      const [prefs, task] = await Promise.all([AsyncStorage.getItem(PREF_KEY), AsyncStorage.getItem(TASK_KEY)]);
+      runInAction(() => {
+        try { this.preferences = prefs ? JSON.parse(prefs) : {}; } catch { this.preferences = {}; }
+        try { this.task = task ? JSON.parse(task) : null; } catch { this.task = null; }
+        if (this.task?.status === 'running') this.task.status = 'interrupted';
+        this.ready = true;
+      });
+    })();
+    await this.loading;
+  }
+  async setPreferences(sessionId: string | null | undefined, value: Partial<Preferences>): Promise<void> {
+    await this.hydrate();
+    runInAction(() => { this.preferences[sessionId ?? 'new'] = {...this.getPreferences(sessionId), ...value}; });
+    await AsyncStorage.setItem(PREF_KEY, JSON.stringify(this.preferences));
+  }
+  async adoptSession(sessionId: string): Promise<void> {
+    if (!this.preferences[sessionId] && this.preferences.new) await this.setPreferences(sessionId, this.preferences.new);
+  }
+  async begin(sessionId: string, goal: string, modelId: string): Promise<void> {
+    const task: WorkTask = {id: `${Date.now()}`, sessionId, goal, modelId, status: 'running', phase: 'Планування', updatedAt: Date.now()};
+    runInAction(() => { this.task = task; });
+    await this.persist();
+  }
+  async checkpoint(checkpoint: WorkCheckpoint, phase: string): Promise<void> {
+    if (!this.task) return;
+    await RNFS.mkdir(ROOT);
+    const path = `${ROOT}/${this.task.id}.json`;
+    // Serialize immediately, before the live run mutates its next state.
+    const payload = JSON.stringify(checkpoint);
+    this.saving = this.saving.catch(() => undefined).then(async () => {
+      await RNFS.writeFile(path + '.tmp', payload, 'utf8');
+      await RNFS.moveFile(path + '.tmp', path);
+    });
+    await this.saving;
+    runInAction(() => { if (this.task) { this.task.phase = phase; this.task.updatedAt = Date.now(); } });
+    await this.persist();
+  }
+  async readCheckpoint(): Promise<WorkCheckpoint | null> {
+    await this.hydrate();
+    if (!this.task) return null;
+    const path = `${ROOT}/${this.task.id}.json`;
+    if (!(await RNFS.exists(path))) return null;
+    return JSON.parse(await RNFS.readFile(path, 'utf8'));
+  }
+  async end(done: boolean): Promise<void> {
+    runInAction(() => { if (this.task) { this.task.status = done ? 'done' : 'interrupted'; this.task.phase = done ? 'Завершено' : 'Зупинено — можна продовжити'; } });
+    await this.persist();
+  }
+  async resume(): Promise<void> { runInAction(() => { if (this.task) this.task.status = 'running'; }); await this.persist(); }
+  private async persist(): Promise<void> { await AsyncStorage.setItem(TASK_KEY, JSON.stringify(this.task)); }
+}
+export const workStore = new WorkStore();
