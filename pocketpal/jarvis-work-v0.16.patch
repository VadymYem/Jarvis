+      if (report.passed && NativeModules.WorkPreviewModule) {
+        for (const path of paths.filter((path: string) => /\.html?$/i.test(path)).slice(0, 3)) {
+          try {
+            const preview = await NativeModules.WorkPreviewModule.preview(path);
