diff --git a/src/services/search/providers/deviceWeb.ts b/src/services/search/providers/deviceWeb.ts
new file mode 100644
--- /dev/null
+++ b/src/services/search/providers/deviceWeb.ts
@@ -0,0 +1,86 @@
+import type {SearchProvider, SearchHit, SearchOptions} from '../types';
+import {fetchText} from './http';
+
+const stripMarkup = (value: string): string =>
+  value
+    .replace(/<script[\s\S]*?<\/script>/gi, ' ')
+    .replace(/<style[\s\S]*?<\/style>/gi, ' ')
+    .replace(/<[^>]*>/g, ' ')
+    .replace(/&amp;/g, '&')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;|&apos;/g, "'")
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&#x2F;/gi, '/')
+    .replace(/&#(\d+);/g, (_match, code) =>
+      String.fromCharCode(Number(code)),
+    )
+    .replace(/\s+/g, ' ')
+    .trim();
+
+const normalizeHref = (rawHref: string): string | null => {
+  const href = stripMarkup(rawHref).replace(/&amp;/g, '&');
+  try {
+    const candidate = href.startsWith('//') ? 'https:' + href : href;
+    const url = new URL(candidate);
+    if (
+      url.hostname.endsWith('duckduckgo.com') &&
+      url.pathname.startsWith('/l/')
+    ) {
+      const target = url.searchParams.get('uddg');
+      if (target && /^https?:\/\//i.test(target)) return target;
+    }
+    return /^https?:\/\//i.test(url.toString()) ? url.toString() : null;
+  } catch {
+    return null;
+  }
+};
+
+/**
+ * Keyless general web search.
+ *
+ * Search indexing is still remote: the phone sends an HTTPS query to the
+ * DuckDuckGo HTML endpoint. Jarvis performs HTML parsing, result budgeting,
+ * caching and downstream page reading locally. No API key or proxy is used.
+ */
+export class DeviceWebProvider implements SearchProvider {
+  readonly id = 'device_web';
+
+  async search(query: string, opts: SearchOptions): Promise<SearchHit[]> {
+    const endpoint =
+      'https://html.duckduckgo.com/html/?q=' + encodeURIComponent(query);
+    const html = await fetchText(endpoint, {
+      method: 'GET',
+      headers: {
+        Accept: 'text/html,application/xhtml+xml',
+        'Accept-Language': 'uk,en;q=0.8,de;q=0.6',
+      },
+    });
+
+    const hits: SearchHit[] = [];
+    const anchor =
+      /<a[^>]+class=["'][^"']*result__a[^"']*["'][^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi;
+    let match: RegExpExecArray | null;
+    while ((match = anchor.exec(html)) && hits.length < Math.min(8, Math.max(1, opts.maxResults))) {
+      const url = normalizeHref(match[1]);
+      const title = stripMarkup(match[2]);
+      if (!url || !title) continue;
+      const window = html.slice(anchor.lastIndex, anchor.lastIndex + 2800);
+      const snippetMatch =
+        /class=["'][^"']*result__snippet[^"']*["'][^>]*>([\s\S]*?)<\/(?:a|div)>/i.exec(
+          window,
+        );
+      hits.push({
+        title,
+        url,
+        snippet: snippetMatch ? stripMarkup(snippetMatch[1]).slice(0, 600) : '',
+      });
+    }
+    if (!hits.length) {
+      throw new Error(
+        'Device Web returned no parseable results. The public HTML endpoint may be throttled or changed.',
+      );
+    }
+    return hits;
+  }
+}
