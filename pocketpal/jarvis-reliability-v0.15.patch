diff --git a/src/agent/deviceCommands.ts b/src/agent/deviceCommands.ts
new file mode 100644
index 0000000..747a7a7
--- /dev/null
+++ b/src/agent/deviceCommands.ts
@@ -0,0 +1,49 @@
+export type DeviceCommand = {
+  action: 'flashlight' | 'launch_app' | 'find_phone';
+  enabled?: boolean;
+  app?: string;
+};
+
+/** Only route a complete, unambiguous command; questions remain chat turns. */
+export const parseDeviceCommand = (text: string): DeviceCommand | null => {
+  const value = text
+    .trim()
+    .replace(/^(?:jarvis|джарвіс)[,\s]+/i, '')
+    .replace(/[.!]+$/, '')
+    .trim();
+  const torch =
+    /^(увімкни|включи|вимкни|виключи|turn on|turn off)\s+(?:the\s+)?(?:ліхтарик|ліхтар|flashlight|torch)$/i.exec(
+      value,
+    );
+  if (torch)
+    return {
+      action: 'flashlight',
+      enabled: /^(увімкни|включи|turn on)$/i.test(torch[1]),
+    };
+  if (/^(знайди (?:мій )?телефон|find (?:my )?phone)$/i.test(value))
+    return {action: 'find_phone', enabled: true};
+  if (/^(зупини пошук телефону|stop (?:finding|phone finder))$/i.test(value))
+    return {action: 'find_phone', enabled: false};
+  const app =
+    /^(?:відкрий|запусти|open|launch)\s+(?:застосунок\s+|додаток\s+|app\s+)?([\p{L}\p{N}_. -]{1,160})$/iu.exec(
+      value,
+    );
+  if (
+    app &&
+    !/^(?:файл|статт|документ|file|article|document|сайт|website|налаштування|settings)/i.test(
+      app[1],
+    )
+  ) {
+    const aliases: Record<string, string> = {
+      телеграм: 'Telegram',
+      хром: 'Chrome',
+      ютуб: 'YouTube',
+      termux: 'Termux',
+    };
+    return {
+      action: 'launch_app',
+      app: aliases[app[1].toLocaleLowerCase()] ?? app[1].trim(),
+    };
+  }
+  return null;
+};
