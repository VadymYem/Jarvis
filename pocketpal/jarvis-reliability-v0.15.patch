@@ -0,0 +1,148 @@
+import React from 'react';
+import {
+  Alert,
+  AppState,
+  NativeModules,
+  PermissionsAndroid,
+  ScrollView,
+  View,
+} from 'react-native';
+import {Button, Card, Text, TextInput} from 'react-native-paper';
+import {useFocusEffect} from '@react-navigation/native';
+import {DeviceControlEngine} from '../agent/talents/DeviceControlEngine';
+
+type Status = {
+  microphone: boolean;
+  camera: boolean;
+  accessibility: boolean;
+  finderPlaying: boolean;
+};
+
+export const AgentScreen: React.FC = () => {
+  const [status, setStatus] = React.useState<Status | null>(null);
+  const [app, setApp] = React.useState('Telegram');
+  const [busy, setBusy] = React.useState(false);
+  const [result, setResult] = React.useState('');
+  const refresh = React.useCallback(async () => {
+    try {
+      setStatus((await NativeModules.AndroidControlModule?.status()) ?? null);
+    } catch {
+      setStatus(null);
+    }
+  }, []);
+  useFocusEffect(
+    React.useCallback(() => {
+      refresh();
+    }, [refresh]),
+  );
+  React.useEffect(() => {
+    const subscription = AppState.addEventListener('change', state => {
+      if (state === 'active') refresh();
+    });
+    return () => subscription.remove();
+  }, [refresh]);
+  const run = async (args: Record<string, any>) => {
+    if (busy) return;
+    setBusy(true);
+    try {
+      const outcome = await new DeviceControlEngine().execute(args);
+      setResult(outcome.summary);
+      await refresh();
+    } finally {
+      setBusy(false);
+    }
+  };
+  const permissions = async () => {
+    await PermissionsAndroid.requestMultiple([
+      PermissionsAndroid.PERMISSIONS.RECORD_AUDIO,
+      PermissionsAndroid.PERMISSIONS.CAMERA,
+    ]);
+    await refresh();
+  };
+  const settings = async (accessibility: boolean) => {
+    try {
+      await NativeModules.AndroidControlModule?.openSettings(accessibility);
+    } catch (error) {
+      Alert.alert('Jarvis', String(error));
+    }
+  };
+  return (
+    <ScrollView contentContainerStyle={{padding: 16, gap: 16}}>
+      <Card mode="outlined">
+        <Card.Content style={{gap: 10}}>
+          <Text variant="titleLarge">Агент · дозволи</Text>
+          <Text>
+            Мікрофон: {status?.microphone ? 'дозволено' : 'потрібен дозвіл'}
+          </Text>
+          <Text>
+            Камера / ліхтарик:{' '}
+            {status?.camera ? 'дозволено' : 'потрібен дозвіл'}
+          </Text>
+          <Text>
+            Керування екраном:{' '}
+            {status?.accessibility ? 'увімкнено' : 'увімкніть службу Jarvis'}
+          </Text>
+          <Button mode="contained" onPress={permissions}>
+            Дозволити мікрофон і камеру
+          </Button>
+          <Button onPress={() => settings(true)}>
+            Увімкнути Accessibility
+          </Button>
+          <Button onPress={() => settings(false)}>Дозволи застосунку</Button>
+        </Card.Content>
+      </Card>
+      <Card mode="outlined">
+        <Card.Content style={{gap: 10}}>
+          <Text variant="titleLarge">Перевірка дій</Text>
+          <Text>
+            Прості команди працюють і в чаті: «увімкни ліхтарик», «відкрий
+            Telegram», «знайди мій телефон».
+          </Text>
+          <View style={{flexDirection: 'row', flexWrap: 'wrap'}}>
+            <Button
+              disabled={busy}
+              onPress={() => run({action: 'flashlight', enabled: true})}>
+              Увімкнути ліхтарик
+            </Button>
+            <Button
+              disabled={busy}
+              onPress={() => run({action: 'flashlight', enabled: false})}>
+              Вимкнути ліхтарик
+            </Button>
+          </View>
+          <TextInput
+            label="Назва або пакет застосунку"
+            value={app}
+            onChangeText={setApp}
+            mode="outlined"
+          />
+          <Button
+            disabled={busy || !app.trim()}
+            onPress={() => run({action: 'launch_app', app})}>
+            Відкрити застосунок
+          </Button>
+          <Text>
+            Пошук телефону відтворює was-wollen-wir-trinken.mp3 із пам’яті
+            пристрою протягом хвилини. Покладіть файл у Download.
+          </Text>
+          <View style={{flexDirection: 'row', flexWrap: 'wrap'}}>
+            <Button
+              disabled={busy}
+              onPress={() => run({action: 'find_phone', enabled: true})}>
+              Знайти телефон
+            </Button>
+            <Button
+              disabled={busy}
+              onPress={() => run({action: 'find_phone', enabled: false})}>
+              Зупинити звук
+            </Button>
+          </View>
+          <Button disabled={busy} onPress={() => run({action: 'snapshot'})}>
+            Прочитати елементи екрана
+          </Button>
+          {result ? <Text selectable>{result}</Text> : null}
+        </Card.Content>
+      </Card>
+    </ScrollView>
+  );
+};
