new file mode 100644
index 0000000..9d1c38a
--- /dev/null
+++ b/src/voice/__tests__/liveConversation.test.ts
@@ -0,0 +1,42 @@
+import {latestVoiceReply, voiceReplyText} from '../liveConversation';
+
+describe('Live replies', () => {
+  it('selects the newest assistant turn from newest-first messages', () => {
+    const newest = {
+      id: 'new',
+      type: 'assistant_turn',
+      steps: [{content: 'Нова відповідь'}],
+    } as any;
+    const oldest = {
+      id: 'old',
+      type: 'assistant_turn',
+      steps: [{content: 'Стара відповідь'}],
+    } as any;
+    expect(
+      latestVoiceReply([
+        {type: 'text', id: 'user', metadata: {}} as any,
+        newest,
+        oldest,
+      ]),
+    ).toBe(newest);
+    expect(voiceReplyText(newest)).toBe('Нова відповідь');
+  });
+  it('speaks direct command results and errors instead of waiting forever', () => {
+    const status = {
+      type: 'text',
+      id: 'status',
+      text: 'Ліхтарик увімкнено',
+      metadata: {system: true},
+    } as any;
+    expect(latestVoiceReply([status])).toBe(status);
+    expect(voiceReplyText(status)).toBe('Ліхтарик увімкнено');
+  });
+  it('uses the final answer step rather than an earlier tool preamble', () => {
+    expect(
+      voiceReplyText({
+        type: 'assistant_turn',
+        steps: [{content: 'Працюю…'}, {content: 'Готово'}],
+      } as any),
+    ).toBe('Готово');
+  });
+});
diff --git a/src/voice/liveConversation.ts b/src/voice/liveConversation.ts
new file mode 100644
index 0000000..e0b0208
--- /dev/null
+++ b/src/voice/liveConversation.ts
@@ -0,0 +1,23 @@
+import type {MessageType} from '../utils/types';
+
+export type VoiceReply = MessageType.AssistantTurn | MessageType.Text;
+
+/** ChatSessionStore stores messages newest first. */
+export const latestVoiceReply = (
+  messages: MessageType.Any[],
+): VoiceReply | undefined =>
+  messages.find(
+    message =>
+      message.type === 'assistant_turn' ||
+      (message.type === 'text' && message.metadata?.system === true),
+  ) as VoiceReply | undefined;
+
+export const voiceReplyText = (reply: VoiceReply): string => {
+  if (reply.type === 'text') return reply.text.trim();
+  return (
+    [...reply.steps]
+      .reverse()
+      .find(step => step.content?.trim())
+      ?.content?.trim() ?? ''
+  );
+};
