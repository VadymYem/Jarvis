diff --git a/android/app/src/main/java/top/authorche/agent/AndroidControlModule.kt b/android/app/src/main/java/top/authorche/agent/AndroidControlModule.kt
new file mode 100644
index 0000000..f2e4a4c
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/AndroidControlModule.kt
@@ -0,0 +1,221 @@
+package top.authorche.agent
+
+import android.Manifest
+import android.accessibilityservice.AccessibilityService
+import android.content.ComponentName
+import android.content.Intent
+import android.content.pm.LauncherApps
+import android.content.pm.PackageManager
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraManager
+import android.media.AudioManager
+import android.media.MediaPlayer
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import android.provider.MediaStore
+import android.provider.Settings
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import top.authorche.agent.accessibility.AgentAccessibilityService
+
+/** Real Android actions. Success comes from the platform, never an LLM claim. */
+class AndroidControlModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private val main = Handler(Looper.getMainLooper())
+  private var player: MediaPlayer? = null
+  private var previousVolume: Int? = null
+  private var torchCallback: CameraManager.TorchCallback? = null
+  private var torchPromise: Promise? = null
+  private var finderPromise: Promise? = null
+  private val audio get() = context.getSystemService(AudioManager::class.java)
+  private val cameras get() = context.getSystemService(CameraManager::class.java)
+  private val stopFinder = Runnable { releasePlayer() }
+
+  override fun getName() = "AndroidControlModule"
+
+  @ReactMethod fun status(promise: Promise) {
+    promise.resolve(Arguments.createMap().apply {
+      putBoolean("microphone", context.checkSelfPermission(Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED)
+      putBoolean("camera", context.checkSelfPermission(Manifest.permission.CAMERA) == PackageManager.PERMISSION_GRANTED)
+      putBoolean("accessibility", AgentAccessibilityService.isConnected())
+      putBoolean("finderPlaying", player?.isPlaying == true)
+      putString("audioPermission", if (Build.VERSION.SDK_INT >= 33) Manifest.permission.READ_MEDIA_AUDIO else Manifest.permission.READ_EXTERNAL_STORAGE)
+    })
+  }
+
+  @ReactMethod fun flashlight(enabled: Boolean, promise: Promise) {
+    main.post {
+      try {
+        check(torchPromise == null) { "Попередня команда ліхтарика ще виконується" }
+        check(context.checkSelfPermission(Manifest.permission.CAMERA) == PackageManager.PERMISSION_GRANTED) { "Надайте доступ до камери для ліхтарика" }
+        val camera = cameras.cameraIdList.firstOrNull {
+          val characteristics = cameras.getCameraCharacteristics(it)
+          characteristics.get(CameraCharacteristics.FLASH_INFO_AVAILABLE) == true &&
+            characteristics.get(CameraCharacteristics.LENS_FACING) == CameraCharacteristics.LENS_FACING_BACK
+        } ?: error("На пристрої немає доступного ліхтарика")
+        val callback = object : CameraManager.TorchCallback() {
+          override fun onTorchModeChanged(cameraId: String, state: Boolean) {
+            if (cameraId != camera || state != enabled || torchPromise !== promise) return
+            torchPromise = null
+            cameras.unregisterTorchCallback(this)
+            torchCallback = null
+            promise.resolve(if (state) "Ліхтарик увімкнено" else "Ліхтарик вимкнено")
+          }
+        }
+        torchPromise = promise
+        torchCallback = callback
+        cameras.registerTorchCallback(callback, main)
+        cameras.setTorchMode(camera, enabled)
+        main.postDelayed({
+          if (torchPromise === promise) {
+            cameras.unregisterTorchCallback(callback)
+            torchPromise = null
+            torchCallback = null
+            promise.reject("TORCH_TIMEOUT", "Android не підтвердив стан ліхтарика")
+          }
+        }, 3000)
+      } catch (error: Exception) {
+        if (torchPromise === promise) {
+          torchCallback?.let { cameras.unregisterTorchCallback(it) }
+          torchCallback = null
+          torchPromise = null
+        }
+        promise.reject("TORCH", error.message, error)
+      }
+    }
+  }
+
+  @ReactMethod fun launchApp(query: String, promise: Promise) {
+    main.post {
+      try {
+        require(query.trim().length in 1..160) { "Вкажіть назву або пакет застосунку" }
+        val launcher = context.getSystemService(LauncherApps::class.java)
+        val apps = launcher.getActivityList(null, Process.myUserHandle())
+        val exact = apps.filter {
+          it.applicationInfo.packageName.equals(query.trim(), true) || it.label.toString().equals(query.trim(), true)
+        }
+        val matches = if (exact.isNotEmpty()) exact else apps.filter { it.label.toString().contains(query.trim(), true) }
+        val packages = matches.map { it.applicationInfo.packageName }.distinct()
+        check(packages.size == 1) {
+          if (packages.isEmpty()) "Застосунок «$query» не знайдено" else "Уточніть застосунок: ${matches.joinToString { it.label.toString() }.take(500)}"
+        }
+        val app = matches.first()
+        launcher.startMainActivity(ComponentName(app.applicationInfo.packageName, app.name), Process.myUserHandle(), null, null)
+        promise.resolve("Відкрито ${app.label} (${app.applicationInfo.packageName})")
+      } catch (error: Exception) { promise.reject("APP_LAUNCH", error.message, error) }
+    }
+  }
+
+  @ReactMethod fun findPhone(start: Boolean, promise: Promise) {
+    main.post {
+      if (!start) {
+        releasePlayer()
+        promise.resolve("Пошук телефону зупинено")
+        return@post
+      }
+      try {
+        releasePlayer()
+        val permission = if (Build.VERSION.SDK_INT >= 33) Manifest.permission.READ_MEDIA_AUDIO else Manifest.permission.READ_EXTERNAL_STORAGE
+        check(context.checkSelfPermission(permission) == PackageManager.PERMISSION_GRANTED) { "Надайте доступ до аудіофайлів" }
+        val collection = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI
+        val uri = context.contentResolver.query(collection, arrayOf(MediaStore.Audio.Media._ID),
+          "${MediaStore.Audio.Media.DISPLAY_NAME} = ?", arrayOf("was-wollen-wir-trinken.mp3"), null)?.use { cursor ->
+          if (cursor.moveToFirst()) android.content.ContentUris.withAppendedId(collection, cursor.getLong(0)) else null
+        } ?: error("У Download не знайдено was-wollen-wir-trinken.mp3. Перевірте назву файла та дозвіл на аудіо")
+        val sound = MediaPlayer()
+        player = sound
+        finderPromise = promise
+        sound.setDataSource(context, uri)
+        sound.isLooping = true
+        sound.setAudioAttributes(android.media.AudioAttributes.Builder()
+          .setUsage(android.media.AudioAttributes.USAGE_MEDIA).setContentType(android.media.AudioAttributes.CONTENT_TYPE_MUSIC).build())
+        sound.setOnPreparedListener {
+          if (player !== it) return@setOnPreparedListener
+          try {
+            previousVolume = audio.getStreamVolume(AudioManager.STREAM_MUSIC)
+            audio.setStreamVolume(AudioManager.STREAM_MUSIC, audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC), 0)
+            it.start()
+            finderPromise = null
+            promise.resolve("Відтворюю was-wollen-wir-trinken.mp3 протягом хвилини")
+            main.postDelayed(stopFinder, 60000)
+          } catch (error: Exception) {
+            finderPromise = null
+            releasePlayer()
+            promise.reject("FINDER_PLAY", error.message, error)
+          }
+        }
+        sound.setOnErrorListener { _, what, extra ->
+          finderPromise?.reject("FINDER_AUDIO", "Не вдалося відтворити аудіо ($what/$extra)")
+          finderPromise = null
+          releasePlayer()
+          true
+        }
+        main.postDelayed({
+          if (finderPromise === promise) {
+            finderPromise = null
+            releasePlayer()
+            promise.reject("FINDER_TIMEOUT", "Підготовка аудіофайла не завершилася")
+          }
+        }, 10000)
+        sound.prepareAsync()
+      } catch (error: Exception) {
+        finderPromise = null
+        releasePlayer()
+        promise.reject("FINDER", error.message, error)
+      }
+    }
+  }
+
+  @ReactMethod fun uiAction(operation: String, text: String, promise: Promise) {
+    main.post {
+      val result = when (operation) {
+        "snapshot" -> AgentAccessibilityService.snapshot()
+        "click_text" -> AgentAccessibilityService.clickText(text)
+        "set_text" -> AgentAccessibilityService.setText(text, null)
+        "scroll_forward" -> AgentAccessibilityService.scrollForward()
+        "scroll_backward" -> AgentAccessibilityService.scrollBackward()
+        "back" -> AgentAccessibilityService.globalAction(AccessibilityService.GLOBAL_ACTION_BACK, "Назад")
+        "home" -> AgentAccessibilityService.globalAction(AccessibilityService.GLOBAL_ACTION_HOME, "Головний екран")
+        else -> Result.failure(IllegalArgumentException("Невідома дія: $operation"))
+      }
+      result.fold({ promise.resolve(it) }, { promise.reject("UI_ACTION", it.message, it) })
+    }
+  }
+
+  @ReactMethod fun openSettings(accessibility: Boolean, promise: Promise) {
+    main.post {
+      try {
+        context.startActivity(Intent(if (accessibility) Settings.ACTION_ACCESSIBILITY_SETTINGS else Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
+          if (!accessibility) data = android.net.Uri.parse("package:${context.packageName}")
+          addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        })
+        promise.resolve(null)
+      } catch (error: Exception) { promise.reject("SETTINGS", error.message, error) }
+    }
+  }
+
+  private fun releasePlayer() {
+    main.removeCallbacks(stopFinder)
+    finderPromise?.resolve("Пошук телефону скасовано")
+    finderPromise = null
+    player?.release()
+    player = null
+    previousVolume?.let { audio.setStreamVolume(AudioManager.STREAM_MUSIC, it, 0) }
+    previousVolume = null
+  }
+
+  override fun invalidate() {
+    main.post {
+      releasePlayer()
+      torchCallback?.let { cameras.unregisterTorchCallback(it) }
+      torchPromise?.reject("CLOSED", "Jarvis закрито")
+      torchCallback = null
+      torchPromise = null
+    }
+    super.invalidate()
+  }
+}
