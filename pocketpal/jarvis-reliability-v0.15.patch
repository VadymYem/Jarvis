@@ -0,0 +1,127 @@
+import {NativeModules, PermissionsAndroid, Platform} from 'react-native';
+import type {
+  TalentEngine,
+  TalentResult,
+  ToolDefinition,
+} from '../../services/talents/types';
+
+export class DeviceControlEngine implements TalentEngine {
+  readonly name = 'device_control';
+  readonly recommendedContextTokens = 1000;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    const native =
+      Platform.OS === 'android'
+        ? NativeModules.AndroidControlModule
+        : undefined;
+    if (!native)
+      return {
+        type: 'error',
+        summary: 'Керування Android недоступне',
+        errorMessage: 'AndroidControlModule unavailable',
+      };
+    try {
+      let summary: string;
+      switch (args.action) {
+        case 'flashlight': {
+          if (typeof args.enabled !== 'boolean')
+            throw new Error('Для ліхтарика потрібен enabled: true/false');
+          const granted = await PermissionsAndroid.request(
+            PermissionsAndroid.PERMISSIONS.CAMERA,
+          );
+          if (granted !== PermissionsAndroid.RESULTS.GRANTED)
+            throw new Error('Доступ до камери не надано');
+          summary = await native.flashlight(args.enabled);
+          break;
+        }
+        case 'launch_app':
+          if (typeof args.app !== 'string' || !args.app.trim())
+            throw new Error('Вкажіть застосунок');
+          summary = await native.launchApp(args.app.trim());
+          break;
+        case 'find_phone': {
+          if (typeof args.enabled !== 'boolean')
+            throw new Error('Для пошуку телефону потрібен enabled: true/false');
+          if (args.enabled) {
+            const status = await native.status();
+            const granted = await PermissionsAndroid.request(
+              status.audioPermission,
+            );
+            if (granted !== PermissionsAndroid.RESULTS.GRANTED)
+              throw new Error('Доступ до аудіофайлів не надано');
+          }
+          summary = await native.findPhone(args.enabled);
+          break;
+        }
+        case 'status':
+          summary = JSON.stringify(await native.status());
+          break;
+        case 'snapshot':
+        case 'click_text':
+        case 'set_text':
+        case 'scroll_forward':
+        case 'scroll_backward':
+        case 'back':
+        case 'home':
+          summary = await native.uiAction(
+            args.action,
+            typeof args.text === 'string' ? args.text : '',
+          );
+          break;
+        default:
+          throw new Error('Невідома Android-дія');
+      }
+      return {type: 'text', summary};
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return {type: 'error', summary: message, errorMessage: message};
+    }
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: this.name,
+        description:
+          'Execute a real Android action requested by the user. Launch an installed app, toggle the flashlight, play the phone finder song, inspect the current screen, click visible text, type or scroll. Screen actions require the Jarvis Accessibility service. Report success only when the tool succeeds; never invent it.',
+        parameters: {
+          type: 'object',
+          properties: {
+            action: {
+              type: 'string',
+              enum: [
+                'status',
+                'flashlight',
+                'launch_app',
+                'find_phone',
+                'snapshot',
+                'click_text',
+                'set_text',
+                'scroll_forward',
+                'scroll_backward',
+                'back',
+                'home',
+              ],
+            },
+            enabled: {
+              type: 'boolean',
+              description: 'Required for flashlight and find_phone',
+            },
+            app: {
+              type: 'string',
+              description: 'Installed app name or package for launch_app',
+            },
+            text: {
+              type: 'string',
+              description:
+                'Visible target for click_text or content for set_text',
+            },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    };
+  }
+}
