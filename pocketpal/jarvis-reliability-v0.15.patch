+import {cleanModelText} from '../cleanModelText';
+
+describe('model transport text', () => {
+  it('removes leaked role markers and repeated partial tokens', () => {
+    expect(
+      cleanModelText(
+        '<|im_start|>assistant\n<think>\n</think>\nГотово<|im_end|><|i_\n<|i_',
+      ),
+    ).toBe('Готово');
+  });
+  it('keeps code and Ukrainian prose intact', () => {
+    const text = 'Створено файл.\n```python\nprint("Привіт")\n```';
+    expect(cleanModelText(text)).toBe(text);
+  });
+});
diff --git a/src/services/agent/cleanModelText.ts b/src/services/agent/cleanModelText.ts
new file mode 100644
index 0000000..4b81f7b
--- /dev/null
+++ b/src/services/agent/cleanModelText.ts
@@ -0,0 +1,19 @@
+/** Remove leaked chat-template delimiters, preserving normal prose and code. */
+export const cleanModelText = (text: string): string =>
+  text
+    .replace(/<\|im_start\|>\s*(?:assistant|user|system|tool)\s*/g, '')
+    .replace(
+      /<\|(?:im_end|endoftext|eot_id|end|start_header_id|end_header_id)\|>/g,
+      '',
+    )
+    .replace(/<\|i_(?:\|>)?/g, '')
+    .replace(/<think>\s*<\/think>/g, '')
+    .replace(
+      /The user explicitly requested an executable artifact, but the previous response did not call a tool\. Call one of the provided tools now and create the real artifact\. Do not answer with prose, placeholders, or simulated files\./g,
+      '',
+    )
+    .replace(
+      /Use one provided tool now\. If a previous tool failed, correct the call and retry\. Do not answer with prose until the required tool succeeds\./g,
+      '',
+    )
+    .trim();
