diff --git a/src/utils/localChatMessages.ts b/src/utils/localChatMessages.ts
new file mode 100644
index 0000000..9f3f92b
--- /dev/null
+++ b/src/utils/localChatMessages.ts
@@ -0,0 +1,58 @@
+import type {ChatMessage} from './types';
+
+/**
+ * Some GGUF templates (notably Gemma-family templates) reject `tool` roles and
+ * consecutive turns with the same role. Keep the OpenAI wire transcript for
+ * remote models, but flatten local tool observations into the next user turn.
+ * This runs at the native completion boundary, including every agent follow-up.
+ */
+export function localChatMessages(messages: ChatMessage[]): ChatMessage[] {
+  const out: ChatMessage[] = [];
+  const text = (content: ChatMessage['content']): string =>
+    typeof content === 'string'
+      ? content
+      : Array.isArray(content)
+        ? content.map(part => part?.type === 'text' ? part.text ?? '' : '[image]').join('\n')
+        : String(content ?? '');
+
+  for (const message of messages) {
+    if (message.role === 'system') {
+      if (out.length === 0) {
+        out.push({role: 'system', content: text(message.content)});
+      } else if (out.length === 1 && out[0].role === 'system') {
+        out[0].content = text(out[0].content) + '\n\n' + text(message.content);
+      }
+      continue;
+    }
+    const role = message.role === 'assistant' ? 'assistant' : 'user';
+    const content = message.role === 'tool'
+      ? `Tool result (${message.tool_call_id ?? 'unknown'}):\n${text(message.content)}`
+      : message.content;
+    const calls = message.tool_calls?.map(call =>
+      `${call.function?.name ?? 'tool'}(${call.function?.arguments ?? '{}'})`).join('\n');
+    const value = calls ? `${text(content)}\nTool calls:\n${calls}`.trim() : content;
+    const previous = out[out.length - 1];
+    if (previous?.role === role) {
+      // Preserve the content of both messages, including a multimodal user
