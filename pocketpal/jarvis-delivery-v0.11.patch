+import {localChatMessages} from '../localChatMessages';
+import type {ChatMessage} from '../types';
+
+const rolesAlternate = (messages: ChatMessage[]) => {
+  const body = messages.filter(message => message.role !== 'system');
+  expect(body[0]?.role).toBe('user');
+  body.forEach((message, index) => {
+    expect(message.role).toBe(index % 2 === 0 ? 'user' : 'assistant');
+  });
+};
+
+describe('local GGUF chat template compatibility', () => {
+  it('keeps the attached file and observations after an agent tool call', () => {
+    const messages: ChatMessage[] = [
+      {role: 'system', content: 'Jarvis'},
+      {role: 'user', content: 'Read attached PDF: invoice total 42'},
+      {role: 'assistant', content: '', tool_calls: [{id: 'call1', type: 'function', function: {name: 'python_exec', arguments: '{"code":"print(42)"}'}}]},
+      {role: 'tool', tool_call_id: 'call1', content: '42'},
+      {role: 'assistant', content: 'The invoice is 42.'},
+      {role: 'user', content: 'And the sum?'},
+    ];
+    const prepared = localChatMessages(messages);
+    rolesAlternate(prepared);
+    expect(JSON.stringify(prepared)).toContain('invoice total 42');
+    expect(JSON.stringify(prepared)).toContain('Tool result (call1)');
+    expect(JSON.stringify(prepared)).toContain('python_exec');
+    expect(prepared.some(message => message.role === 'tool')).toBe(false);
+    expect(messages[3].role).toBe('tool');
+  });
+
+  it('combines adjacent user turns while preserving image content', () => {
+    const prepared = localChatMessages([
+      {role: 'user', content: 'Please inspect'},
+      {role: 'user', content: [{type: 'text', text: 'caption'}, {type: 'image_url', image_url: {url: 'file:///image.png'}}]},
+    ]);
+    rolesAlternate(prepared);
+    expect(JSON.stringify(prepared)).toContain('file:///image.png');
+    expect(JSON.stringify(prepared)).toContain('Please inspect');
+  });
+});
