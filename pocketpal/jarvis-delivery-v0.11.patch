@@ -0,0 +1,101 @@
+package top.authorche.agent
+
+import android.os.Handler
+import android.os.Looper
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import org.json.JSONArray
+import org.json.JSONTokener
+
+/** A private WebView fallback for search pages that reject React Native fetch. */
+class BackgroundWebSearchModule(private val context: ReactApplicationContext) :
+  ReactContextBaseJavaModule(context) {
+  private val main = Handler(Looper.getMainLooper())
+  private var active: WebView? = null
+  private var pending: Promise? = null
+
+  override fun getName() = "BackgroundWebSearchModule"
+
+  @ReactMethod fun search(query: String, promise: Promise) {
+    if (query.isBlank() || query.length > 180) {
+      promise.reject("SEARCH_QUERY", "Search query must contain 1–180 characters")
+      return
+    }
+    main.post {
+      if (active != null) { promise.reject("SEARCH_BUSY", "Search already running"); return@post }
+      pending = promise
+      val view = WebView(context)
+      active = view
+      view.settings.javaScriptEnabled = true
+      view.settings.domStorageEnabled = false
+      view.settings.allowFileAccess = false
+      view.settings.allowContentAccess = false
+      view.settings.setSupportMultipleWindows(false)
+      view.webViewClient = object : WebViewClient() {
+        override fun onPageFinished(webView: WebView, url: String) {
+          if (webView !== active) return
+          val js = """(function(){
+            const links = Array.from(document.querySelectorAll('a'));
+            return JSON.stringify(links.map(a => {
+              const raw = a.href || '';
+              const direct = /[?&]uddg=([^&]+)/.exec(raw);
+              const url = direct ? decodeURIComponent(direct[1]) : raw;
+              const title = (a.innerText || a.textContent || '').trim();
+              const context = (a.closest('article, .result, .b_algo, div.MjjYud') || a.parentElement);
+              const snippet = (context?.innerText || '').trim().slice(0, 500);
+              return {title, url, snippet};
+            }).filter(row => row.title.length > 8
+              && (row.url.startsWith('https://') || row.url.startsWith('http://'))
+              && !['google.', 'bing.', 'duckduckgo.'].some(host =>
+                new URL(row.url).hostname.includes(host)))
+              .slice(0, 8));
+          })()""".trimIndent()
+          webView.evaluateJavascript(js) { response ->
+            if (webView !== active) return@evaluateJavascript
+            try {
+              val decoded = JSONTokener(response).nextValue().toString()
+              val rows = JSONArray(decoded)
+              val result = Arguments.createArray()
+              for (index in 0 until rows.length()) {
+                val hit = rows.getJSONObject(index)
+                result.pushMap(Arguments.createMap().apply {
+                  putString("title", hit.optString("title"))
+                  putString("url", hit.optString("url"))
+                  putString("snippet", hit.optString("snippet"))
+                })
+              }
+              pending?.resolve(result)
+            } catch (error: Exception) {
+              pending?.reject("SEARCH_PARSE", error.message, error)
+            } finally { close() }
+          }
+        }
+      }
+      main.postDelayed({
+        if (view === active) {
+          pending?.reject("SEARCH_TIMEOUT", "Browser search timed out")
+          close()
+        }
+      }, 18000)
+      view.loadUrl("https://www.google.com/search?hl=uk&num=8&q=" +
+        java.net.URLEncoder.encode(query, "UTF-8"))
+    }
+  }
+
+  private fun close() {
+    active?.stopLoading()
+    active?.destroy()
+    active = null
+    pending = null
+  }
+
+  override fun invalidate() {
+    main.post { pending?.reject("SEARCH_CLOSED", "Search closed"); close() }
+    super.invalidate()
+  }
+}
