+++ b/android/app/src/main/java/top/authorche/agent/ArtifactExportModule.kt
@@ -0,0 +1,100 @@
+package top.authorche.agent
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import androidx.core.content.FileProvider
+import com.facebook.react.bridge.BaseActivityEventListener
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import java.io.File
+import java.util.concurrent.Executors
+
+/** Only exports files that the app created inside its private workspace. */
+class ArtifactExportModule(private val context: ReactApplicationContext) :
+  ReactContextBaseJavaModule(context) {
+  private val worker = Executors.newSingleThreadExecutor()
+  private var pendingSave: Pair<File, Promise>? = null
+  private val listener = object : BaseActivityEventListener() {
+    override fun onActivityResult(activity: Activity, requestCode: Int, resultCode: Int, data: Intent?) {
+      if (requestCode != SAVE_REQUEST) return
+      val request = pendingSave ?: return
+      pendingSave = null
+      val target = data?.data
+      if (resultCode != Activity.RESULT_OK || target == null) {
+        request.second.resolve(false)
+        return
+      }
+      worker.execute {
+        try {
+          context.contentResolver.openOutputStream(target, "w")?.use { output ->
+            request.first.inputStream().use { it.copyTo(output, 1024 * 1024) }
+          } ?: error("Unable to open selected destination")
+          request.second.resolve(true)
+        } catch (error: Exception) {
+          request.second.reject("ARTIFACT_SAVE", error.message, error)
+        }
+      }
+    }
+  }
+
+  init { context.addActivityEventListener(listener) }
+  override fun getName() = "ArtifactExportModule"
+
+  private fun checkedFile(uriText: String): File {
+    val uri = Uri.parse(uriText)
+    require(uri.scheme == "file") { "Only local Jarvis artifacts can be exported" }
+    val root = File(context.filesDir, "jarvis-workspace").canonicalFile
+    val file = File(uri.path ?: "").canonicalFile
+    require(file.path.startsWith(root.path + File.separator) && file.isFile) {
+      "Artifact no longer exists in the Jarvis workspace"
+    }
+    return file
+  }
+
+  @ReactMethod fun share(uri: String, mime: String, promise: Promise) {
+    try {
+      val file = checkedFile(uri)
+      val activity = context.currentActivity ?: error("Android activity unavailable")
+      val contentUri = FileProvider.getUriForFile(context, context.packageName + ".artifacts", file)
+      val intent = Intent(Intent.ACTION_SEND).apply {
+        type = mime.ifBlank { "application/octet-stream" }
+        putExtra(Intent.EXTRA_STREAM, contentUri)
+        clipData = android.content.ClipData.newUri(context.contentResolver, file.name, contentUri)
+        addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+      }
+      activity.startActivity(Intent.createChooser(intent, "Поділитися файлом"))
+      promise.resolve(true)
+    } catch (error: Exception) { promise.reject("ARTIFACT_SHARE", error.message, error) }
+  }
+
+  @ReactMethod fun save(uri: String, mime: String, promise: Promise) {
+    if (pendingSave != null) { promise.reject("ARTIFACT_BUSY", "File picker already open"); return }
+    try {
+      val file = checkedFile(uri)
+      val activity = context.currentActivity ?: error("Android activity unavailable")
+      pendingSave = file to promise
+      activity.startActivityForResult(Intent(Intent.ACTION_CREATE_DOCUMENT).apply {
+        addCategory(Intent.CATEGORY_OPENABLE)
+        type = mime.ifBlank { "application/octet-stream" }
+        putExtra(Intent.EXTRA_TITLE, file.name)
+        addFlags(Intent.FLAG_GRANT_WRITE_URI_PERMISSION)
+      }, SAVE_REQUEST)
+    } catch (error: Exception) {
+      pendingSave = null
+      promise.reject("ARTIFACT_SAVE", error.message, error)
+    }
+  }
+
+  override fun invalidate() {
+    context.removeActivityEventListener(listener)
+    pendingSave?.second?.reject("ARTIFACT_CLOSED", "File picker closed")
+    pendingSave = null
+    worker.shutdown()
+    super.invalidate()
+  }
+
+  companion object { private const val SAVE_REQUEST = 9147 }
+}
