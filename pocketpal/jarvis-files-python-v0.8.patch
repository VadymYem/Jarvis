diff --git a/android/app/src/main/python/jarvis_runner.py b/android/app/src/main/python/jarvis_runner.py
new file mode 100644
index 0000000..3d2f889
--- /dev/null
+++ b/android/app/src/main/python/jarvis_runner.py
@@ -0,0 +1,57 @@
+"""Run a short local script and report newly created workspace files."""
+
+import contextlib
+import io
+import json
+import os
+import sys
+import time
+import traceback
+from pathlib import Path
+
+
+class _LimitedOutput(io.StringIO):
+    def write(self, value):
+        if self.tell() + len(value) > 16000:
+            raise ValueError("Python output exceeded 16,000 characters")
+        return super().write(value)
+
+
+def run(code, workspace):
+    root = Path(workspace).resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    before = {str(p.relative_to(root)) for p in root.rglob("*") if p.is_file()}
+    stdout, stderr = _LimitedOutput(), _LimitedOutput()
+    old_cwd, old_argv, old_trace = os.getcwd(), sys.argv, sys.gettrace()
+    deadline = time.monotonic() + 15
+
+    def trace(frame, event, arg):
+        if time.monotonic() > deadline:
+            raise TimeoutError("Python exceeded 15 seconds")
+        return trace
+
+    error = None
+    try:
+        os.chdir(root)
+        sys.argv = ["jarvis_script.py"]
+        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            sys.settrace(trace)
+            try:
+                exec(compile(code, "<jarvis_script>", "exec"), {"__name__": "__main__"})
+            finally:
+                sys.settrace(old_trace)
+    except BaseException as exc:
+        error = "".join(traceback.format_exception_only(type(exc), exc)).strip()[:1000]
+    finally:
+        sys.settrace(old_trace)
+        sys.argv = old_argv
+        os.chdir(old_cwd)
+
+    created = []
+    for path in root.rglob("*"):
+        if path.is_file() and str(path.relative_to(root)) not in before:
+            created.append(str(path.relative_to(root)))
+            if len(created) >= 40:
+                break
+    return json.dumps({"stdout": stdout.getvalue(), "stderr": stderr.getvalue(),
+                       "error": error, "created": created}, ensure_ascii=False)
