+++ b/src/agent/native/AndroidDocuments.ts
@@ -0,0 +1,22 @@
+import {NativeModules, Platform} from 'react-native';
+
+export type AndroidDocument = {uri: string; name: string; text: string};
+type Module = {
+  openText(): Promise<AndroidDocument | null>;
+  readText(uri: string): Promise<AndroidDocument>;
+  writeText(uri: string, text: string): Promise<string>;
+  listGrants(): Promise<string[]>;
+  revokeGrants(): Promise<string>;
+};
+const module = NativeModules.AndroidDocumentsModule as Module | undefined;
+const requireModule = (): Module => {
+  if (Platform.OS !== 'android' || !module) throw new Error('Android document picker unavailable');
+  return module;
+};
+export const androidDocuments: Module = {
+  openText: () => requireModule().openText(),
+  readText: uri => requireModule().readText(uri),
+  writeText: (uri, text) => requireModule().writeText(uri, text),
+  listGrants: () => requireModule().listGrants(),
+  revokeGrants: () => requireModule().revokeGrants(),
+};
