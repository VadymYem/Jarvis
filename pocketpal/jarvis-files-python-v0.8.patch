diff --git a/android/app/src/main/java/top/authorche/agent/AndroidDocumentsModule.kt b/android/app/src/main/java/top/authorche/agent/AndroidDocumentsModule.kt
new file mode 100644
index 0000000..b130d5a
--- /dev/null
+++ b/android/app/src/main/java/top/authorche/agent/AndroidDocumentsModule.kt
@@ -0,0 +1,125 @@
+package top.authorche.agent
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import android.provider.OpenableColumns
+import com.facebook.react.bridge.ActivityEventListener
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import com.facebook.react.bridge.BaseActivityEventListener
+
+/** Android document picker grants access only to files the user selects. */
+class AndroidDocumentsModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private var pending: Promise? = null
+  private val listener: ActivityEventListener = object : BaseActivityEventListener() {
+    override fun onActivityResult(activity: Activity, requestCode: Int, resultCode: Int, data: Intent?) {
+      if (requestCode != PICK) return
+      val promise = pending ?: return
+      pending = null
+      if (resultCode != Activity.RESULT_OK || data?.data == null) {
+        promise.resolve(null)
+        return
+      }
+      try {
+        val uri = data.data!!
+        val flags = data.flags and (Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION)
+        context.contentResolver.takePersistableUriPermission(uri, flags)
+        promise.resolve(readDocument(uri))
+      } catch (e: Exception) { promise.reject("DOCUMENT_READ_FAILED", e.message, e) }
+    }
+  }
+
+  init { context.addActivityEventListener(listener) }
+  override fun getName() = "AndroidDocumentsModule"
+
+  @ReactMethod fun openText(promise: Promise) {
+    if (pending != null) { promise.reject("PICKER_BUSY", "File picker already open"); return }
+    val activity = context.currentActivity ?: run { promise.reject("NO_ACTIVITY", "Android activity unavailable"); return }
+    pending = promise
+    try {
+      val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+        addCategory(Intent.CATEGORY_OPENABLE)
+        type = "text/*"
+        addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION or Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION)
+      }
+      activity.startActivityForResult(intent, PICK)
+    } catch (e: Exception) { pending = null; promise.reject("PICKER_FAILED", e.message, e) }
+  }
+
+  @ReactMethod fun readText(uriText: String, promise: Promise) {
+    try { promise.resolve(readDocument(authorizedUri(uriText))) }
+    catch (e: Exception) { promise.reject("DOCUMENT_READ_FAILED", e.message, e) }
+  }
+
+  @ReactMethod fun writeText(uriText: String, content: String, promise: Promise) {
+    try {
+      require(content.length <= 2_000_000) { "Text exceeds 2 MB" }
+      val uri = authorizedUri(uriText, write = true)
+      context.contentResolver.openOutputStream(uri, "wt")?.use { it.write(content.toByteArray(Charsets.UTF_8)) }
+        ?: error("Cannot open document for writing")
+      promise.resolve("Saved selected Android document")
+    } catch (e: Exception) { promise.reject("DOCUMENT_WRITE_FAILED", e.message, e) }
+  }
+
+  @ReactMethod fun listGrants(promise: Promise) {
+    val grants = Arguments.createArray()
+    context.contentResolver.persistedUriPermissions.forEach { permission ->
+      grants.pushString(permission.uri.toString())
+    }
+    promise.resolve(grants)
+  }
+
+  @ReactMethod fun revokeGrants(promise: Promise) {
+    try {
+      context.contentResolver.persistedUriPermissions.forEach { permission ->
+        context.contentResolver.releasePersistableUriPermission(
+          permission.uri,
+          (if (permission.isReadPermission) Intent.FLAG_GRANT_READ_URI_PERMISSION else 0) or
+            (if (permission.isWritePermission) Intent.FLAG_GRANT_WRITE_URI_PERMISSION else 0)
+        )
+      }
+      promise.resolve("Доступ до вибраних файлів відкликано")
+    } catch (e: Exception) { promise.reject("DOCUMENT_REVOKE_FAILED", e.message, e) }
+  }
+
+  private fun authorizedUri(uriText: String, write: Boolean = false): Uri {
+    val uri = Uri.parse(uriText)
+    val permission = context.contentResolver.persistedUriPermissions.firstOrNull {
+      it.uri == uri && (if (write) it.isWritePermission else it.isReadPermission)
+    } ?: error("Select this document in Android's file picker first")
+    return permission.uri
+  }
+
+  private fun readDocument(uri: Uri): com.facebook.react.bridge.WritableMap {
+    val name = context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
+      if (it.moveToFirst()) it.getString(0) else "document"
+    } ?: "document"
+    val bytes = context.contentResolver.openInputStream(uri)?.use { stream ->
+      val buffer = ByteArray(2_000_001)
+      var count = 0
+      while (count < buffer.size) {
+        val read = stream.read(buffer, count, buffer.size - count)
+        if (read < 0) break
+        count += read
+      }
+      require(count <= 2_000_000) { "Document exceeds 2 MB" }
+      buffer.copyOf(count)
+    } ?: error("Cannot open document")
+    return Arguments.createMap().apply {
+      putString("uri", uri.toString())
+      putString("name", name)
+      putString("text", bytes.toString(Charsets.UTF_8))
+    }
+  }
+  override fun invalidate() {
+    context.removeActivityEventListener(listener)
+    pending?.reject("DOCUMENT_CLOSED", "Document picker closed")
+    pending = null
+    super.invalidate()
+  }
+  companion object { private const val PICK = 9123 }
+}
diff --git a/android/app/src/main/java/top/authorche/agent/LocalPythonModule.kt b/android/app/src/main/java/top/authorche/agent/LocalPythonModule.kt
