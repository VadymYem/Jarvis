@@ -0,0 +1,44 @@
+package top.authorche.agent
+
+import com.chaquo.python.Python
+import com.chaquo.python.android.AndroidPlatform
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import java.io.File
+import java.util.concurrent.Executors
+
+/** Lazy, serialized Python runtime sharing the app-private Jarvis workspace. */
+class LocalPythonModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private val worker = Executors.newSingleThreadExecutor()
+  override fun getName() = "LocalPythonModule"
+
+  @ReactMethod fun runPython(code: String, promise: Promise) {
+    if (code.isBlank() || code.length > 20_000) {
+      promise.reject("PYTHON_INPUT", "Python code must contain 1–20,000 characters")
+      return
+    }
+    worker.execute {
+      try {
+        if (!Python.isStarted()) Python.start(AndroidPlatform(context))
+        val workspace = File(context.filesDir, "jarvis-workspace")
+        check(workspace.isDirectory || workspace.mkdirs()) { "Cannot create workspace" }
+        val result = Python.getInstance().getModule("jarvis_runner")
+          .callAttr("run", code, workspace.canonicalPath).toString()
+        promise.resolve(Arguments.createMap().apply {
+          putString("result", result)
+          putString("workspace", workspace.absolutePath)
+        })
+      } catch (error: Exception) {
+        promise.reject("PYTHON_RUN", error.message, error)
+      }
+    }
+  }
+
+  override fun invalidate() {
+    worker.shutdown()
+    super.invalidate()
+  }
+}
