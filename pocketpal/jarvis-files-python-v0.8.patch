+++ b/src/agent/talents/AndroidDocumentEngine.ts
@@ -0,0 +1,53 @@
+import {Alert} from 'react-native';
+import type {TalentEngine, TalentResult, ToolDefinition} from '../../services/talents/types';
+import {androidDocuments} from '../native/AndroidDocuments';
+
+const confirm = (title: string, detail: string): Promise<boolean> => new Promise(resolve => {
+  Alert.alert(title, detail, [
+    {text: 'Скасувати', style: 'cancel', onPress: () => resolve(false)},
+    {text: 'Дозволити', onPress: () => resolve(true)},
+  ], {cancelable: false});
+});
+
+export class AndroidDocumentEngine implements TalentEngine {
+  readonly name = 'android_document';
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    try {
+      const operation = String(args.operation ?? '');
+      if (operation === 'pick_read') {
+        const document = await androidDocuments.openText();
+        if (!document) return {type: 'text', summary: 'User cancelled file selection.'};
+        return {type: 'text', summary: `${document.name}\nURI: ${document.uri}\n${document.text.slice(0, 16000)}`};
+      }
+      const uri = String(args.uri ?? '');
+      if (!uri.startsWith('content://')) throw new Error('Select a document first. A content URI is required.');
+      if (operation === 'read') {
+        const document = await androidDocuments.readText(uri);
+        return {type: 'text', summary: `${document.name}\n${document.text.slice(0, 16000)}`};
+      }
+      if (operation === 'write') {
+        const content = String(args.content ?? '');
+        if (content.length > 2000000) throw new Error('Text exceeds 2 MB');
+        if (!(await confirm('Змінити файл Android?', `Jarvis запише ${content.length} символів у вибраний файл. Поточний вміст буде замінено.`))) {
+          return {type: 'text', summary: 'User declined file write.'};
+        }
+        return {type: 'text', summary: await androidDocuments.writeText(uri, content)};
+      }
+      throw new Error('Unsupported document operation');
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return {type: 'error', summary: message, errorMessage: message};
+    }
+  }
+  toToolDefinition(): ToolDefinition {
+    return {type: 'function', function: {
+      name: this.name,
+      description: 'Open Android system file picker and read text files chosen by the user; write only to a previously chosen document after confirmation.',
+      parameters: {type: 'object', additionalProperties: false, required: ['operation'], properties: {
+        operation: {type: 'string', enum: ['pick_read', 'read', 'write']},
+        uri: {type: 'string', description: 'content:// URI from the picker'},
+        content: {type: 'string'},
+      }},
+    }};
+  }
+}
diff --git a/src/agent/talents/PythonExecEngine.ts b/src/agent/talents/PythonExecEngine.ts
new file mode 100644
index 0000000..f302999
--- /dev/null
+++ b/src/agent/talents/PythonExecEngine.ts
@@ -0,0 +1,87 @@
+import {Alert, NativeModules, Platform} from 'react-native';
+import type {
+  TalentEngine,
+  TalentResult,
+  ToolDefinition,
+  SystemPromptContext,
+} from '../../services/talents/types';
+
+type PythonResult = {stdout: string; stderr: string; error: string | null; created: string[]};
+interface LocalPythonNative {
+  runPython(code: string): Promise<{result: string; workspace: string}>;
+}
+
+const native = NativeModules.LocalPythonModule as LocalPythonNative | undefined;
+const confirm = (length: number): Promise<boolean> => new Promise(resolve => {
+  Alert.alert('Запустити Python?', `Jarvis запустить ${length} символів коду у локальному середовищі. Код може змінювати приватні файли додатка.`, [
+    {text: 'Скасувати', style: 'cancel', onPress: () => resolve(false)},
+    {text: 'Запустити', onPress: () => resolve(true)},
+  ], {cancelable: false});
+});
+
+export class PythonExecEngine implements TalentEngine {
+  readonly name = 'python_exec';
+  readonly recommendedContextTokens = 1600;
+
+  async execute(args: Record<string, any>): Promise<TalentResult> {
+    if (Platform.OS !== 'android' || !native) {
+      return {
+        type: 'error',
+        summary: 'python_exec: embedded Python is unavailable.',
+        errorMessage: 'Python execution is available only on Android.',
+      };
+    }
+    const code = typeof args.code === 'string' ? args.code : '';
+    if (!code.trim() || code.length > 20000) {
+      return {
+        type: 'error',
+        summary: 'python_exec: missing code.',
+        errorMessage: 'The code argument must contain 1–20,000 characters.',
+      };
+    }
+    try {
+      if (!(await confirm(code.length))) return {type: 'text', summary: 'User declined Python execution.'};
+      const run = await native.runPython(code);
+      const result = JSON.parse(run.result) as PythonResult;
+      const output = [
+        result.stdout?.trim() ? 'stdout:\n' + result.stdout.trim() : '',
+        result.stderr?.trim() ? 'stderr:\n' + result.stderr.trim() : '',
+        result.error?.trim() ? 'error:\n' + result.error.trim() : '',
+        result.created?.length ? 'Created in workspace:\n' + result.created.map(path => `file://${run.workspace}/${path}`).join('\n') : '',
+      ]
+        .filter(Boolean)
+        .join('\n\n')
+        .slice(0, 64000);
+      if (result.error) {
+        return {type: 'error', summary: output, errorMessage: output};
+      }
+      return {type: 'text', summary: output || 'Python completed without output.'};
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return {type: 'error', summary: 'python_exec: ' + message, errorMessage: message};
+    }
+  }
+
+  systemPromptFragment(_ctx: SystemPromptContext): string {
+    return 'python_exec runs Python 3.12 locally after user approval. Current directory is the private Jarvis workspace; save reports or images there using pathlib or Pillow, and print a short result. Keep scripts bounded.';
+  }
+
+  toToolDefinition(): ToolDefinition {
+    return {
+      type: 'function',
+      function: {
+        name: this.name,
+        description:
+          'Run Python 3.12 locally with user approval. Supports standard library and Pillow for files, documents, data and drawn images in the private workspace.',
+        parameters: {
+          type: 'object',
+          properties: {
+            code: {type: 'string', description: 'Python 3 source code to execute.'},
+          },
+          required: ['code'],
+          additionalProperties: false,
+        },
+      },
+    };
+  }
+}
